{{#if thread}}
  {{> "modules/cyberpunk-red-agent-os-modified/templates/chat-thread.hbs"}}
{{else}}

<div class="agentos-chat-list">
  <div class="agentos-toolbar">
    {{#if canCreate}}
    <button type="button" class="agentos-btn primary" data-action="chat-new">
      <i class="fas fa-plus"></i> {{localize "AGENTOS.Chat.NewChat"}}
    </button>
    <button type="button" class="agentos-icon-btn" data-action="chat-folder-new" title="{{localize "AGENTOS.Chat.NewFolder"}}"><i class="fas fa-folder-plus"></i></button>
    {{/if}}
  </div>

  {{#if noActor}}
  <p class="agentos-hint">{{localize "AGENTOS.Chat.NoActorHint"}}</p>
  {{/if}}

  {{#if hasChats}}
  {{!-- Root drop zone: dropping a chat here un-files it. --}}
  <div class="agentos-chat-root" data-chat-drop="">

    {{!-- Folders: header carries the folder's total unread badge. --}}
    {{#each folders}}
    <div class="agentos-folder" data-chat-drop="{{this.id}}">
      <div class="agentos-folder-header" data-action="chat-folder-toggle" data-folder-id="{{this.id}}">
        <i class="fas {{#if this.collapsed}}fa-folder{{else}}fa-folder-open{{/if}}"></i>
        <span class="agentos-folder-name">{{this.name}}</span>
        {{#if this.unread}}<span class="agentos-badge">{{this.unread}}</span>{{/if}}
        <span class="agentos-folder-count">{{this.count}}</span>
        <span class="agentos-folder-tools">
          <button type="button" class="agentos-icon-btn" data-action="chat-folder-rename" data-folder-id="{{this.id}}" title="{{localize "AGENTOS.Chat.RenameFolder"}}"><i class="fas fa-pen"></i></button>
          <button type="button" class="agentos-icon-btn danger" data-action="chat-folder-delete" data-folder-id="{{this.id}}" title="{{localize "AGENTOS.Chat.DeleteFolder"}}"><i class="fas fa-trash"></i></button>
        </span>
        <i class="fas {{#if this.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} agentos-folder-chevron"></i>
      </div>
      {{#unless this.collapsed}}
      <ul class="agentos-list">
        {{#each this.chats}}
        {{> "modules/cyberpunk-red-agent-os-modified/templates/chat-row.hbs" this}}
        {{/each}}
      </ul>
      {{/unless}}
    </div>
    {{/each}}

    {{!-- Ungrouped chats at the root. --}}
    {{#if rootChats.length}}
    <ul class="agentos-list">
      {{#each rootChats}}
      {{> "modules/cyberpunk-red-agent-os-modified/templates/chat-row.hbs" this}}
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{else}}
  <p class="agentos-empty">{{localize "AGENTOS.Chat.Empty"}}</p>
  {{/if}}
</div>

{{#if creating}}
<div class="agentos-modal">
  <div class="agentos-modal-card">
    <h3>{{localize "AGENTOS.Chat.NewChat"}}</h3>
    <input type="text" name="new-chat-name" value="{{newChatName}}" placeholder="{{localize "AGENTOS.Chat.NamePlaceholder"}}">
    <div class="agentos-candidates">
      {{#each candidateGroups}}
      <div class="agentos-cand-folder" data-action="chat-cand-folder" data-folder-id="{{this.id}}">
        <i class="fas {{#if this.collapsed}}fa-folder{{else}}fa-folder-open{{/if}}"></i>
        <span>{{this.name}}</span>
        <span class="agentos-folder-count">{{this.count}}</span>
        <i class="fas {{#if this.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} agentos-folder-chevron"></i>
      </div>
      {{#unless this.collapsed}}
      {{#each this.items}}
      <div class="agentos-candidate {{#if this.selected}}selected{{/if}}" data-action="chat-toggle-candidate" data-key="{{this.key}}">
        <img class="agentos-avatar sm" src="{{this.img}}" alt="">
        <div class="agentos-list-main">
          <div class="agentos-list-title">{{this.name}}</div>
          <div class="agentos-list-sub">{{this.sub}}</div>
        </div>
        <i class="fas {{#if this.selected}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
      </div>
      {{/each}}
      {{/unless}}
      {{/each}}
    </div>
    <div class="agentos-modal-actions">
      <button type="button" class="agentos-btn" data-action="chat-new-cancel">{{localize "AGENTOS.Common.Cancel"}}</button>
      <button type="button" class="agentos-btn primary" data-action="chat-create">{{localize "AGENTOS.Common.Create"}}</button>
    </div>
  </div>
</div>
{{/if}}

{{/if}}
