<div class="agentos-toolbar"><button type="button" class="agentos-btn" data-action="notification-read">{{localize "AGENTOS.Notifications.ReadAll"}}</button><button type="button" class="agentos-btn" data-action="notification-clear">{{localize "AGENTOS.Notifications.Clear"}}</button></div>
<details><summary>{{localize "AGENTOS.Notifications.Mute"}}</summary><div class="agentos-check-grid">{{#each categories}}<label><input type="checkbox" data-action="notification-mute" data-category="{{id}}" {{#if muted}}checked{{/if}}> {{label}}</label>{{/each}}</div></details>
<ul class="agentos-list">{{#each notifications}}<li class="agentos-list-row {{#unless read}}unread{{/unless}}" data-action="notification-open" data-id="{{id}}"><div class="agentos-list-main"><strong>{{label}}{{#if title}} · {{title}}{{/if}}</strong><div class="agentos-list-sub">{{body}}</div><small>{{agDate ts}} {{agTime ts}}</small></div></li>{{/each}}</ul>
