<nav class="agentos-net-tabs">
  <button type="button" class="agentos-cat {{#unless network}}active{{/unless}}" data-action="arcade-tab" data-tab="solo">{{localize "AGENTOS.Multiplayer.Solo"}}</button>
  <button type="button" class="agentos-cat {{#if network}}active{{/if}}" data-action="arcade-tab" data-tab="network"><i class="fas fa-users"></i> {{localize "AGENTOS.Multiplayer.Network"}}</button>
</nav>
{{#if network}}
  {{> "modules/cyberpunk-red-agent-os-modified/templates/arcade-network.hbs" networkData}}
{{else}}
{{#if leaderboard}}
<div class="agentos-arcade-leaderboard">
  <div class="agentos-toolbar">
    <button type="button" class="agentos-icon-btn" data-action="arcade-leaderboard-back" title="{{localize "AGENTOS.Common.Home"}}"><i class="fas fa-arrow-left"></i></button>
    <span class="agentos-arcade-title">{{localize "AGENTOS.Arcade.Leaderboard"}}</span>
  </div>
  <select name="arcade-board-game" class="agentos-select">
    {{#each boardGames}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.title}}</option>{{/each}}
  </select>
  {{#if leaders.length}}
  <ol class="agentos-arcade-scores">
    {{#each leaders}}
    <li class="{{#if this.mine}}mine{{/if}}">
      <span class="agentos-score-rank">{{this.rank}}</span>
      <span class="agentos-score-name">{{this.name}}{{#if this.gm}} <small>GM</small>{{/if}}</span>
      <strong>{{this.score}}</strong>
    </li>
    {{/each}}
  </ol>
  {{else}}<p class="agentos-empty">{{localize "AGENTOS.Arcade.NoScores"}}</p>{{/if}}
</div>
{{else}}
{{#if game}}

<div class="agentos-arcade-game">
  <div class="agentos-toolbar">
    <button type="button" class="agentos-icon-btn" data-action="arcade-exit"><i class="fas fa-arrow-left"></i></button>
    <span class="agentos-arcade-title">{{gameTitle}}</span>
    <span class="agentos-arcade-rec">REC {{record}}</span>
    <span class="agentos-spacer"></span>
    <button type="button" class="agentos-btn" data-action="game-reset"><i class="fas fa-rotate-right"></i></button>
  </div>
  <div class="agentos-game-status">0</div>

  {{#if (agEq game "mine")}}
  <button type="button" class="agentos-cat {{#if mineFlagMode}}active{{/if}}" data-action="mine-flag-mode" aria-pressed="{{mineFlagMode}}"><i class="fas fa-flag"></i> {{localize "AGENTOS.Arcade.FlagMode"}}</button>
  <div class="agentos-mine-board"></div>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.MineHint"}}</p>
  {{/if}}

  {{#if (agEq game "snake")}}
  <canvas class="agentos-game-canvas" width="320" height="320"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.SnakeHint"}}</p>
  {{/if}}

  {{#if (agEq game "runner")}}
  <canvas class="agentos-game-canvas" width="340" height="200"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.RunnerHint"}}</p>
  {{/if}}

  {{#if (agEq game "netduel")}}
  <canvas class="agentos-game-canvas" width="340" height="200"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.DuelHint"}}</p>
  {{/if}}

  {{#if (agEq game "quickhack")}}
  <canvas class="agentos-game-canvas" width="330" height="110"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.QhHint"}}</p>
  {{/if}}

  {{#if (agEq game "simon")}}
  <div class="agentos-simon-board">
    <button type="button" class="agentos-simon-pad p0" data-pad="0"></button>
    <button type="button" class="agentos-simon-pad p1" data-pad="1"></button>
    <button type="button" class="agentos-simon-pad p2" data-pad="2"></button>
    <button type="button" class="agentos-simon-pad p3" data-pad="3"></button>
  </div>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.SimonHint"}}</p>
  {{/if}}

  {{#if (agEq game "g2077")}}
  <div class="agentos-2077-board"></div>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.G2077Hint"}}</p>
  {{/if}}

  {{#if (agEq game "breach")}}
  <div class="agentos-breach">
    <div class="agentos-breach-top">
      <span class="agentos-breach-timer">45s</span>
      <div class="agentos-breach-target"></div>
    </div>
    <div class="agentos-breach-buffer"></div>
    <div class="agentos-breach-grid"></div>
  </div>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.BreachHint"}}</p>
  {{/if}}

  {{#if (agEq game "dodge")}}
  <canvas class="agentos-game-canvas" width="330" height="240"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.DodgeHint"}}</p>
  {{/if}}

  {{#if (agEq game "decrypt")}}
  <div class="agentos-decrypt">
    <div class="agentos-decrypt-board"></div>
    <div class="agentos-decrypt-input"></div>
  </div>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.DecryptHint"}}</p>
  {{/if}}

  {{#if (agEq game "firewall")}}
  <canvas class="agentos-game-canvas" width="330" height="220"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.FirewallHint"}}</p>
  {{/if}}

  {{#if (agEq game "heist")}}
  <canvas class="agentos-game-canvas" width="330" height="242"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.HeistHint"}}</p>
  {{/if}}

  {{#if (agEq game "sprawl")}}
  <canvas class="agentos-game-canvas" width="300" height="300"></canvas>
  <p class="agentos-hint">{{localize "AGENTOS.Arcade.SprawlHint"}}</p>
  {{/if}}
  {{#if touchDirections}}
  <div class="agentos-arcade-controls {{#unless touchVertical}}horizontal-only{{/unless}}" aria-label="{{localize "AGENTOS.Arcade.Controls"}}">
    {{#if touchVertical}}
    <button type="button" data-arcade-key="ArrowUp" aria-label="{{localize "AGENTOS.Arcade.Up"}}"><i class="fas fa-chevron-up"></i></button>
    <button type="button" data-arcade-key="ArrowDown" aria-label="{{localize "AGENTOS.Arcade.Down"}}"><i class="fas fa-chevron-down"></i></button>
    {{/if}}
    {{#if touchHorizontal}}
    <button type="button" data-arcade-key="ArrowLeft" aria-label="{{localize "AGENTOS.Arcade.Left"}}"><i class="fas fa-chevron-left"></i></button>
    <button type="button" data-arcade-key="ArrowRight" aria-label="{{localize "AGENTOS.Arcade.Right"}}"><i class="fas fa-chevron-right"></i></button>
    {{/if}}
  </div>
  {{/if}}
</div>

{{else}}

<div class="agentos-toolbar">
  <button type="button" class="agentos-btn" data-action="arcade-leaderboard"><i class="fas fa-ranking-star"></i> {{localize "AGENTOS.Arcade.Leaderboard"}}</button>
</div>
<div class="agentos-arcade-menu">
  {{#each games}}
  <button type="button" class="agentos-arcade-card" data-action="arcade-pick" data-game="{{this.id}}">
    <i class="fas {{this.icon}}"></i>
    <span>{{this.title}}</span>
    <small class="agentos-arcade-card-rec">REC {{this.rec}}</small>
  </button>
  {{/each}}
</div>

{{/if}}
{{/if}}
{{/if}}
