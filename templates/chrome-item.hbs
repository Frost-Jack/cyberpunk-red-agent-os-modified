{{!-- One implant row. Recurses into installed option-slot children.
      Core containers are non-interactive (opening their sheet breaks display). --}}
<div class="agentos-chrome-item depth-{{this.depth}} {{#if this.isUpgrade}}is-upgrade{{/if}} {{#if this.isFoundational}}foundational{{/if}} {{#if this.isCore}}is-core{{/if}}"
     {{#unless this.isCore}}data-action="chrome-item" data-item-id="{{this.id}}"{{/unless}} title="{{this.name}}">
  {{#if this.hasColor}}<span class="agentos-chrome-item-tag c{{this.colorIdx}}"></span>{{/if}}
  {{#if this.useIcon}}
  <span class="agentos-chrome-item-glyph"><i class="fas {{this.iconClass}}"></i></span>
  {{else}}
  <img class="agentos-chrome-item-img" src="{{this.img}}" alt="">
  {{/if}}
  <span class="agentos-chrome-item-name">{{this.name}}</span>
  {{#if this.sizeDots.length}}
  <span class="agentos-chrome-dots size" title="×{{this.size}}">
    {{#each this.sizeDots}}<i class="dot {{#if this.free}}k-free{{else}}c{{this.colorIdx}}{{/if}}"></i>{{/each}}
  </span>
  {{/if}}
  {{#if this.hasSlots}}
  <span class="agentos-chrome-dots slots" title="{{this.used}}/{{this.slots}}">
    {{#each this.slotDots}}<i class="dot {{#if this.free}}k-free{{else}}c{{this.colorIdx}}{{/if}}"></i>{{/each}}
  </span>
  {{/if}}
</div>
{{#if this.children.length}}
<div class="agentos-chrome-children">
  {{#each this.children}}
  {{> "modules/cyberpunk-red-agent-os-modified/templates/chrome-item.hbs" this}}
  {{/each}}
</div>
{{/if}}
