<form class="AgentDevice-form flexcol" autocomplete="off" style="height: 100%;">
    {{!-- Modified build: the per-user `theme-*` class now owns all phone colours
          (П10). The GM world skin (`uiSkin`) still drives the SAT map art and
          2077 icon sprites in JS, but its CSS colour skin is no longer applied
          here so each player's chosen theme wins. `data-skin` kept for reference. --}}
    <div class="agent-chassis theme-{{agentTheme}} mode-{{agentMode}}" data-actor-id="{{actorId}}" data-actor-uuid="{{actorUuid}}" data-skin="{{uiSkin}}" data-theme="{{agentTheme}}" data-mode="{{agentMode}}">
        <div class="agent-speaker"></div>
        
        <div class="agent-screen">
            <div class="agent-top-bar drag-handle">
                <span><i class="fas fa-signal"></i> 5G-NET</span>
                <span class="agent-clock">{{time}}</span>
                <span style="display: flex; align-items: center; gap: 10px;">
                    <span><i class="fas fa-battery-full"></i> 98%</span>
                    <i class="fas fa-cog agent-settings-btn" data-action="open-agent-settings" title="{{localize 'AGENTOS.Settings.Open'}}"></i>
                    <i class="fas fa-times agent-close-btn" title="Power off / Close Agent"></i>
                </span>
            </div>

            <div class="agent-content">
                <!-- BOOT SEQUENCE VIEW -->
                <div id="agent-view-boot" class="agent-view" style="display: {{#if (eq currentView 'boot')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="agent-boot">
                        <div class="agent-boot-logo">AGENT<br>OS</div>
                        <p class="agent-boot-init">INITIALIZING NEURAL LINK...</p>
                        <p class="agent-boot-ver">ZIGGURAT BIOS v4.0.1 — OK</p>
                    </div>
                </div>

                <!-- HOME SCREEN VIEW -->
                <div id="agent-view-home" class="agent-view" style="display: {{#if (eq currentView 'home')}}grid{{else}}none{{/if}}; height: 100%;">
                    <div class="agent-home">
                        {{#each allApps}}
                            {{#if (contains ../unlockedApps this.id)}}
                                <div class="app-icon" data-app="{{this.id}}" data-action="app-icon">
                                    {{#if this.iconImg}}
                                        <span class="app-icon-img-wrap">
                                            <img src="{{this.iconImg}}" class="app-icon-img" alt="{{this.label}}">
                                            {{#if (eq this.id 'chat')}}
                                                {{#if ../totalUnreads}}
                                                    <span class="unread-badge">{{../totalUnreads}}</span>
                                                {{/if}}
                                            {{/if}}
                                        </span>
                                    {{else}}
                                        <i class="{{this.icon}}" style="color: {{this.color}};">
                                            {{#if (eq this.id 'chat')}}
                                                {{#if ../totalUnreads}}
                                                    <span class="unread-badge">{{../totalUnreads}}</span>
                                                {{/if}}
                                            {{/if}}
                                        </i>
                                    {{/if}}
                                    <span class="app-label">{{this.label}}</span>
                                </div>
                            {{/if}}
                        {{/each}}

                        {{#if isGM}}
                        <div class="app-icon" data-app="admin" data-action="app-icon">
                            {{#if adminIconImg}}
                                <span class="app-icon-img-wrap">
                                    <img src="{{adminIconImg}}" class="app-icon-img" alt="SYS ADMIN">
                                </span>
                            {{else}}
                                <i class="fas fa-user-shield" style="color: #ff00ff;"></i>
                            {{/if}}
                            <span class="app-label">SYS ADMIN</span>
                        </div>
                        {{/if}}
                    </div>
                </div>

                <!-- AGENT SETTINGS VIEW (Modified build: per-user theme + device mode) -->
                <div id="agent-view-agentsettings" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'agentsettings')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" style="justify-content: space-between;">
                        <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" data-action="back-to-home">
                            <i class="fas fa-chevron-left" style="color: var(--neon-cyan);"></i>
                            <h3>{{localize 'AGENTOS.Settings.Title'}}</h3>
                        </span>
                        <i class="fas fa-cog" style="color: var(--neon-cyan);"></i>
                    </div>
                    <div class="agent-settings-body" data-preserve-scroll-container="agentsettings">
                        <div class="agent-settings-section">
                            <div class="agent-settings-label">{{localize 'AGENTOS.Settings.Theme'}}</div>
                            <div class="agent-theme-grid">
                                <div class="agent-theme-swatch theme-swatch-red {{#if (eq agentTheme 'red')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="red" title="{{localize 'AGENTOS.Settings.ThemeRed'}}">
                                    <span class="agent-theme-dot" style="background:#ff2b55;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.ThemeRed'}}</span>
                                </div>
                                <div class="agent-theme-swatch theme-swatch-2077 {{#if (eq agentTheme 'cyber2077')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="cyber2077" title="{{localize 'AGENTOS.Settings.Theme2077'}}">
                                    <span class="agent-theme-dot" style="background:#ffd11a;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.Theme2077'}}</span>
                                </div>
                                <div class="agent-theme-swatch theme-swatch-green {{#if (eq agentTheme 'green')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="green" title="{{localize 'AGENTOS.Settings.ThemeGreen'}}">
                                    <span class="agent-theme-dot" style="background:#3df58a;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.ThemeGreen'}}</span>
                                </div>
                                <div class="agent-theme-swatch theme-swatch-blue {{#if (eq agentTheme 'blue')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="blue" title="{{localize 'AGENTOS.Settings.ThemeBlue'}}">
                                    <span class="agent-theme-dot" style="background:#38b6ff;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.ThemeBlue'}}</span>
                                </div>
                                <div class="agent-theme-swatch theme-swatch-purple {{#if (eq agentTheme 'purple')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="purple" title="{{localize 'AGENTOS.Settings.ThemePurple'}}">
                                    <span class="agent-theme-dot" style="background:#b06bff;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.ThemePurple'}}</span>
                                </div>
                                <div class="agent-theme-swatch theme-swatch-orange {{#if (eq agentTheme 'orange')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="orange" title="{{localize 'AGENTOS.Settings.ThemeOrange'}}">
                                    <span class="agent-theme-dot" style="background:#ff7a2b;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.ThemeOrange'}}</span>
                                </div>
                                <div class="agent-theme-swatch theme-swatch-magenta {{#if (eq agentTheme 'magenta')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="magenta" title="{{localize 'AGENTOS.Settings.ThemeMagenta'}}">
                                    <span class="agent-theme-dot" style="background:#ff2bb0;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.ThemeMagenta'}}</span>
                                </div>
                                <div class="agent-theme-swatch theme-swatch-chrome {{#if (eq agentTheme 'chrome')}}is-active{{/if}}" data-action="agent-set-theme" data-theme="chrome" title="{{localize 'AGENTOS.Settings.ThemeChrome'}}">
                                    <span class="agent-theme-dot" style="background:#c8e0eb;"></span>
                                    <span class="agent-theme-name">{{localize 'AGENTOS.Settings.ThemeChrome'}}</span>
                                </div>
                            </div>
                        </div>

                        <div class="agent-settings-section">
                            <div class="agent-settings-label">{{localize 'AGENTOS.Settings.Mode'}}</div>
                            <div class="agent-mode-toggle">
                                <button type="button" class="agent-mode-btn {{#if (eq agentMode 'phone')}}is-active{{/if}}" data-action="agent-set-mode" data-mode="phone">
                                    <i class="fas fa-mobile-alt"></i> {{localize 'AGENTOS.Settings.ModePhone'}}
                                </button>
                                <button type="button" class="agent-mode-btn {{#if (eq agentMode 'tablet')}}is-active{{/if}}" data-action="agent-set-mode" data-mode="tablet">
                                    <i class="fas fa-tablet-alt"></i> {{localize 'AGENTOS.Settings.ModeTablet'}}
                                </button>
                            </div>
                            <div class="agent-settings-hint">{{localize 'AGENTOS.Settings.ModeHint'}}</div>
                        </div>

                        <div class="agent-settings-section">
                            <div class="agent-settings-label">{{localize 'AGENTOS.Settings.Sound'}}</div>
                            <div class="agent-mode-toggle">
                                <button type="button" class="agent-mode-btn {{#if agentSoundsOn}}is-active{{/if}}" data-action="agent-toggle-sound">
                                    <i class="fas fa-volume-up"></i> {{localize 'AGENTOS.Settings.SoundOn'}}
                                </button>
                                <button type="button" class="agent-mode-btn {{#unless agentSoundsOn}}is-active{{/unless}}" data-action="agent-toggle-sound">
                                    <i class="fas fa-volume-mute"></i> {{localize 'AGENTOS.Settings.SoundOff'}}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CONTACTS LIST VIEW -->
                <div id="agent-view-contacts" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'chat')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" style="justify-content: space-between;">
                        <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" data-action="back-to-home">
                            <i class="fas fa-chevron-left" style="color: var(--neon-cyan);"></i>
                            <h3>{{localize 'AGENTOS.Header.chat'}}</h3>
                        </span>
                        <div style="display: flex; align-items: center; gap: 15px; padding-right: 5px;">
                            <i class="fas fa-eye{{#if hideOnlineStatus}}-slash{{/if}} toggle-online-status" style="color: {{#if hideOnlineStatus}}#888{{else}}#44ff44{{/if}}; font-size: 0.85rem; cursor: pointer;" title="{{#if hideOnlineStatus}}Incognito: Hidden{{else}}Visible: Online{{/if}}"></i>
                            {{!-- Patch4.8: new group thread. Click → modal to pick participants. --}}
                            <i class="fas fa-user-group" data-action="open-new-group" style="color: var(--neon-cyan); cursor: pointer;" title="Start group chat"></i>
                            <i class="fas fa-plus open-add-contact" style="color: var(--neon-cyan); cursor: pointer;"></i>
                        </div>
                    </div>

                    <div class="contact-search-area" style="padding: 10px; background: rgba(0,0,0,0.3); border-bottom: 1px solid #222;">
                        <input type="text" id="contact-search-input" placeholder="Search CitiNet handles..." value="{{searchQuery}}" style="width: 100%;">
                    </div>

                    <div class="contact-list" style="flex: 1; overflow-y: auto; padding: 10px;">
                        {{#each contacts}}
                            <div class="contact-card" data-contact-id="{{this.id}}" style="padding: 12px; margin-bottom: 8px; background: rgba(255, 255, 255, 0.05); border-left: 3px solid {{#if this.isPlayer}}var(--neon-cyan){{else}}var(--neon-red){{/if}}; border-radius: 4px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; position: relative;">
                                {{#if this.unreads}}
                                    <span class="unread-badge" style="top: 0; right: 0;">{{this.unreads}}</span>
                                {{/if}}
                                <div>
                                    <div style="font-weight: bold; color: white;">
                                        <span class="status-dot {{#if this.active}}online{{else}}offline{{/if}}"></span>
                                        {{this.name}}
                                    </div>
                                    <div style="font-size: 0.70rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px;">{{#if this.isPlayer}}Player Link{{else}}Encrypted Endpoint{{/if}}</div>
                                </div>
                                <div style="display: flex; gap: 5px; align-items: center;">
                                    {{#if this.isGhost}}
                                        <i class="fas fa-ghost" style="color: #888; font-size: 0.8rem; padding: 5px;" title="User is hiding online status"></i>
                                    {{/if}}

                                    {{#unless this.isPlayer}}
                                        {{#if ../isGM}}
                                            <i class="fas fa-eye{{#unless this.active}}-slash{{/unless}} toggle-npc-status" data-contact-id="{{this.id}}" style="color: {{#if this.active}}#44ff44{{else}}#888{{/if}}; font-size: 0.8rem; cursor: pointer; padding: 5px;" title="Toggle NPC Network Status"></i>
                                        {{/if}}
                                        <i class="fas fa-pen edit-contact" data-contact-id="{{this.id}}" data-contact-name="{{this.name}}" data-contact-avatar="{{this.avatar}}" style="color: #444; font-size: 0.8rem; cursor: pointer; padding: 5px;"></i>
                                        <i class="fas fa-trash delete-contact" data-contact-id="{{this.id}}" style="color: #444; font-size: 0.8rem; cursor: pointer; padding: 5px;"></i>
                                    {{/unless}}
                                </div>
                            </div>
                        {{else}}
                            <div style="text-align: center; color: #555; font-style: italic; margin-top: 50px;">No contacts found.</div>
                        {{/each}}
                    </div>
                </div>

                <!-- ADD/EDIT CONTACT MODAL -->
                <div id="agent-add-contact-modal" style="display: {{#if showAddContact}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 100; flex-direction: column; justify-content: center; align-items: center; padding: 12px;">
                    <div style="background: #111; border: 1px solid var(--neon-red); border-radius: 8px; padding: 16px; width: 100%; box-shadow: 0 0 15px rgba(255,0,60,0.3); max-height: 90%; overflow-y: auto;">
                        <h4 style="color: var(--neon-red); margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace;">{{#if editContactId}}EDIT{{else}}ADD{{/if}} CONTACT</h4>
                        <input type="text" id="new-contact-name" placeholder="Enter handle or name..." value="{{editContactName}}" style="width: 100%; margin-bottom: 8px;">
                        {{!-- 5.5.24 (CommanderCrunch69 follow-up): avatar row
                              is now visible to PLAYERS too. Browse stays GM-
                              only (FilePicker is gated by Foundry permissions
                              players don't have). IMPORT is the player-facing
                              affordance — pulls the portrait from a world
                              Actor whose name matches the name field above.
                              Works for any actor the player has at least
                              LIMITED permission on. --}}
                        <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 6px; min-width: 0; width: 100%; box-sizing: border-box;">
                            <input type="text" id="new-contact-avatar" class="rep-input" placeholder="Avatar image path (optional)" value="{{editContactAvatar}}" style="flex: 1 1 auto !important; width: auto !important; min-width: 0 !important; box-sizing: border-box;">
                            <button type="button" class="import-contact-avatar" title="Import portrait from a world Actor with the same name" style="background: rgba(255,180,40,0.12); color: #ffb828; border: 1px solid #ffb828; padding: 4px 10px; cursor: pointer; font-family: monospace; font-size: 0.7rem; flex: 0 0 auto !important; width: auto !important; display: inline-flex !important; align-items: center; gap: 4px; white-space: nowrap;">
                                <i class="fas fa-download"></i> IMPORT
                            </button>
                            {{#if canBrowseFiles}}
                            <button type="button" class="pick-contact-avatar" title="Browse for image (Forge-compatible)" style="background: rgba(0,255,204,0.1); color: var(--neon-cyan); border: 1px solid var(--neon-cyan); padding: 4px 10px; cursor: pointer; font-family: monospace; font-size: 0.7rem; flex: 0 0 auto !important; width: auto !important; display: inline-flex !important; align-items: center; gap: 4px; white-space: nowrap;">
                                <i class="fas fa-folder-open"></i> BROWSE
                            </button>
                            {{/if}}
                        </div>
                        <div style="font-size: 0.5rem; color: #666; margin: 0 0 12px 0; font-family: monospace;">IMPORT pulls a portrait from a world Actor whose name matches the handle above (GM-shared actors only — encounter NPCs stay hidden).{{#if canBrowseFiles}} BROWSE opens Foundry's FilePicker.{{else}} (BROWSE is hidden — needs Foundry's FILES_BROWSE permission; GM can grant it in Configure Permissions.){{/if}} Or paste a URL/path directly.</div>

                        {{#if isGM}}
                            {{#unless editContactId}}
                                <label style="font-size: 0.65rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin-bottom: 5px;">TARGET DEVICES (CHOOSE PLAYERS)</label>
                                <div class="player-selection-list" style="max-height: 300px; overflow-y: auto; background: #222; border: 1px solid #444; border-radius: 4px; padding: 8px; margin-bottom: 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px;">
                                    <div style="display: flex; align-items: center; gap: 8px; font-size: 0.75rem; grid-column: span 2; padding-bottom: 4px; border-bottom: 1px solid #333; margin-bottom: 2px;">
                                        <input type="checkbox" id="target-self" checked disabled>
                                        <label for="target-self">Self Only (Always)</label>
                                    </div>
                                    {{#each partyPlayers}}
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.75rem;">
                                            <input type="checkbox" class="new-contact-target-check" value="{{this.id}}" id="target-{{this.id}}">
                                            <label for="target-{{this.id}}" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{this.name}}</label>
                                        </div>
                                    {{/each}}
                                </div>
                            {{/unless}}
                        {{/if}}

                        <div style="display: flex; justify-content: space-between;">
                            <button type="button" class="cancel-add-contact" style="background: transparent; color: #888; border: 1px solid #444;">Cancel</button>
                            <button type="button" class="confirm-add-contact" style="background: rgba(255,0,60,0.2); color: var(--neon-red); border: 1px solid var(--neon-red); text-shadow: 0 0 5px var(--neon-red);">{{#if editContactId}}Update{{else}}Save{{/if}} Entity</button>
                        </div>
                    </div>
                </div>

                {{!-- Patch4.8: NEW GROUP CHAT modal. Players see other PCs
                      + their own NPC contacts. GM sees everyone (PCs + ALL
                      NPCs they've authored). Pick members, give the group a
                      name, hit CREATE — thread shows up in the contacts
                      list as a group and messages route to all members. --}}
                <div id="agent-new-group-modal" style="display: {{#if showNewGroup}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 100; flex-direction: column; justify-content: center; align-items: center; padding: 12px;">
                    <div style="background: #111; border: 1px solid var(--neon-cyan); border-radius: 8px; padding: 16px; width: 100%; box-shadow: 0 0 15px rgba(0,255,204,0.3); max-height: 95%; overflow-y: auto; box-sizing: border-box;">
                        <h4 style="color: var(--neon-cyan); margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace; letter-spacing: 2px;">NEW GROUP THREAD</h4>
                        <label style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin: 4px 0 4px 0;">GROUP NAME</label>
                        <input type="text" id="new-group-name" class="datapool-input" placeholder="e.g. The Crew, Op Nightfall" style="width: 100%; padding: 8px; box-sizing: border-box; height: 34px; background:#222; color:#fff; border:1px solid #444; border-radius:3px; font-family:monospace; font-size:0.8rem; margin-bottom: 10px;" data-preserve-draft>
                        <label style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin: 4px 0 4px 0;">PARTICIPANTS</label>
                        <div class="admin-hint" style="font-size: 0.55rem; color: #666; margin-bottom: 6px;">Pick any combination of player handles and NPC contacts. The thread will whisper everyone you select; GMs always see all group threads regardless.</div>
                        <div class="player-selection-list" style="max-height: 280px; overflow-y: auto; background: #222; border: 1px solid #444; border-radius: 4px; padding: 8px; margin-bottom: 12px;">
                            {{#if groupCandidatePlayers.length}}
                            <div style="font-size: 0.5rem; color: #888; letter-spacing: 1px; margin: 4px 0;">PLAYERS</div>
                            {{#each groupCandidatePlayers}}
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.75rem; padding: 2px 0;">
                                <input type="checkbox" class="new-group-member" value="player:{{this.id}}" id="ng-p-{{this.id}}">
                                <label for="ng-p-{{this.id}}" style="cursor: pointer; color: #fff;">{{this.name}}</label>
                            </div>
                            {{/each}}
                            {{/if}}
                            {{#if groupCandidateNpcs.length}}
                            <div style="font-size: 0.5rem; color: #888; letter-spacing: 1px; margin: 8px 0 4px 0;">NPC CONTACTS</div>
                            {{#each groupCandidateNpcs}}
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.75rem; padding: 2px 0;">
                                <input type="checkbox" class="new-group-member" value="npc:{{this.id}}" id="ng-n-{{this.id}}">
                                <label for="ng-n-{{this.id}}" style="cursor: pointer; color: #fff;">{{this.name}}</label>
                            </div>
                            {{/each}}
                            {{/if}}
                            {{#unless groupCandidatePlayers.length}}{{#unless groupCandidateNpcs.length}}
                            <div style="font-size: 0.7rem; color: #555; text-align: center; padding: 12px;">No contacts available to group with yet.</div>
                            {{/unless}}{{/unless}}
                        </div>
                        <div style="display: flex; justify-content: space-between; gap: 8px;">
                            <button type="button" data-action="cancel-new-group" style="flex:1; background: transparent; color: #888; border: 1px solid #444; padding: 8px; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 3px;">CANCEL</button>
                            <button type="button" data-action="confirm-new-group" style="flex:1; background: rgba(0,255,204,0.15); color: var(--neon-cyan); border: 1px solid var(--neon-cyan); padding: 8px; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 3px; text-shadow: 0 0 4px rgba(0,255,204,0.4);"><i class="fas fa-user-group"></i> CREATE GROUP</button>
                        </div>
                    </div>
                </div>

                {{!-- Patch4.5: in-phone "Edit Agent ID" modal — replaces the
                      immersion-breaking Foundry Dialog popup. Same styling
                      family as the ADD/EDIT CONTACT modal. --}}
                <div id="agent-id-edit-modal" style="display: {{#if showIdEditModal}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 150; flex-direction: column; justify-content: center; align-items: center; padding: 12px;">
                    <div style="background: #111; border: 1px solid var(--neon-cyan); border-radius: 8px; padding: 16px; width: 100%; box-shadow: 0 0 15px rgba(0,255,204,0.3); max-height: 95%; overflow-y: auto;">
                        <h4 style="color: var(--neon-cyan); margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace; letter-spacing: 2px;">EDIT AGENT ID — {{idEdit.targetName}}</h4>

                        <label style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin: 8px 0 2px 0;">DISPLAY NAME</label>
                        <div class="admin-hint" style="font-size:0.55rem; color:#666; margin-bottom: 4px;">Only this player sees it on their own Global Registry.</div>
                        <input type="text" id="id-edit-display-name" class="datapool-input" value="{{idEdit.displayName}}" placeholder="Leave blank to use actor name" style="width: 100%; padding: 8px; box-sizing: border-box; height: 34px; background:#222; color:#fff; border:1px solid #444; border-radius:3px; font-family:monospace; font-size:0.8rem; margin-bottom: 8px;" data-preserve-draft>

                        <label style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin: 4px 0 2px 0;">DISPLAY HANDLE</label>
                        <div class="admin-hint" style="font-size:0.55rem; color:#666; margin-bottom: 4px;">Public — what other players see in contacts &amp; chat.</div>
                        <input type="text" id="id-edit-handle" class="datapool-input" value="{{idEdit.handle}}" placeholder="Leave blank to use actor name" style="width: 100%; padding: 8px; box-sizing: border-box; height: 34px; background:#222; color:#fff; border:1px solid #444; border-radius:3px; font-family:monospace; font-size:0.8rem; margin-bottom: 8px;" data-preserve-draft>

                        <label style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin: 4px 0 2px 0;">SUBTITLE / PRIORITY LEVEL</label>
                        <input type="text" id="id-edit-subtitle" class="datapool-input" value="{{idEdit.subtitle}}" placeholder="Citizen Priority A+" style="width: 100%; padding: 8px; box-sizing: border-box; height: 34px; background:#222; color:#fff; border:1px solid #444; border-radius:3px; font-family:monospace; font-size:0.8rem; margin-bottom: 8px;" data-preserve-draft>

                        <label style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin: 4px 0 2px 0;">SIN STATUS</label>
                        <select id="id-edit-sin" class="datapool-input" style="width: 100%; padding: 8px; box-sizing: border-box; height: 34px; background:#222; color:#fff; border:1px solid #444; border-radius:3px; font-family:monospace; font-size:0.8rem; margin-bottom: 8px;">
                            {{#each idEditSinOptions}}
                            <option value="{{this}}" {{#if (eq this ../idEdit.sinStatus)}}selected{{/if}}>{{this}}</option>
                            {{/each}}
                        </select>

                        <label style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 1px; display: block; margin: 4px 0 2px 0;">CLEARANCE LEVEL</label>
                        <input type="text" id="id-edit-clearance" class="datapool-input" value="{{idEdit.clearance}}" placeholder="Verified" style="width: 100%; padding: 8px; box-sizing: border-box; height: 34px; background:#222; color:#fff; border:1px solid #444; border-radius:3px; font-family:monospace; font-size:0.8rem; margin-bottom: 14px;" data-preserve-draft>

                        <div style="display: flex; justify-content: space-between; gap: 8px;">
                            <button type="button" data-action="cancel-agent-id" style="flex:1; background: transparent; color: #888; border: 1px solid #444; padding: 8px; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 3px;">CANCEL</button>
                            <button type="button" data-action="save-agent-id" style="flex:1; background: rgba(0,255,204,0.15); color: var(--neon-cyan); border: 1px solid var(--neon-cyan); padding: 8px; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 3px; text-shadow: 0 0 4px rgba(0,255,204,0.4);"><i class="fas fa-save"></i> SAVE</button>
                        </div>
                    </div>
                </div>

                <!-- MESSENGER VIEW -->
                <div id="agent-view-chat" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'chat-thread')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-contacts">
                        <i class="fas fa-chevron-left" style="color: var(--neon-cyan);"></i>
                        <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:1px;">
                            <h3 style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin:0;">{{activeContactName}}</h3>
                            {{#if gmSpeakingAs}}
                            <span style="font-size:0.55rem; color:#ff9900; font-family:monospace; letter-spacing:0.5px; text-transform:uppercase; text-shadow:0 0 4px rgba(255,153,0,0.4);"><i class="fas fa-mask" style="margin-right:3px;"></i>SPEAKING AS: {{gmSpeakingAs}}</span>
                            {{/if}}
                            {{!-- Patch4: GM-only "TO:" indicator so the GM can
                                  see at a glance which player(s) the current NPC
                                  thread is targeting. --}}
                            {{#if gmSpeakingTo}}
                            <span style="font-size:0.55rem; color:var(--neon-cyan); font-family:monospace; letter-spacing:0.5px; text-transform:uppercase; text-shadow:0 0 4px rgba(0,255,204,0.35);"><i class="fas fa-arrow-right" style="margin-right:3px;"></i>TO: {{gmSpeakingTo}}</span>
                            {{/if}}
                            {{!-- Patch4 (Ley): privacy indicator so players
                                  can tell at a glance whether their messages
                                  are private or visible to the whole party. --}}
                            {{#if privacyLabel}}
                            <span style="font-size:0.5rem; color:{{#if (eq privacyMode 'group')}}#ffcc00{{else}}#7fffd4{{/if}}; font-family:monospace; letter-spacing:0.5px; text-transform:uppercase; opacity:0.85;"><i class="fas fa-{{#if (eq privacyMode 'group')}}users{{else}}lock{{/if}}" style="margin-right:3px;"></i>{{privacyLabel}}</span>
                            {{/if}}
                            {{!-- Patch4.8.3: GM voice switcher in multi-NPC
                                  group threads. Single-NPC threads keep the
                                  existing implicit behavior (always that NPC).
                                  onclick stopPropagation on the wrapper +
                                  select so opening the dropdown doesn't bubble
                                  up to the parent app-header which has the
                                  `back-to-contacts` action. --}}
                            {{#if gmGroupNpcVoices.length}}
                            <div onclick="event.stopPropagation();" style="display: flex; align-items: center; gap: 4px; margin-top: 2px;">
                                <i class="fas fa-microphone" style="font-size:0.55rem; color:#ff9900;"></i>
                                <span style="font-size:0.5rem; color:#ff9900; font-family:monospace; letter-spacing:0.5px;">VOICE:</span>
                                <select id="gm-group-voice-select" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();" style="flex: 1 1 auto; min-width: 0; background:#111; color:#ff9900; border:1px solid #ff9900; border-radius:3px; padding:1px 4px; font-family:monospace; font-size:0.55rem; height: 20px; max-width: 180px;">
                                    {{#each gmGroupNpcVoices}}
                                    <option value="{{this.id}}" {{#if (eq this.id ../gmCurrentVoice)}}selected{{/if}}>{{this.name}}</option>
                                    {{/each}}
                                </select>
                            </div>
                            {{/if}}
                            {{#if activeParticipants}}
                            <div class="group-participants" title="{{activeParticipantsLabel}}">
                                <div class="group-participant-avatars">
                                    {{#each activeParticipants}}
                                    <img src="{{this.avatar}}" class="group-participant-avatar {{#if this.isGM}}is-gm{{/if}}" title="{{this.name}}{{#if this.isSelf}} (you){{/if}}{{#if this.isGM}} · GM{{/if}}" onerror="this.src='icons/svg/mystery-man.svg'">
                                    {{/each}}
                                </div>
                                <span class="group-participants-label">{{activeParticipantsLabel}}</span>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    
                    <div class="chat-window">
                        {{#each messages}}
                            {{#if this.dayDivider}}
                                <div class="chat-day-divider">{{this.dayDivider}}</div>
                            {{/if}}
                            <div class="chat-row {{#if this.isSelf}}self{{else}}other{{/if}}" style="display: flex; flex-direction: column; width: 100%; min-width: 0;">
                                <div style="display: flex; align-items: flex-end; min-width: 0; {{#if this.isSelf}}justify-content: flex-end{{/if}}">
                                    {{#unless this.isSelf}}
                                        {{#unless this.consecutive}}
                                            <img src="{{this.avatar}}" class="avatar-chat" onerror="this.src='icons/svg/mystery-man.svg'">
                                        {{else}}
                                            <div style="width: 36px;"></div> <!-- Spacer for consecutive -->
                                        {{/unless}}
                                    {{/unless}}

                                    <div class="chat-bubble {{#if this.isSelf}}sent{{else}}received{{/if}} {{#if this.consecutive}}consecutive{{/if}} new-message-anim">
                                        {{!-- Sender label: shown on every non-consecutive received bubble,
                                              AND on the user's own bubbles in a group chat (showSender).
                                              This makes it possible to attribute messages in DA GANG / Party Net. --}}
                                        {{!-- Patch5.0.1: senderColor tints non-self
                                              names based on a stable hash of the
                                              persona so multi-NPC groups read as
                                              visually distinct voices. Self
                                              bubbles keep the existing dark-on-
                                              cyan style for sent-bubble contrast. --}}
                                        {{#if this.showSender}}
                                            {{#if this.isSelf}}
                                                <strong class="chat-sender-name">{{this.sender}} (you)</strong>
                                            {{else}}
                                                <strong class="chat-sender-name" style="color: {{this.senderColor}};">{{this.sender}}</strong>
                                            {{/if}}
                                        {{else}}
                                            {{#unless this.isSelf}}
                                                {{#unless this.consecutive}}
                                                    <strong class="chat-sender-name" style="color: {{this.senderColor}};">{{this.sender}}</strong>
                                                {{/unless}}
                                            {{/unless}}
                                        {{/if}}
                                        {{#if this.attachment}}
                                            {{!-- Modified build (П4): if the attachment carries a real
                                                  file `src`, render the actual media (image/gif or audio).
                                                  Otherwise fall back to the original RP attachment card. --}}
                                            {{#if this.attachment.isImage}}
                                                <div class="chat-attachment chat-attachment-media" style="margin: 4px 0;">
                                                    <img src="{{this.attachment.src}}" class="chat-attachment-img" alt="{{this.attachment.desc}}" data-action="open-attachment" data-src="{{this.attachment.src}}">
                                                    {{#if this.attachment.desc}}<div class="chat-attachment-caption">{{this.attachment.desc}}</div>{{/if}}
                                                </div>
                                            {{else if this.attachment.isAudio}}
                                                <div class="chat-attachment chat-attachment-media" style="margin: 4px 0;">
                                                    <audio src="{{this.attachment.src}}" controls preload="none" class="chat-attachment-audio"></audio>
                                                    {{#if this.attachment.desc}}<div class="chat-attachment-caption">{{this.attachment.desc}}</div>{{/if}}
                                                </div>
                                            {{else}}
                                            <div class="chat-attachment" style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: rgba(5,5,10,0.92); border: 1px solid var(--neon-cyan); border-radius: 8px; margin: 4px 0; box-shadow: inset 0 0 6px rgba(0,0,0,0.6);">
                                                <i class="fas {{this.attachment.icon}}" style="font-size: 1.5rem; color: var(--neon-cyan); flex-shrink: 0; filter: drop-shadow(0 0 4px rgba(0,255,204,0.6));"></i>
                                                <div style="flex: 1; min-width: 0;">
                                                    <div style="font-size: 0.58rem; letter-spacing: 2px; color: #ffcc00; font-weight: bold; text-transform: uppercase; margin-bottom: 2px; text-shadow: 0 0 4px rgba(255,204,0,0.3);">{{this.attachment.kind}} ATTACHMENT</div>
                                                    <div style="font-size: 0.85rem; line-height: 1.3; color: #fff; word-wrap: break-word; font-weight: 500;">{{this.attachment.desc}}</div>
                                                </div>
                                            </div>
                                            {{/if}}
                                        {{else}}
                                            <div class="chat-text">{{{this.content}}}</div>
                                        {{/if}}
                                        {{#if this.showTime}}
                                            <div class="chat-time">{{this.time}}{{#if this.isSelf}} <span class="read-receipts">✓✓</span>{{/if}}</div>
                                        {{/if}}
                                    </div>
                                    {{#if this.canDelete}}
                                    <button type="button" class="delete-chat-msg" data-msg-id="{{this.id}}" title="Delete message" style="opacity:0; background:transparent; border:none; color:#ff3355; cursor:pointer; font-size:0.7rem; padding:2px 4px; margin:0 2px; transition:opacity 0.15s; align-self:center;"><i class="fas fa-trash-alt"></i></button>
                                    {{/if}}
                                </div>
                            </div>
                        {{else}}
                            <div style="text-align: center; color: #555; font-style: italic; margin-top: 50px;">NO_ENCRYPTED_DATA_FOUND</div>
                        {{/each}}
                        {{#if typingPeer}}
                            <div class="chat-row other typing-row" style="display: flex; flex-direction: column; width: 100%;">
                                <div style="display: flex; align-items: flex-end;">
                                    <img src="{{typingPeer.avatar}}" class="avatar-chat" onerror="this.src='icons/svg/mystery-man.svg'">
                                    <div class="chat-bubble received typing-bubble">
                                        {{#if typingPeer.name}}
                                            <strong class="chat-sender-name" style="margin-right:6px;">{{typingPeer.name}}</strong>
                                        {{/if}}
                                        <span class="typing-dot"></span>
                                        <span class="typing-dot"></span>
                                        <span class="typing-dot"></span>
                                    </div>
                                </div>
                            </div>
                        {{/if}}
                        <div style="height: 20px; flex-shrink: 0; width: 100%;"></div>
                    </div>

                    {{#if showEmojiPicker}}
                    <div class="emoji-picker-container">
                        <div class="emoji-picker-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid #333; padding-bottom: 5px;">
                            <span style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 2px; font-weight: bold;">EMOJI_SYNTHESIZER</span>
                            <i class="fas fa-times" data-action="toggle-emoji-picker" style="cursor: pointer; color: #888; font-size: 0.8rem;"></i>
                        </div>
                        {{!-- Patch4.8.2 (UX): tabs are now icon-only, equal-width
                              flex split (1/6 each), no horizontal scroll. Label
                              still surfaces as a hover tooltip. Active tab gets
                              the cyan ring; inactive tabs are dim. --}}
                        <div class="emoji-cat-tabs" style="display: flex; gap: 3px; margin-bottom: 6px; width: 100%;">
                            {{#each emojiCategories}}
                            <button type="button" data-action="emoji-set-category" data-category="{{this.id}}"
                                style="flex: 1 1 0; min-width: 0; cursor: pointer; padding: 4px 0; background: {{#if (eq this.id ../emojiCategory)}}rgba(0,255,204,0.2){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq this.id ../emojiCategory)}}var(--neon-cyan){{else}}#333{{/if}}; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; line-height: 1; height: 28px; box-shadow: {{#if (eq this.id ../emojiCategory)}}inset 0 0 6px rgba(0,255,204,0.3){{else}}none{{/if}};"
                                title="{{this.label}}">{{this.icon}}</button>
                            {{/each}}
                        </div>
                        <div class="emoji-grid">
                            {{#each curatedEmojis}}
                            <div class="emoji-item" data-action="insert-emoji" data-emoji="{{this}}" title="Insert {{this}}">{{this}}</div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                    
                    {{!-- Modified build: staged attachment preview — appears above the
                          composer after a file is dropped / pasted / picked. The user
                          types a caption then hits SEND. --}}
                    {{#if stagedAttachment}}
                    <div class="staged-attachment-chip">
                        {{#if stagedAttachment.isImage}}
                        <img src="{{stagedAttachment.src}}" class="staged-attachment-thumb" alt="{{stagedAttachment.name}}">
                        {{else}}
                        <span class="staged-attachment-icon"><i class="fas fa-{{#if stagedAttachment.isAudio}}music{{else}}paperclip{{/if}}"></i></span>
                        {{/if}}
                        <div class="staged-attachment-info">
                            <div class="staged-attachment-title">{{localize 'AGENTOS.Attach.Ready'}}</div>
                            <div class="staged-attachment-name">{{stagedAttachment.name}}</div>
                        </div>
                        <button type="button" data-action="cancel-staged-attachment" title="{{localize 'AGENTOS.Common.Cancel'}}" class="staged-attachment-cancel"><i class="fas fa-times"></i></button>
                    </div>
                    {{/if}}

                    <div class="chat-input-area" style="position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); width: calc(100% - 24px); height: auto; min-height: 48px; max-height: 144px; background: rgba(10, 10, 15, 0.95); border: 1px solid rgba(0, 255, 204, 0.6); border-radius: 24px; padding: 6px 8px; display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; backdrop-filter: blur(20px); box-sizing: border-box; z-index: 1000; box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);">
                        <button type="button" class="btn-chat-tool" data-action="toggle-emoji-picker" title="Insert Emoji" style="width: 36px; height: 36px; border-radius: 50%; border: none; background: var(--neon-cyan); color: #000; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: all 0.2s; font-size: 1.1rem; flex-shrink: 0; box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);">
                            <i class="fas fa-smile"></i>
                        </button>
                        {{!-- Patch4.8: attachment template button. Opens a small
                              popover with PHOTO / VIDEO / AUDIO buttons. Pick
                              one → prompts for a description → inserts a
                              styled "attachment card" placeholder into the
                              message. Pure RP — no actual file upload, but
                              renders distinctly in the thread. --}}
                        <button type="button" class="btn-chat-tool" data-action="toggle-attach-picker" title="Send Attachment" style="width: 36px; height: 36px; border-radius: 50%; border: none; background: var(--neon-cyan); color: #000; display: flex; justify-content: center; align-items: center; cursor: pointer; font-size: 1.1rem; flex-shrink: 0; box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);">
                            <i class="fas fa-paperclip"></i>
                        </button>
                        {{!-- Modified build (П4): upload a real image/gif/audio file. --}}
                        <button type="button" class="btn-chat-tool" data-action="attach-file-pick" title="{{localize 'AGENTOS.Attach.Upload'}}" style="width: 36px; height: 36px; border-radius: 50%; border: none; background: var(--neon-cyan); color: #000; display: flex; justify-content: center; align-items: center; cursor: pointer; font-size: 1.05rem; flex-shrink: 0; box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);">
                            <i class="fas fa-image"></i>
                        </button>
                        <input type="file" id="agent-attach-file-input" accept="image/*,audio/*,.gif" style="display:none;">
                        <input type="file" id="agent-attach-picker-input" accept="image/*,audio/*,.gif" style="display:none;">
                        <textarea id="agent-chat-input" placeholder="{{#if stagedAttachment}}{{localize 'AGENTOS.Attach.CaptionPh'}}{{else}}Encrypt message...{{/if}}" maxlength="10000" rows="1" autocomplete="off" style="background: transparent !important; border: none !important; color: #fff; font-size: 0.9rem; flex: 1; padding: 8px 10px; margin: 0; outline: none !important; resize: none; line-height: 1.35; font-family: inherit; max-height: 120px; overflow-y: auto; box-shadow: none !important;"></textarea>
                        <button type="button" id="agent-chat-send" style="width: 36px; height: 36px; border-radius: 50%; border: none; background: var(--neon-cyan); color: #000; display: flex; justify-content: center; align-items: center; cursor: pointer; transition: all 0.2s; font-size: 1.1rem; flex-shrink: 0; box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);"><i class="fas fa-paper-plane"></i></button>
                    </div>

                    {{!-- Patch4.8: attachment-template popover. Sits above the
                          chat composer when open. Three RP attachment kinds. --}}
                    {{#if (eq currentView 'chat-thread')}}
                    {{#if showAttachPicker}}
                    <div style="position: absolute; bottom: 70px; left: 12px; right: 12px; background: rgba(0,0,0,0.95); border: 1px solid var(--neon-cyan); border-radius: 8px; padding: 12px; z-index: 999;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 0.6rem; color: var(--neon-cyan); letter-spacing: 2px; font-weight: bold;">SEND ATTACHMENT</span>
                            <i class="fas fa-times" data-action="toggle-attach-picker" style="cursor: pointer; color: #888; font-size: 0.8rem;"></i>
                        </div>
                        <div style="font-size: 0.55rem; color: #888; margin-bottom: 10px;">Pick a type + description for an RP card, or hit <strong>UPLOAD FILE</strong> to send a real image/gif/audio. You can also paste or drag a file onto the phone.</div>
                        <div style="display:flex; justify-content:flex-end; margin-bottom:10px;">
                            <button type="button" data-action="attach-file-pick" style="padding: 6px 12px; background: rgba(0,255,204,0.12); color: var(--neon-cyan); border: 1px solid var(--neon-cyan); font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-upload"></i> {{localize 'AGENTOS.Attach.Upload'}}</button>
                        </div>
                        <div style="display: flex; gap: 6px; margin-bottom: 10px;">
                            <button type="button" data-action="set-attach-kind" data-kind="photo" style="flex: 1; padding: 8px; background: {{#if (eq attachKind 'photo')}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq attachKind 'photo')}}var(--neon-cyan){{else}}#444{{/if}}; color: {{#if (eq attachKind 'photo')}}var(--neon-cyan){{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-camera"></i> PHOTO</button>
                            <button type="button" data-action="set-attach-kind" data-kind="video" style="flex: 1; padding: 8px; background: {{#if (eq attachKind 'video')}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq attachKind 'video')}}var(--neon-cyan){{else}}#444{{/if}}; color: {{#if (eq attachKind 'video')}}var(--neon-cyan){{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-video"></i> VIDEO</button>
                            <button type="button" data-action="set-attach-kind" data-kind="audio" style="flex: 1; padding: 8px; background: {{#if (eq attachKind 'audio')}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq attachKind 'audio')}}var(--neon-cyan){{else}}#444{{/if}}; color: {{#if (eq attachKind 'audio')}}var(--neon-cyan){{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-microphone"></i> AUDIO</button>
                        </div>
                        <input type="text" id="attach-desc" placeholder="Describe what's in the {{attachKind}}..." style="width: 100%; padding: 8px; box-sizing: border-box; background:#111; color:#fff; border:1px solid #444; border-radius:3px; font-family:monospace; font-size:0.75rem; margin-bottom: 8px;" data-preserve-draft>
                        <div style="display: flex; justify-content: flex-end;">
                            <button type="button" data-action="send-attachment" style="padding: 6px 14px; background: rgba(0,255,204,0.15); color: var(--neon-cyan); border: 1px solid var(--neon-cyan); font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-paper-plane"></i> SEND</button>
                        </div>
                    </div>
                    {{/if}}
                    {{/if}}
                </div>

                <!-- DATAPOOL LIST VIEW -->
                <div id="agent-view-datapool" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'data')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" style="justify-content: space-between;">
                        <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" data-action="back-to-home">
                            <i class="fas fa-chevron-left" style="color: var(--neon-cyan);"></i>
                            <h3>{{localize 'AGENTOS.Header.data'}}</h3>
                        </span>
                        {{#if isGM}}
                        <div style="padding-right: 5px;">
                            <i class="fas fa-file-export open-shard-modal" data-action="open-shard-modal" style="color: var(--neon-cyan); cursor: pointer;" title="Inject Scream Sheet / Data Shard"></i>
                        </div>
                        {{/if}}
                    </div>
                    <div class="contact-search-area" style="padding: 10px; background: rgba(0,0,0,0.3); border-bottom: 1px solid #222;">
                        <input type="text" id="shard-search-input" class="datapool-input" placeholder="Search Ziggurat shards..." value="{{shardSearchQuery}}">
                    </div>
                    <div class="datapool-shards">
                        {{#each shards}}
                            <div class="shard-item" data-shard-id="{{this.id}}">
                                <i class="fas fa-file-alt"></i>
                                <div style="display: flex; flex-direction: column; flex: 1;">
                                    <span class="shard-title">{{this.name}}</span>
                                    <span style="font-size: 0.55rem; color: #555;">{{this.date}}{{#if this._ownerName}} — <span style="color: var(--neon-cyan);">{{this._ownerName}}</span>{{/if}}</span>
                                </div>
                                {{#if ../isGM}}
                                <i class="fas fa-trash delete-shard" data-action="delete-shard" data-shard-id="{{this.id}}" data-shard-owner="{{this._ownerId}}" style="color: #444; cursor: pointer; padding: 5px;" title="Purge Record"></i>
                                {{/if}}
                            </div>
                        {{else}}
                            <div style="text-align: center; color: #555; font-style: italic; margin-top: 50px;">No encrypted shards detected in local buffer.</div>
                        {{/each}}
                    </div>
                </div>

                <!-- DATAPOOL READER VIEW -->
                <div id="agent-view-reader" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'reader')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-datapool">
                        <i class="fas fa-chevron-left" style="color: var(--neon-cyan);"></i>
                        <h3 style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{activeShardName}}</h3>
                    </div>
                    <div class="datapool-reader">
                        <div class="reading-pane">
                            {{{activeShardContent}}}
                        </div>
                    </div>
                </div>

                <!-- SHARD INJECTION MODAL (GM) -->
                <div id="agent-shard-modal" style="display: {{#if showShardModal}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 200; flex-direction: column; justify-content: center; align-items: center; padding: 20px;">
                    <div style="background: #050505; border: 1px solid var(--neon-cyan); border-radius: 8px; padding: 20px; width: 100%; box-shadow: 0 0 20px rgba(0,255,204,0.3); max-height: 90%; overflow-y: auto;">
                        <h4 style="color: var(--neon-cyan); margin-top: 0; border-bottom: 1px solid #222; padding-bottom: 10px; font-family: monospace; letter-spacing: 2px;">DATA INJECTION // UPLOAD</h4>

                        {{!-- Patch4.7 (Gotto): explainer for first-time GMs.
                              Datapool injection drops a "shard" into one player's
                              (or everyone's) Agent. Players see it as a new
                              Scream Sheet entry in the Datapool view. Use for
                              handouts, intel drops, mid-session lore. --}}
                        <div style="background: rgba(0,255,204,0.06); border: 1px dashed rgba(0,255,204,0.3); border-radius: 4px; padding: 8px 10px; margin-bottom: 14px; font-size: 0.6rem; line-height: 1.4; color: #aaa;">
                            <strong style="color: var(--neon-cyan);">What this does:</strong> Drops a piece of intel (a "shard") into one player's Datapool — or everyone's at once. Players see it as a new Scream Sheet card in their phone's Datapool view. Useful for handouts, intel drops, mid-session lore, encrypted briefings, fake news, etc. HTML is supported in the body.
                        </div>

                        <label style="font-size: 0.6rem; color: #666; text-transform: uppercase;">Shard Headline</label>
                        <input type="text" id="shard-title-input" class="datapool-input" placeholder="SCREAM_SHEET_01..." style="margin-bottom: 15px;">

                        <label style="font-size: 0.6rem; color: #666; text-transform: uppercase;">Information Stream (HTML Support)</label>
                        <textarea id="shard-content-input" class="datapool-input" placeholder="Data-stream content here..." style="height: 120px; line-height: 1.4 !important; padding: 10px !important; margin-bottom: 15px;"></textarea>

                        <label style="font-size: 0.6rem; color: #666; text-transform: uppercase;">Target Operative</label>
                        <select id="shard-target-selector" style="width: 100%; background: #111; border: 1px solid #333; color: white; padding: 10px; margin-bottom: 20px;">
                            <option value="broadcast">BROADCAST TO GROUP (ALL)</option>
                            {{#each partyPlayers}}
                                <option value="{{this.id}}">{{this.name}}</option>
                            {{/each}}
                        </select>

                        <div style="display: flex; gap: 10px;">
                            <button type="button" data-action="cancel-shard" style="flex: 1; padding: 10px; background: transparent; border: 1px solid #444; color: #888; cursor: pointer;">Abort</button>
                            <button type="button" data-action="confirm-shard" style="flex: 1; padding: 10px; background: rgba(0,255,204,0.1); border: 1px solid var(--neon-cyan); color: var(--neon-cyan); font-weight: bold; cursor: pointer;">Injection</button>
                        </div>
                    </div>
                </div>

                <!-- WALLET VIEW -->
                <div id="agent-view-wallet" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'creds')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-home">
                        <i class="fas fa-chevron-left" style="color: var(--creds-gold);"></i>
                        <h3>{{localize 'AGENTOS.Header.creds'}}</h3>
                    </div>
                    <div class="wallet-view" style="display: flex; flex-direction: column; height: 100%; padding: 0 12px 12px 12px; box-sizing: border-box; overflow: hidden;">
                        <div class="balance-card" style="flex-shrink: 0;">
                            <div class="balance-label">{{#if isVirtualWallet}}System Fund / Virtual Wallet{{else}}Current E-Balance{{/if}}</div>
                            <div class="balance-amount">{{actorCurrency}}<span>eb</span></div>
                        </div>

                        <div style="font-size: 0.6rem; color: #555; text-transform: uppercase; margin-bottom: 10px; border-bottom: 1px solid #222; padding-bottom: 5px; display: flex; justify-content: space-between; flex-shrink: 0;">
                            <span>Recent Transaction History</span>
                            {{#if isGM}}<i class="fas fa-hand-holding-usd open-payout-modal" data-action="open-transfer-modal" style="color: var(--creds-gold); cursor: pointer;" title="Initiate Transfer"></i>{{/if}}
                        </div>
                        <div class="transaction-list" style="flex: 1; overflow-y: auto; margin-bottom: 15px; padding-bottom: 5px;">
                            {{#each transactions}}
                            <div class="transaction-item">
                                <span style="display: flex; flex-direction: column;">
                                    <span class="tx-label">{{this.label}}</span>
                                    <span style="font-size: 0.55rem; color: #444;">{{this.date}}</span>
                                </span>
                                <div class="tx-amount {{#if this.isPositive}}plus{{else}}minus{{/if}}">{{#if this.isPositive}}+{{else}}-{{/if}}{{this.amount}}eb</div>
                            </div>
                            {{else}}
                            <div style="text-align: center; color: #333; font-style: italic; margin-top: 20px; font-size: 0.7rem;">Verified Ledger Empty</div>
                            {{/each}}
                        </div>

                        <div class="action-buttons" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; flex-shrink: 0; padding-top: 10px; border-top: 1px solid #222;">
                            <button type="button" class="btn-creds open-transfer-modal" data-action="open-transfer-modal" data-mode="give"><i class="fas fa-hand-holding-usd"></i> PAY CONTACT</button>
                            {{#if isGM}}
                            <button type="button" class="btn-creds open-transfer-modal" data-action="open-transfer-modal" data-mode="bill"><i class="fas fa-file-invoice-dollar"></i> BILL CONTACT</button>
                            <button type="button" class="btn-creds" data-action="pay-all-players"><i class="fas fa-users"></i> PAY ALL</button>
                            <button type="button" class="btn-creds add-manual-tx" data-action="add-manual-tx"><i class="fas fa-pen-nib"></i> LEDGER</button>
                            {{/if}}
                            <button type="button" class="btn-creds btn-sync-creds" data-action="refresh-creds"><i class="fas fa-sync"></i> REFRESH</button>
                        </div>
                    </div>
                </div>

                <!-- TRANSFER / P2P MODAL -->
                <div id="agent-transfer-modal" style="display: {{#if showPayoutModal}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 110; flex-direction: column; justify-content: center; align-items: center; padding: 20px; overflow-y: auto;">
                    <div style="background: #111; border: 1px solid var(--creds-gold); border-radius: 8px; padding: 20px; width: 100%; box-shadow: 0 0 15px rgba(255,204,0,0.3); max-height: 90%; overflow-y: auto;">
                        <h4 id="transfer-modal-title" style="color: var(--creds-gold); margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace;">SECURE TRANSACTION</h4>
                        
                        <label>Target Account / Player</label>
                        <select id="transfer-target" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 15px;">
                            {{#each partyPlayers}}
                                <option value="{{this.actorUuid}}" data-user-id="{{this.id}}">{{this.name}}</option>
                            {{/each}}
                        </select>

                        <label>EB Amount</label>
                        <input type="number" id="transfer-amount" placeholder="0" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 15px;">

                        <label>Memo / Purpose</label>
                        <input type="text" id="transfer-memo" placeholder="Direct Transfer" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 15px;">

                        <div style="display: flex; justify-content: space-between; gap: 10px; margin-top: 15px;">
                            <button type="button" class="btn-cancel" data-action="cancel-transfer" style="flex: 1; background: #222; color: #888; border: 1px solid #444; cursor: pointer; pointer-events: all; position: relative; z-index: 200;">Cancel</button>
                            <button type="button" class="btn-authorize" data-action="confirm-transfer" style="flex: 1; background: rgba(255,204,0,0.1); color: var(--creds-gold); border: 1px solid var(--creds-gold); font-weight: bold; cursor: pointer; pointer-events: all; position: relative; z-index: 200;">Authorize</button>
                        </div>
                    </div>
                </div>

                {{!-- Patch4.6: in-phone NPC BID NAME prompt — replaces Foundry Dialog. --}}
                <div id="agent-npc-bid-modal" style="display: {{#if showNpcBidModal}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 120; flex-direction: column; justify-content: center; align-items: center; padding: 20px; overflow-y: auto;">
                    <div style="background: #111; border: 1px solid var(--neon-red); border-radius: 8px; padding: 20px; width: 100%; max-height: 90%; overflow-y: auto; box-shadow: 0 0 15px rgba(255,0,60,0.3); box-sizing: border-box;">
                        <h4 style="color: var(--neon-red); margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace; letter-spacing: 2px;">NPC BID</h4>
                        <label style="font-size: 0.65rem; color: var(--neon-red); letter-spacing: 1px; display: block; margin-bottom: 5px;">NPC BIDDER NAME</label>
                        <input type="text" id="npc-bidder-name" placeholder="e.g. Mr. Suzuki, Maelstrom Rep" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 10px; box-sizing: border-box;" data-preserve-draft>
                        <div style="font-size: 0.6rem; color: #888; margin-bottom: 14px;">This bid will be attributed to the NPC, not your GM account.</div>
                        <div style="display: flex; justify-content: space-between; gap: 10px;">
                            <button type="button" data-action="cancel-npc-bid" style="flex: 1 1 auto !important; width: auto !important; display: inline-flex !important; align-items: center; justify-content: center; background: transparent; color: #888; border: 1px solid #444; padding: 8px; font-family: monospace; cursor: pointer;">CANCEL</button>
                            <button type="button" data-action="confirm-npc-bid" style="flex: 1 1 auto !important; width: auto !important; display: inline-flex !important; align-items: center; justify-content: center; background: rgba(255,0,60,0.15); color: var(--neon-red); border: 1px solid var(--neon-red); padding: 8px; font-family: monospace; font-weight: bold; cursor: pointer; text-shadow: 0 0 4px rgba(255,0,60,0.4);">PLACE BID</button>
                        </div>
                    </div>
                </div>

                {{!-- Patch4.6: generic in-phone CONFIRM modal — replaces Dialog.confirm.
                      Dispatch happens in the `confirm-pending` action handler based on
                      `_pendingConfirm.kind`. --}}
                <div id="agent-confirm-modal" style="display: {{#if showConfirmModal}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 130; flex-direction: column; justify-content: center; align-items: center; padding: 20px; overflow-y: auto;">
                    <div style="background: #111; border: 1px solid {{#if (eq confirmModal.accent 'cyan')}}var(--neon-cyan){{else}}{{#if (eq confirmModal.accent 'gold')}}var(--creds-gold){{else}}var(--neon-red){{/if}}{{/if}}; border-radius: 8px; padding: 20px; width: 100%; max-height: 90%; overflow-y: auto; box-shadow: 0 0 15px {{#if (eq confirmModal.accent 'cyan')}}rgba(0,255,204,0.3){{else}}{{#if (eq confirmModal.accent 'gold')}}rgba(255,204,0,0.3){{else}}rgba(255,0,60,0.3){{/if}}{{/if}}; box-sizing: border-box;">
                        <h4 style="color: {{#if (eq confirmModal.accent 'cyan')}}var(--neon-cyan){{else}}{{#if (eq confirmModal.accent 'gold')}}var(--creds-gold){{else}}var(--neon-red){{/if}}{{/if}}; margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace; letter-spacing: 2px;">{{confirmModal.title}}</h4>
                        <p style="color: #ccc; font-family: monospace; font-size: 0.8rem; margin: 12px 0 18px 0; line-height: 1.4;">{{confirmModal.message}}</p>
                        <div style="display: flex; justify-content: space-between; gap: 10px;">
                            <button type="button" data-action="cancel-pending" style="flex: 1 1 auto !important; width: auto !important; display: inline-flex !important; align-items: center; justify-content: center; background: transparent; color: #888; border: 1px solid #444; padding: 8px; font-family: monospace; cursor: pointer;">CANCEL</button>
                            <button type="button" data-action="confirm-pending" style="flex: 1 1 auto !important; width: auto !important; display: inline-flex !important; align-items: center; justify-content: center; background: {{#if (eq confirmModal.accent 'cyan')}}rgba(0,255,204,0.15){{else}}{{#if (eq confirmModal.accent 'gold')}}rgba(255,204,0,0.15){{else}}rgba(255,0,60,0.15){{/if}}{{/if}}; color: {{#if (eq confirmModal.accent 'cyan')}}var(--neon-cyan){{else}}{{#if (eq confirmModal.accent 'gold')}}var(--creds-gold){{else}}var(--neon-red){{/if}}{{/if}}; border: 1px solid {{#if (eq confirmModal.accent 'cyan')}}var(--neon-cyan){{else}}{{#if (eq confirmModal.accent 'gold')}}var(--creds-gold){{else}}var(--neon-red){{/if}}{{/if}}; padding: 8px; font-family: monospace; font-weight: bold; cursor: pointer;">{{confirmModal.confirmLabel}}</button>
                        </div>
                    </div>
                </div>

                {{!-- Patch4.5: in-phone PAY ALL PLAYERS modal — replaces the
                      immersion-breaking Foundry Dialog popup. --}}
                <div id="agent-pay-all-modal" style="display: {{#if showPayAllModal}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 110; flex-direction: column; justify-content: center; align-items: center; padding: 20px; overflow-y: auto;">
                    <div style="background: #111; border: 1px solid var(--creds-gold); border-radius: 8px; padding: 20px; width: 100%; max-height: 90%; overflow-y: auto; box-shadow: 0 0 15px rgba(255,204,0,0.3); box-sizing: border-box;">
                        <h4 style="color: var(--creds-gold); margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace; letter-spacing: 2px;">PAY ALL PLAYERS</h4>

                        <label style="font-size: 0.65rem; color: var(--creds-gold); letter-spacing: 1px; display: block; margin-bottom: 5px;">AMOUNT (eb) PER PLAYER</label>
                        <input type="number" id="pay-all-amount" value="100" min="1" placeholder="100" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 15px; box-sizing: border-box;" data-preserve-draft>

                        <label style="font-size: 0.65rem; color: var(--creds-gold); letter-spacing: 1px; display: block; margin-bottom: 5px;">MEMO</label>
                        <input type="text" id="pay-all-memo" value="Gig Payout" placeholder="Gig Payout" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 15px; box-sizing: border-box;" data-preserve-draft>

                        <div style="display: flex; justify-content: space-between; gap: 10px; margin-top: 10px;">
                            <button type="button" data-action="cancel-pay-all" style="flex: 1 1 auto !important; width: auto !important; display: inline-flex !important; align-items: center; justify-content: center; background: transparent; color: #888; border: 1px solid #444; padding: 8px; font-family: monospace; cursor: pointer;">CANCEL</button>
                            <button type="button" data-action="confirm-pay-all" style="flex: 1 1 auto !important; width: auto !important; display: inline-flex !important; align-items: center; justify-content: center; background: rgba(255,204,0,0.15); color: var(--creds-gold); border: 1px solid var(--creds-gold); padding: 8px; font-family: monospace; font-weight: bold; cursor: pointer; text-shadow: 0 0 4px rgba(255,204,0,0.4);"><i class="fas fa-money-bill-wave" style="margin-right: 4px;"></i> PAY ALL</button>
                        </div>
                    </div>
                </div>

                <!-- MANUAL LEDGER MODAL -->
                <div id="agent-ledger-modal" style="display: {{#if showLedgerModal}}flex{{else}}none{{/if}}; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 110; flex-direction: column; justify-content: center; align-items: center; padding: 20px; overflow-y: auto;">
                    <div style="background: #111; border: 1px solid #eee; border-radius: 8px; padding: 20px; width: 100%; max-height: 90%; overflow-y: auto;">
                        <h4 style="color: white; margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; font-family: monospace;">{{#if isVirtualWallet}}VIRTUAL WALLET{{else}}MANUAL LEDGER{{/if}} ENTRY</h4>
                        
                        <label style="font-size: 0.65rem; color: #888; display: block; margin-bottom: 5px;">MEMO</label>
                        <input type="text" id="ledger-memo" placeholder="Vendor Expense" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 15px;">

                        <label style="font-size: 0.65rem; color: #888; display: block; margin-bottom: 5px;">AMOUNT (use negative for expense)</label>
                        <input type="number" id="ledger-amount" placeholder="0" style="width: 100%; background: #222; border: 1px solid #444; color: white; padding: 10px; border-radius: 4px; font-family: monospace; margin-bottom: 15px;">

                        <div style="display: flex; justify-content: space-between; gap: 10px; margin-top: 10px;">
                            <button type="button" class="btn-cancel" data-action="cancel-ledger" style="flex: 1; background: transparent; color: #888; border: 1px solid #444; cursor: pointer; pointer-events: all; position: relative; z-index: 200;">Cancel</button>
                            <button type="button" class="btn-authorize" data-action="confirm-ledger" style="flex: 1; background: rgba(255,204,0,0.1); color: var(--creds-gold); border: 1px solid var(--creds-gold); font-weight: bold; cursor: pointer; pointer-events: all; position: relative; z-index: 200;">Authorize</button>
                        </div>
                    </div>
                </div>
                <!-- MAP VIEW -->
                <div id="agent-view-map" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'map')}}flex{{else}}none{{/if}}; height: 100%; overflow: hidden; position: relative;">
                    <div class="app-header drag-handle" style="z-index: 10;">
                        <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" data-action="back-to-home">
                            <i class="fas fa-chevron-left" style="color: var(--neon-yellow);"></i>
                            <h3>{{localize 'AGENTOS.Header.map'}}</h3>
                        </span>
                    </div>
                    
                    <div class="map-viewport" style="flex: 1; position: relative; overflow: hidden; background: #000; cursor: crosshair;">
                        <div class="map-container" style="position: absolute; top: 50%; left: 50%; width: 1000px; transform: translate(-50%, -50%) translate({{mapX}}px, {{mapY}}px) scale({{mapZoom}}); transform-origin: center center; cursor: {{#if mapPinMode}}crosshair{{else}}grab{{/if}}; transition: transform 0.1s ease-out;">
                            <img src="{{mapImagePath}}" class="agent-map-img" style="display: block; pointer-events: {{#if mapPinMode}}auto{{else}}none{{/if}}; width: 100%; height: auto; opacity: 0.8;">
                            {{!-- Patch5.5 (Ryouhi): GM-placed map indicators. Positioned by x/y as percent
                                  coordinates relative to the map image. Labels show on hover. --}}
                            {{#each mapIndicatorsView}}
                            {{!-- Patch5.5.20: emit data-label-mode + always render the label
                                  with inline opacity. JS reads data-label-mode on
                                  activateListeners and applies hover behavior. Avoids the
                                  CSS specificity / Foundry-cache games entirely. --}}
                            <div class="agent-map-pin" data-label-mode="{{#if this.labelMode}}{{this.labelMode}}{{else}}always{{/if}}" title="{{this.label}}{{#if this.notes}} — {{this.notes}}{{/if}}" style="position: absolute; left: {{this.x}}%; top: {{this.y}}%; transform: translate(-50%, -100%); pointer-events: auto; z-index: 7;">
                                <div style="display: inline-flex; flex-direction: column; align-items: center;">
                                    <i class="fas {{this.icon}}" style="color: {{this.color}}; font-size: 1.1rem; text-shadow: 0 0 6px {{this.color}}, 0 0 2px #000;"></i>
                                    {{#unless (eq this.labelMode "off")}}
                                    <div class="pin-label" style="font-size: 0.55rem; color: #fff; background: rgba(0,0,0,0.7); padding: 1px 6px; border-radius: 3px; border: 1px solid {{this.color}}; margin-top: 2px; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: opacity 0.15s ease-in-out;">{{this.label}}</div>
                                    {{/unless}}
                                </div>
                            </div>
                            {{/each}}
                            {{!-- Modified build (П4): personal CONTACT pins. Rendered with a
                                  ring marker in the contact's own colour so they read distinctly
                                  from GM map indicators. Players see their own; GM sees all. --}}
                            {{#each contactPinsView}}
                            <div class="agent-map-pin agent-contact-pin" title="{{this.label}}{{#if this.owner}} ({{this.owner}}){{/if}}" style="position: absolute; left: {{this.x}}%; top: {{this.y}}%; transform: translate(-50%, -100%); pointer-events: auto; z-index: 8;">
                                <div style="display:inline-flex; flex-direction:column; align-items:center;">
                                    <i class="fas fa-user-circle" style="color: {{this.color}}; font-size: 1.05rem; text-shadow: 0 0 6px {{this.color}}, 0 0 2px #000;"></i>
                                    <div class="pin-label" style="font-size:0.55rem; color:#fff; background:rgba(0,0,0,0.7); padding:1px 6px; border-radius:3px; border:1px solid {{this.color}}; margin-top:2px; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this.label}}{{#if this.owner}} · {{this.owner}}{{/if}}</div>
                                </div>
                            </div>
                            {{/each}}
                        </div>

                        <!-- Tactical Overlay -->
                        <div class="map-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; border: 20px solid rgba(0, 255, 204, 0.05); box-sizing: border-box; z-index: 5; width: 100%; height: 100%;">
                            <div class="map-grid"></div>
                            <div class="map-coords" style="position: absolute; bottom: 10px; right: 10px; font-family: monospace; font-size: 0.6rem; color: var(--neon-cyan); text-shadow: 0 0 5px var(--neon-cyan);">
                                LAT: 34.0522 N <br> LNG: 118.2437 W
                            </div>
                        </div>
                    </div>
                    
                    <div class="map-controls" style="position: absolute; bottom: 20px; right: 20px; display: flex; flex-direction: column; gap: 10px; z-index: 15;">
                        <button type="button" data-action="map-zoom-in" style="width: 42px; height: 42px; border-radius: 50%; background: rgba(0,0,0,0.85); border: 1px solid var(--neon-cyan); color: var(--neon-cyan); cursor: pointer; box-shadow: 0 0 10px rgba(0,255,204,0.3);"><i class="fas fa-plus"></i></button>
                        <button type="button" data-action="map-zoom-out" style="width: 42px; height: 42px; border-radius: 50%; background: rgba(0,0,0,0.85); border: 1px solid var(--neon-cyan); color: var(--neon-cyan); cursor: pointer; box-shadow: 0 0 10px rgba(0,255,204,0.3);"><i class="fas fa-minus"></i></button>
                        {{#if isGM}}
                        {{!-- Patch5.5.3 (Ryouhi UX): GM pin controls moved out of Sys Admin
                              into the Maps app. Click PIN to enter placement mode, then
                              click anywhere on the map — modal opens pre-filled with the
                              click position so the GM never has to think in x/y coords. --}}
                        <button type="button" data-action="map-toggle-pin-mode"
                            title="{{#if mapPinMode}}Pin mode ON — click the map to place a pin. Click here to exit.{{else}}Enter pin placement mode. Click the map to drop a pin.{{/if}}"
                            style="width: 42px; height: 42px; border-radius: 50%; background: {{#if mapPinMode}}rgba(255,204,0,0.85){{else}}rgba(0,0,0,0.85){{/if}}; border: 1px solid {{#if mapPinMode}}#ffcc00{{else}}#ffcc00{{/if}}; color: {{#if mapPinMode}}#000{{else}}#ffcc00{{/if}}; cursor: pointer; box-shadow: 0 0 10px {{#if mapPinMode}}rgba(255,204,0,0.6){{else}}rgba(255,204,0,0.3){{/if}};">
                            <i class="fas fa-map-pin"></i>
                        </button>
                        <button type="button" data-action="map-pin-manage-open"
                            title="Manage pins (show/hide, delete)"
                            style="width: 42px; height: 42px; border-radius: 50%; background: rgba(0,0,0,0.85); border: 1px solid #7c4dff; color: #b599ff; cursor: pointer; box-shadow: 0 0 10px rgba(170,136,255,0.3);">
                            <i class="fas fa-list"></i>
                        </button>
                        {{/if}}
                    </div>
                    {{#if mapPinMode}}
                    <div style="position: absolute; top: 50px; left: 50%; transform: translateX(-50%); padding: 6px 14px; background: rgba(255,204,0,0.95); color: #000; font-family: monospace; font-size: 0.7rem; font-weight: bold; letter-spacing: 1px; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.5); z-index: 16; pointer-events: none;">
                        <i class="fas fa-map-pin"></i> PIN MODE — CLICK MAP TO PLACE
                    </div>
                    {{/if}}

                    {{!-- Patch5.5.3: pin placement modal — opens on map click while in pin mode --}}
                    {{#if showMapPinModal}}
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 200; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 16px;">
                        <div style="background: #0a0a0f; border: 2px solid #ffcc00; border-radius: 10px; padding: 14px; width: 92%; max-width: 360px; box-shadow: 0 0 30px rgba(255,204,0,0.3);">
                            <div style="font-family: monospace; color: #ffcc00; letter-spacing: 2px; font-size: 0.65rem; margin-bottom: 4px;">PLACE PIN</div>
                            <div style="font-family: monospace; color: #888; font-size: 0.55rem; margin-bottom: 10px;">Position: ({{pendingPinX}}, {{pendingPinY}}) — locked to click position</div>
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Label *</label>
                            <input type="text" id="map-pin-modal-label" placeholder="e.g. Afterlife / Ripperdoc / Ambush site" data-preserve-draft style="width: 100%; box-sizing: border-box; background: #111; color: #fff; border: 1px solid #444; padding: 7px 10px; border-radius: 3px; font-family: monospace; font-size: 0.72rem; margin-bottom: 8px;">
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Notes (shown on hover)</label>
                            <input type="text" id="map-pin-modal-notes" placeholder="optional" data-preserve-draft style="width: 100%; box-sizing: border-box; background: #111; color: #fff; border: 1px solid #444; padding: 7px 10px; border-radius: 3px; font-family: monospace; font-size: 0.72rem; margin-bottom: 8px;">
                            <style>
                                .pin-color-swatch { display: inline-block; width: 26px; height: 26px; border: 2px solid #333; border-radius: 50%; box-sizing: border-box; transition: border-color 0.15s, box-shadow 0.15s; }
                                .pin-color-radio:checked + .pin-color-swatch { border-color: #fff; box-shadow: 0 0 0 2px #ffcc00; }
                                .pin-icon-swatch { cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 6px; background: #181a1f; border: 1px solid #333; border-radius: 4px; transition: border-color 0.15s, background 0.15s; }
                                .pin-icon-radio:checked + .pin-icon-swatch { background: rgba(255,204,0,0.18); border-color: #ffcc00; }
                                .pin-icon-radio:checked + .pin-icon-swatch i { color: #ffcc00; }
                                .pin-labelmode-radio:checked ~ .pin-labelmode-text { color: #ffcc00; font-weight: bold; }
                                label:has(.pin-labelmode-radio:checked) { background: rgba(255,204,0,0.12) !important; border-color: #ffcc00 !important; }
                                /* Pin hover-label CSS lives in agent.css now so it survives modal close. */
                            </style>
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Color</label>
                            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 8px;">
                                {{#each mapPinColorPalette}}
                                <label style="cursor: pointer; display: inline-flex; align-items: center;">
                                    <input type="radio" name="map-pin-modal-color" value="{{this.value}}" {{#if @first}}checked{{/if}} style="display: none;" class="pin-color-radio">
                                    <span class="pin-color-swatch" title="{{this.label}}" style="background: {{this.value}};"></span>
                                </label>
                                {{/each}}
                            </div>
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Icon</label>
                            <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; margin-bottom: 10px;">
                                {{#each mapPinIconPalette}}
                                <label title="{{this.label}}" style="display: contents;">
                                    <input type="radio" name="map-pin-modal-icon" value="{{this.value}}" {{#if @first}}checked{{/if}} style="display: none;" class="pin-icon-radio">
                                    <span class="pin-icon-swatch"><i class="fas {{this.value}}" style="color: #aaa; font-size: 0.95rem;"></i></span>
                                </label>
                                {{/each}}
                            </div>
                            <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; cursor: pointer; user-select: none;">
                                <input type="checkbox" id="map-pin-modal-visible" checked style="cursor: pointer;">
                                <span style="font-family: monospace; font-size: 0.7rem; color: #ddd;">Visible to players</span>
                            </label>
                            {{!-- Patch5.5.18 (Sleepingmann): per-pin label display mode. --}}
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Label display</label>
                            <div style="display: flex; gap: 4px; margin-bottom: 12px; font-family: monospace; font-size: 0.65rem;">
                                <label style="flex: 1; cursor: pointer; padding: 6px 8px; background: rgba(255,255,255,0.04); border: 1px solid #444; border-radius: 3px; text-align: center; color: #ccc;">
                                    <input type="radio" name="map-pin-modal-label-mode" value="always" checked style="display: none;" class="pin-labelmode-radio">
                                    <span class="pin-labelmode-text">Always</span>
                                </label>
                                <label style="flex: 1; cursor: pointer; padding: 6px 8px; background: rgba(255,255,255,0.04); border: 1px solid #444; border-radius: 3px; text-align: center; color: #ccc;">
                                    <input type="radio" name="map-pin-modal-label-mode" value="hover" style="display: none;" class="pin-labelmode-radio">
                                    <span class="pin-labelmode-text">Hover only</span>
                                </label>
                                <label style="flex: 1; cursor: pointer; padding: 6px 8px; background: rgba(255,255,255,0.04); border: 1px solid #444; border-radius: 3px; text-align: center; color: #ccc;">
                                    <input type="radio" name="map-pin-modal-label-mode" value="off" style="display: none;" class="pin-labelmode-radio">
                                    <span class="pin-labelmode-text">Off</span>
                                </label>
                            </div>
                            <div style="display: flex; gap: 6px;">
                                <button type="button" data-action="map-pin-modal-cancel" style="flex: 1; padding: 8px; background: rgba(255,51,85,0.1); border: 1px solid #ff3355; color: #ff3355; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 4px;">CANCEL</button>
                                <button type="button" data-action="map-pin-modal-save" style="flex: 1; padding: 8px; background: rgba(255,204,0,0.15); border: 1px solid #ffcc00; color: #ffcc00; font-family: monospace; font-size: 0.7rem; font-weight: bold; cursor: pointer; border-radius: 4px;"><i class="fas fa-map-pin"></i> PLACE</button>
                            </div>
                        </div>
                    </div>
                    {{/if}}

                    {{!-- Patch5.5.3: pin manage modal — list + visible toggle + delete --}}
                    {{#if showMapPinManageModal}}
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 200; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 16px;">
                        <div style="background: #0a0a0f; border: 2px solid #aa88ff; border-radius: 10px; padding: 14px; width: 92%; max-width: 380px; max-height: 80%; display: flex; flex-direction: column; box-shadow: 0 0 30px rgba(170,136,255,0.3);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                <div style="font-family: monospace; color: #b599ff; letter-spacing: 2px; font-size: 0.7rem;">MANAGE PINS</div>
                                <button type="button" data-action="map-pin-manage-close" aria-label="Close" style="background: transparent; border: none; color: #888; cursor: pointer; padding: 4px; line-height: 1; font-size: 0.9rem;"><i class="fas fa-times"></i></button>
                            </div>
                            <div data-preserve-scroll-container="map-pin-manage" style="flex: 1; overflow-y: auto; background: #181a1f; border: 1px solid #2a2d33; border-radius: 4px; padding: 6px;">
                                {{#each mapIndicators}}
                                <div style="display: flex; gap: 8px; padding: 6px; border-bottom: 1px solid #222; align-items: center; font-family: monospace; font-size: 0.65rem;">
                                    <i class="fas {{this.icon}}" style="color: {{this.color}}; flex: 0 0 16px; text-align: center;"></i>
                                    <span style="flex: 1; min-width: 0; color: #ddd; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{this.label}}</span>
                                    <i class="fas fa-eye{{#unless this.visible}}-slash{{/unless}}" data-action="map-pin-toggle" data-pin-id="{{this.id}}" title="{{#if this.visible}}Hide from players{{else}}Show to players{{/if}}" style="cursor: pointer; color: {{#if this.visible}}var(--neon-cyan){{else}}#666{{/if}};"></i>
                                    <i class="fas fa-times" data-action="map-pin-delete" data-pin-id="{{this.id}}" title="Delete pin" style="cursor: pointer; color: #ff3355;"></i>
                                </div>
                                {{else}}
                                <div style="text-align: center; padding: 20px; color: #555; font-size: 0.7rem;">No pins placed yet. Click PIN in the map controls to start.</div>
                                {{/each}}
                            </div>
                            <button type="button" data-action="map-pin-manage-close" style="margin-top: 10px; padding: 8px; background: rgba(170,136,255,0.12); border: 1px solid #7c4dff; color: #b599ff; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 4px;">CLOSE</button>
                        </div>
                    </div>
                    {{/if}}
                </div>

                <!-- BIOMONITOR (TRAUMA TEAM) VIEW -->
                <div id="agent-view-bio" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'bio')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" style="justify-content: space-between;">
                        <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" data-action="back-to-home">
                            <i class="fas fa-chevron-left" style="color: #ff3333;"></i>
                            <h3>{{localize 'AGENTOS.Header.bio'}}</h3>
                        </span>
                        {{!-- Modified build (П6): sync biomonitor + wallet to the current Actor. --}}
                        <i class="fas fa-sync-alt bio-sync-btn" data-action="sync-biomonitor" title="{{localize 'AGENTOS.Sync.Tooltip'}}" style="color: var(--neon-cyan); cursor: pointer; font-size: 0.9rem;"></i>
                    </div>
                    <div class="bio-monitor-view" style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
                        <div class="heart-rate-card" style="background: rgba(255,50,50,0.1); border: 1px solid #ff3333; border-radius: 12px; padding: 15px; text-align: center; position: relative; overflow: hidden;">
                            <div style="font-size: 0.65rem; color: #ff3333; text-transform: uppercase; letter-spacing: 1px;">{{localize 'AGENTOS.Bio.Pulse'}}</div>
                            {{#if pulseRate}}
                            <div style="font-size: 2.5rem; font-family: monospace; color: #fff; text-shadow: 0 0 10px #ff3333;">{{pulseRate}} <span style="font-size: 0.8rem; opacity: 0.6;">BPM</span></div>
                            {{else}}
                            <div style="font-size: 2.5rem; font-family: monospace; color: #ff3333; text-shadow: 0 0 12px #ff3333; letter-spacing: 2px;">— — —</div>
                            <div style="font-size: 0.6rem; color: #ff3333; letter-spacing: 2px; font-weight: bold;">{{localize 'AGENTOS.Bio.Flatline'}}</div>
                            {{/if}}
                            {{#if criticalInjuryCount}}
                            <div style="font-size: 0.58rem; color: #ffcc00; margin-top: 6px; letter-spacing: 1px;"><i class="fas fa-triangle-exclamation"></i> {{localize 'AGENTOS.Bio.CritInjuries'}}: {{criticalInjuryCount}}</div>
                            {{/if}}
                            <i class="fas fa-heart bio-pulse" style="position: absolute; top: 10px; right: 15px; color: #ff3333; font-size: 1.2rem;{{#unless pulseRate}} opacity: 0.25;{{/unless}}"></i>
                        </div>

                        <div class="health-status-card" style="background: rgba(0,0,0,0.4); border: 1px solid #333; border-radius: 12px; padding: 15px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-size: 0.7rem; color: #888; text-transform: uppercase;">Body Integrity</span>
                                <span style="font-size: 0.7rem; color: #fff;">{{hpCurrent}} / {{hpMax}} HP</span>
                            </div>
                            <div class="health-bar-container" style="height: 12px; background: #222; border-radius: 6px; overflow: hidden; border: 1px solid #444;">
                                <div class="health-bar-fill" style="height: 100%; width: {{hpPercent}}%; background: {{hpColor}}; box-shadow: 0 0 10px {{hpColor}}; transition: width 0.5s ease;"></div>
                            </div>
                            <div style="margin-top: 10px; text-align: center;">
                                <span class="wound-badge" style="background: {{hpColor}}; color: #000; font-size: 0.6rem; font-weight: bold; padding: 2px 8px; border-radius: 10px; text-transform: uppercase;">{{woundState}}</span>
                            </div>
                        </div>

                        <div class="humanity-card" style="background: rgba(224,64,251,0.08); border: 1px solid rgba(224,64,251,0.4); border-radius: 12px; padding: 15px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-size: 0.7rem; color: #e040fb; text-transform: uppercase;">Humanity Index</span>
                                <span style="font-size: 0.7rem; color: #fff;">{{humanityCurrent}} / {{humanityMax}}</span>
                            </div>
                            <div style="height: 12px; background: #222; border-radius: 6px; overflow: hidden; border: 1px solid #444;">
                                <div style="height: 100%; width: {{humanityPercent}}%; background: {{humanityColor}}; box-shadow: 0 0 10px {{humanityColor}}; transition: width 0.5s ease;"></div>
                            </div>
                            <div style="margin-top: 8px; text-align: center;">
                                <span style="background: {{humanityColor}}; color: #000; font-size: 0.6rem; font-weight: bold; padding: 2px 8px; border-radius: 10px; text-transform: uppercase;">{{humanityStatus}}</span>
                            </div>
                        </div>

                        {{!-- Patch4.7 (Gotto): Trauma Team coverage gating. Only
                              clients with active TT coverage get the panic button;
                              everyone else sees a dimmed "REO Meatwagon — best of
                              luck" note. GM toggles coverage from Sys Admin. --}}
                        {{#if isTraumaTeamClient}}
                        <div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px;">
                            <div class="panic-alert" data-action="panic-alert" style="padding: 15px; background: rgba(255,0,0,0.2); border: 2px dashed #ff3333; border-radius: 12px; text-align: center; cursor: pointer;">
                                <i class="fas fa-ambulance" style="color: #ff3333; font-size: 1.5rem; margin-bottom: 10px;"></i>
                                <div style="color: #fff; font-weight: bold; font-size: 0.8rem;">TRANSMIT PANIC SIGNAL</div>
                                <div style="font-size: 0.6rem; color: #ff3333;">Immediate Trauma Team Response · COVERAGE: <strong>{{traumaTeamTier}}</strong></div>
                            </div>
                            {{!-- Patch5.5: MedScan request — non-emergency first-aid help. Pings GM. --}}
                            <button type="button" data-action="request-medscan" style="padding: 10px; background: rgba(255,153,0,0.12); border: 1px solid #ff9900; color: #ff9900; border-radius: 8px; cursor: pointer; font-family: monospace; font-size: 0.7rem; font-weight: bold;">
                                <i class="fas fa-stethoscope"></i> REQUEST MEDSCAN
                                <div style="font-size: 0.55rem; color: #ffb84d; margin-top: 4px; font-weight: normal;">Non-emergency first-aid consult. GM will rule on the bonus.</div>
                            </button>
                        </div>
                        {{else}}
                        {{!-- Patch5.5.5 (community ask): players without TT coverage get a
                              clickable REO Meatwagon panic instead of a dead block. Mirrors the
                              full Trauma Team alert pipeline (whisper to GM, panic flag, chat
                              card), just routed under the Meatwagon alias — gives the GM a
                              roleplay hook for a beat-up scrap-grade ambulance run. --}}
                        <div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px;">
                            <div class="panic-alert" data-action="panic-meatwagon" style="padding: 15px; background: rgba(255,153,0,0.15); border: 2px dashed #ff9900; border-radius: 12px; text-align: center; cursor: pointer;">
                                <i class="fas fa-ambulance" style="color: #ff9900; font-size: 1.5rem; margin-bottom: 10px;"></i>
                                <div style="color: #fff; font-weight: bold; font-size: 0.8rem;">CALL REO MEATWAGON</div>
                                <div style="font-size: 0.6rem; color: #ff9900;">No TT coverage · scrap-grade dispatch · roll the dice</div>
                            </div>
                            <div style="font-size: 0.55rem; color: #666; text-align: center; font-style: italic;">No Trauma Team plan on file — REO Meatwagon's the only thing answering the call.{{#if isGM}} (GM: enable TT coverage in Sys Admin → Player Profile.){{/if}}</div>
                        </div>
                        {{/if}}
                    </div>
                </div>

                <!-- NC MART STORE VIEW -->
                <div id="agent-view-store" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'store')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-home" style="justify-content: space-between;">
                        <span style="display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-chevron-left" style="color: var(--neon-cyan);"></i>
                            <h3>{{localize 'AGENTOS.Header.store'}} // {{#if (eq storeView 'cart')}}{{localize 'AGENTOS.Store.Cart'}}{{else}}{{storeCategory}}{{/if}}</h3>
                        </span>
                        <div style="display: flex; align-items: center; gap: 12px; padding-right: 5px;">
                            {{#if (eq storeView 'cart')}}
                                <i class="fas fa-arrow-left" data-action="store-back-to-list" style="color: var(--neon-cyan); cursor: pointer;" title="Back to shop"></i>
                            {{else}}
                                <span data-action="store-view-cart" style="cursor: pointer; position: relative; display: inline-flex; align-items: center; gap: 4px; color: var(--neon-cyan);">
                                    <i class="fas fa-shopping-cart"></i>
                                    {{#if storeCartCount}}<span class="unread-badge" style="position: static; padding: 1px 5px; font-size: 0.55rem;">{{storeCartCount}}</span>{{/if}}
                                </span>
                            {{/if}}
                        </div>
                    </div>

                    {{#if (eq storeView 'cart')}}
                        <!-- CART VIEW -->
                        <div class="store-cart" style="flex: 1; overflow-y: auto; padding: 10px;">
                            {{#each storeCart}}
                                <div class="store-cart-row" style="display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(255,255,255,0.04); border: 1px solid #333; border-radius: 4px; margin-bottom: 6px;">
                                    <img src="{{this.img}}" alt="" style="width: 32px; height: 32px; object-fit: contain; flex-shrink: 0; background: #050505; border: 1px solid #333; border-radius: 2px;">
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-size: 0.72rem; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{this.name}}</div>
                                        <div style="font-size: 0.55rem; color: #888;">{{this.price}}eb &times; {{this.qty}}</div>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 4px;">
                                        <button type="button" data-action="store-qty-dec" data-item-uuid="{{this.itemUuid}}" class="store-qty-btn" style="cursor:pointer; background:#1a1a1a; border:1px solid #555; color:#ccc; padding: 1px 6px; font-family: monospace;">-</button>
                                        <span style="font-size: 0.7rem; color: var(--neon-cyan); min-width: 18px; text-align: center;">{{this.qty}}</span>
                                        <button type="button" data-action="store-qty-inc" data-item-uuid="{{this.itemUuid}}" class="store-qty-btn" style="cursor:pointer; background:#1a1a1a; border:1px solid #555; color:#ccc; padding: 1px 6px; font-family: monospace;">+</button>
                                        <button type="button" data-action="store-remove-item" data-item-uuid="{{this.itemUuid}}" class="store-qty-btn" style="cursor:pointer; background:transparent; border:0; color:#666; padding: 0 2px;" title="Remove"><i class="fas fa-trash"></i></button>
                                    </div>
                                </div>
                            {{else}}
                                <div style="text-align: center; color: #555; font-style: italic; margin-top: 40px; font-size: 0.75rem;">Cart is empty. Pick something out from the shelves.</div>
                            {{/each}}
                        </div>
                        <div class="store-cart-footer">
                            <div class="store-cart-total-row">
                                <span class="store-cart-total-label">TOTAL</span>
                                <span class="store-cart-total-amount">{{storeCartTotal}}eb</span>
                            </div>
                            <button type="button" class="store-checkout-btn" data-action="store-checkout">
                                <i class="fas fa-check"></i> CHECKOUT ({{storeCartTotal}}eb)
                            </button>
                        </div>
                    {{else}}
                        <!-- LIST VIEW -->
                        {{!-- Patch4 round 6 (CommanderCrunch69): old layout had
                              a wide "ALL/CAN BUY" text button next to the search
                              field that ate ~70% of the row (Foundry's `form
                              button` rule was forcing it full-width, plus the
                              padded label). Reclaimed the space — search input
                              is now the dominant element, filter is a single
                              icon toggle pinned to natural width. --}}
                        <div class="store-search-area" style="padding: 8px 10px; background: rgba(0,0,0,0.3); border-bottom: 1px solid #222; display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; gap: 6px; align-items: center; min-width: 0; box-sizing: border-box;">
                            <input type="text" id="store-search-input" class="datapool-input" placeholder="Search NC MART catalog..." value="{{storeSearch}}" autocomplete="off" data-preserve-draft style="flex: 1 1 0 !important; min-width: 0 !important; width: auto !important; box-sizing: border-box; background:#111 !important; color:#fff !important; border:1px solid #444 !important; padding:6px 10px !important; font-family: monospace !important; font-size: 0.72rem !important; border-radius: 3px !important; height: 32px !important; line-height: normal !important;">
                            <button type="button" data-action="toggle-store-affordable" title="{{#if storeFilterAffordable}}Showing affordable only — click to show all{{else}}Show only items you can afford{{/if}}" style="display: inline-flex !important; flex: 0 0 32px !important; width: 32px !important; min-width: 32px !important; height: 32px !important; padding: 0 !important; align-items: center; justify-content: center; cursor: pointer; background: {{#if storeFilterAffordable}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}} !important; border: 1px solid {{#if storeFilterAffordable}}var(--neon-cyan){{else}}#444{{/if}} !important; color: {{#if storeFilterAffordable}}var(--neon-cyan){{else}}#777{{/if}} !important; border-radius: 3px !important; box-shadow: none !important;"><i class="fas fa-wallet" style="font-size: 0.85rem;"></i></button>
                        </div>
                        {{!-- Patch4.7 (Gotto): price-tier filter strip. Sits
                              under the search row so it can flex full-width
                              without competing for space with the affordability
                              wallet icon. --}}
                        <div style="padding: 6px 10px; background: rgba(0,0,0,0.2); border-bottom: 1px solid #222; display: flex; gap: 6px; align-items: center; flex-wrap: nowrap;">
                            <label style="font-size: 0.6rem; color: #888; letter-spacing: 1px; flex: 0 0 auto;">PRICE TIER:</label>
                            <select id="store-price-tier-select" style="flex: 1 1 auto; min-width: 0; background: #111; color: var(--neon-cyan); border: 1px solid #444; border-radius: 3px; padding: 4px 6px; font-family: monospace; font-size: 0.7rem; height: 28px;">
                                {{#each storePriceTiers}}
                                <option value="{{this.value}}" {{#if (eq this.value ../storePriceTier)}}selected{{/if}}>{{this.label}}</option>
                                {{/each}}
                            </select>
                        </div>
                        {{!-- Patch4.7 follow-up: explicit filter-status line so
                              the user can see what's actually filtering. Without
                              this, a category with all-cheap items (e.g. Drugs)
                              made the price-tier dropdown + affordability toggle
                              look like they "did nothing" — they were working,
                              the items just all matched. --}}
                        <div style="padding: 5px 10px; background: rgba(0,0,0,0.35); border-bottom: 1px solid #222; font-family: monospace; font-size: 0.6rem; color: #888; letter-spacing: 0.5px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                            <span>SHOWING <strong style="color: var(--neon-cyan);">{{storeItems.length}}</strong></span>
                            {{#unless (eq storePriceTier 'all')}}<span>· <strong style="color: var(--neon-cyan);">{{storePriceTierLabel}}</strong></span>{{/unless}}
                            {{#if storeFilterAffordable}}<span>· AFFORDABLE ONLY (your balance: <strong style="color: var(--creds-gold);">{{actorCurrency}}eb</strong>)</span>{{/if}}
                        </div>

                        {{#if storeLoaded}}
                            {{!-- Patch5.5: Night Market mode bar. Only renders while a curated
                                  drop is live; toggles between regular catalog and the drop. --}}
                            {{#if nightMarketActive}}
                            <div style="display: flex; gap: 4px; padding: 6px 8px; background: rgba(184,41,255,0.06); border-bottom: 1px solid #aa00ff;">
                                <button type="button" data-action="store-set-mode" data-mode="catalog" style="cursor: pointer; flex: 1; padding: 5px 10px; background: {{#if (eq storeMode 'catalog')}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq storeMode 'catalog')}}var(--neon-cyan){{else}}#444{{/if}}; color: {{#if (eq storeMode 'catalog')}}var(--neon-cyan){{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.65rem; border-radius: 3px;"><i class="fas fa-store"></i> CATALOG</button>
                                <button type="button" data-action="store-set-mode" data-mode="nightmarket" style="cursor: pointer; flex: 1; padding: 5px 10px; background: {{#if (eq storeMode 'nightmarket')}}rgba(170,0,255,0.22){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq storeMode 'nightmarket')}}#aa00ff{{else}}#444{{/if}}; color: {{#if (eq storeMode 'nightmarket')}}#cc77ff{{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.65rem; border-radius: 3px;"><i class="fas fa-moon"></i> NIGHT MARKET</button>
                            </div>
                            {{/if}}

                            {{#if (eq storeMode 'nightmarket')}}
                            {{!-- Night Market view: curated drop with flavor blurbs. --}}
                            <div class="store-item-list" style="flex: 1; overflow-y: auto; padding: 8px;">
                                <div style="padding: 6px 10px; margin-bottom: 8px; background: rgba(184,41,255,0.08); border: 1px solid #b829ff; border-radius: 4px; text-align: center; font-family: monospace;">
                                    <div style="font-size: 0.7rem; color: #cc77ff; letter-spacing: 2px;"><i class="fas fa-moon"></i> {{nightMarket.name}}</div>
                                    <div style="font-size: 0.55rem; color: #888; margin-top: 2px;">Limited drop · check back tomorrow night</div>
                                </div>
                                {{#each nightMarket.items}}
                                    <div class="store-item" style="border-color: #cc77ff;">
                                        <img class="store-item-img" src="{{this.img}}" alt="" onerror="this.style.visibility='hidden'">
                                        <div class="store-item-body">
                                            <div class="store-item-name">{{this.name}}</div>
                                            {{#if this.flavor}}<div style="font-size: 0.6rem; color: #cc77ff; font-style: italic; margin-top: 2px;">"{{this.flavor}}"</div>{{/if}}
                                            <div class="store-item-meta">
                                                <span class="store-item-price">{{this.price}}eb</span>
                                                <span class="store-item-type" style="color: #cc77ff;">night drop</span>
                                            </div>
                                        </div>
                                        <button type="button" data-action="store-add-to-cart" data-item-uuid="{{this.uuid}}" class="store-add-btn" title="Add to cart">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                {{else}}
                                    <div style="text-align: center; color: #555; font-style: italic; margin-top: 30px; font-size: 0.75rem;">The Night Market hasn't dropped anything yet.</div>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="store-category-bar" style="display: flex; gap: 4px; padding: 6px 8px; overflow-x: auto; background: rgba(0,0,0,0.2); border-bottom: 1px solid #222; flex-shrink: 0;">
                                {{#each storeCategories}}
                                    <button type="button" data-action="store-set-category" data-category="{{this}}" class="store-cat-btn{{#if (eq this ../storeCategory)}} active{{/if}}" style="cursor: pointer; padding: 4px 10px; background: {{#if (eq this ../storeCategory)}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq this ../storeCategory)}}var(--neon-cyan){{else}}#444{{/if}}; color: {{#if (eq this ../storeCategory)}}var(--neon-cyan){{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.62rem; border-radius: 3px; white-space: nowrap;">{{this}}</button>
                                {{/each}}
                            </div>

                            <div class="store-item-list" style="flex: 1; overflow-y: auto; padding: 8px;">
                                {{#each storeItems}}
                                    <div class="store-item">
                                        <img class="store-item-img" src="{{this.img}}" alt="">
                                        <div class="store-item-body">
                                            <div class="store-item-name">{{this.name}}</div>
                                            <div class="store-item-meta">
                                                <span class="store-item-price">{{this.price}}eb</span>
                                                <span class="store-item-type">{{this.type}}</span>
                                            </div>
                                        </div>
                                        <button type="button" data-action="store-add-to-cart" data-item-uuid="{{this.uuid}}" class="store-add-btn" title="Add to cart">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                {{else}}
                                    <div style="text-align: center; color: #555; font-style: italic; margin-top: 30px; font-size: 0.75rem;">No items in this category.</div>
                                {{/each}}
                            </div>
                            {{/if}}
                        {{else}}
                            <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #888; font-family: monospace;">
                                <i class="fas fa-spinner fa-spin" style="font-size: 1.5rem; color: var(--neon-cyan); margin-bottom: 10px;"></i>
                                <div style="font-size: 0.7rem;">Stocking shelves...</div>
                                <div style="font-size: 0.55rem; color: #555; margin-top: 4px;">Indexing CPR compendiums</div>
                            </div>
                        {{/if}}
                    {{/if}}
                </div>

                <!-- AGENT ID VIEW -->
                <div id="agent-view-id" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'id')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" style="justify-content: space-between;">
                        <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" data-action="back-to-home">
                            <i class="fas fa-chevron-left" style="color: #4488ff;"></i>
                            <h3>{{localize 'AGENTOS.Header.id'}}</h3>
                        </span>
                        {{#if canEditId}}<i class="fas fa-pen" data-action="edit-agent-id" style="color: #4488ff; cursor: pointer; padding-right: 8px; font-size: 0.7rem;" title="Edit ID Fields"></i>{{/if}}
                    </div>

                    {{!-- GM: Player selector tabs --}}
                    {{#if canEditId}}
                    <div style="display: flex; gap: 4px; padding: 4px 12px; overflow-x: auto; flex-shrink: 0; background: rgba(0,0,0,0.3); border-bottom: 1px solid #222;">
                        {{#each idPlayerList}}
                        <div data-action="id-select-player" data-player-id="{{this.id}}" style="cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 5px 10px; background: {{#if (eq this.id ../idTargetUserId)}}rgba(68,136,255,0.2){{else}}rgba(255,255,255,0.03){{/if}}; border: 1px solid {{#if (eq this.id ../idTargetUserId)}}#4488ff{{else}}#333{{/if}}; border-radius: 6px; white-space: nowrap; transition: all 0.2s;">
                            <img src="{{this.img}}" style="width: 20px; height: 20px; border-radius: 50%; object-fit: cover; border: 1px solid {{#if (eq this.id ../idTargetUserId)}}#4488ff{{else}}#444{{/if}};">
                            <span style="font-size: 0.65rem; color: {{#if (eq this.id ../idTargetUserId)}}#fff{{else}}#888{{/if}};">{{this.actorName}}</span>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                    <div class="id-view" style="padding: 20px; flex: 1; overflow-y: auto;">
                        <div class="id-card" style="background: linear-gradient(135deg, #111 0%, #222 100%); border: 1px solid #4488ff; border-radius: 12px; padding: 20px; box-shadow: 0 0 15px rgba(68,136,255,0.2);">
                            <div style="display: flex; gap: 15px; margin-bottom: 20px;">
                                <div style="width: 60px; height: 60px; background: #050505; border: 1px solid #4488ff; border-radius: 4px; display: flex; justify-content: center; align-items: center; overflow: hidden;">
                                    {{#if idViewImg}}
                                    <img src="{{idViewImg}}" style="width: 100%; height: 100%; object-fit: cover;">
                                    {{else}}
                                    <i class="fas fa-user-astronaut" style="font-size: 2rem; color: #444;"></i>
                                    {{/if}}
                                </div>
                                <div>
                                    <div style="font-size: 1.1rem; font-weight: bold; color: #fff;">{{idViewName}}</div>
                                    <div style="font-size: 0.6rem; color: #4488ff; text-transform: uppercase;">{{idViewSubtitle}}</div>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                                <div>
                                    <div style="font-size: 0.55rem; color: #666; text-transform: uppercase;">Role</div>
                                    <div style="font-size: 0.8rem; color: #eee;">{{idViewRole}}</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.55rem; color: #666; text-transform: uppercase;">Handle</div>
                                    <div style="font-size: 0.8rem; color: #eee;">{{idViewHandle}}</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.55rem; color: #666; text-transform: uppercase;">SIN Status</div>
                                    <div style="font-size: 0.8rem; color: {{#if (eq idViewSinStatus 'No SIN')}}#ff3333{{else}}#eee{{/if}};">{{idViewSinStatus}}</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.55rem; color: #666; text-transform: uppercase;">Clearance</div>
                                    <div style="font-size: 0.8rem; color: #44ff44;">{{idViewClearance}}</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.55rem; color: #666; text-transform: uppercase;">Network ID</div>
                                    <div style="font-size: 0.8rem; color: #eee; font-family: monospace;">ZR-{{idViewIdShort}}</div>
                                </div>
                            </div>

                            {{!-- Patch5.5 (Gotto): housing / rent status. Patch5.5.20: show the
                                  block when EITHER status OR rent is set — Tester1's "rent terst"
                                  was being hidden because the wrapper conditional only checked
                                  housingStatus. Show '(no address on file)' as the status line
                                  when only rent is set so the block reads sensibly either way. --}}
                            {{#if housingHasAny}}
                            <div style="margin-top: 14px; padding: 10px; background: rgba(68,136,255,0.05); border: 1px solid #4488ff; border-radius: 6px;">
                                <div style="font-size: 0.55rem; color: #4488ff; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-home"></i> Housing</div>
                                <div style="font-size: 0.8rem; color: #eee; margin-top: 2px;">{{#if housingStatus}}{{housingStatus}}{{else}}<span style="color:#888; font-style:italic;">(no address on file)</span>{{/if}}</div>
                                {{#if housingRent}}<div style="font-size: 0.65rem; color: var(--creds-gold); margin-top: 4px;">Rent: {{housingRent}}</div>{{/if}}
                            </div>
                            {{/if}}

                            <div style="margin-top: 30px; text-align: center;">
                                <i class="fas fa-fingerprint" style="font-size: 80px; opacity: 0.1; color: #4488ff;"></i>
                                <div style="font-size: 0.5rem; color: #444; font-family: monospace; margin-top: 10px;">ENCRYPTED CITINET TOKEN // SIGNED BY ZIGGURAT</div>
                            </div>
                        </div>

                        {{#if hasMultipleActors}}
                        <div style="margin-top: 16px; padding: 12px; background: rgba(0,0,0,0.3); border: 1px solid #333; border-radius: 8px;">
                            <div style="font-size: 0.6rem; color: #666; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px;"><i class="fas fa-users-cog"></i> Switch Active Identity</div>
                            {{#each ownedActors}}
                            <div data-action="switch-actor" data-actor-uuid="{{this.uuid}}" style="cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 8px; margin-bottom: 4px; background: {{#if this.isActive}}rgba(68,136,255,0.15){{else}}rgba(255,255,255,0.03){{/if}}; border: 1px solid {{#if this.isActive}}#4488ff{{else}}#333{{/if}}; border-radius: 6px; transition: all 0.2s;">
                                <img src="{{this.img}}" style="width: 28px; height: 28px; border-radius: 4px; object-fit: cover; border: 1px solid {{#if this.isActive}}#4488ff{{else}}#444{{/if}};">
                                <div style="flex: 1;">
                                    <div style="font-size: 0.75rem; color: {{#if this.isActive}}#fff{{else}}#aaa{{/if}}; font-weight: {{#if this.isActive}}600{{else}}400{{/if}};">{{this.name}}</div>
                                </div>
                                {{#if this.isActive}}<i class="fas fa-check-circle" style="color: #4488ff; font-size: 0.7rem;"></i>{{/if}}
                            </div>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                </div>

                <!-- NETSTATUS VIEW -->
                <div id="agent-view-social" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'social')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-home">
                        <i class="fas fa-chevron-left" style="color: #ff9900;"></i>
                        <h3>{{localize 'AGENTOS.Header.social'}}</h3>
                    </div>
                    <div class="social-view" style="padding: 15px; flex: 1; overflow-y: auto;">
                        <div style="text-align: center; margin-bottom: 16px;">
                            <div style="font-size: 0.6rem; color: #ff9900; text-transform: uppercase;">Current Rep Score</div>
                            <div style="font-size: 2rem; font-weight: 800; color: #fff;">{{repScore}}</div>
                            <div style="font-size: 0.55rem; color: #888;">Rank: {{repRank}}</div>
                        </div>

                        {{!-- Patch4.7 follow-up: phone-frame width was crushing
                              the composer — select+input+POST competed for the
                              same row and the input got truncated to "Broadcast
                              something t...". Restructured into stacked rows so
                              each control gets full width. --}}
                        <div class="social-composer">
                            <div class="social-composer-row" style="margin-bottom: 6px;">
                                <select id="social-post-category" class="social-composer-select" data-preserve-draft style="flex: 0 0 110px;">
                                    <option value="Post">Post</option>
                                    <option value="Trending in Night City">Trending</option>
                                    <option value="DataPool Alert">DataPool</option>
                                    <option value="Street News">Street News</option>
                                    <option value="Gig Board">Gig Board</option>
                                    <option value="Rumor">Rumor</option>
                                </select>
                                <input id="social-post-text" type="text" class="social-composer-input" placeholder="Broadcast something to the Net..." data-preserve-draft style="flex: 1 1 auto !important; min-width: 0 !important;">
                            </div>
                            {{#if isGM}}
                            {{!-- GM persona override for posts. Blank = post as
                                  Gamemaster. Filled = post as that NPC name. --}}
                            <div class="social-composer-row" style="margin-bottom: 6px;">
                                <input id="social-post-as" type="text" class="social-composer-input" style="flex: 1 1 auto !important; min-width: 0 !important; width: auto !important; box-sizing: border-box;" placeholder="Post AS (optional NPC — blank = Gamemaster)" data-preserve-draft>
                            </div>
                            {{!-- Patch5.5: Screamsheet toggle. When checked, the post
                                  renders as a styled broadsheet card in the feed. --}}
                            <div class="social-composer-row" style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                                <label style="display: flex; align-items: center; gap: 6px; font-family: monospace; font-size: 0.65rem; color: #ff9900; cursor: pointer; user-select: none;">
                                    <input type="checkbox" id="social-screamsheet-toggle" data-preserve-draft style="cursor: pointer;">
                                    <i class="fas fa-newspaper"></i> Publish as Screamsheet
                                </label>
                                <span style="font-size: 0.55rem; color: #666;">— styled broadsheet card</span>
                            </div>
                            {{/if}}
                            <div class="social-composer-row">
                                <button type="button" class="social-composer-btn" data-action="post-social" style="flex: 1 1 auto !important; width: auto !important; display: inline-flex !important; align-items: center; justify-content: center; gap: 6px;">
                                    <i class="fas fa-paper-plane"></i> POST
                                </button>
                            </div>
                            <div class="social-composer-hint">Posts are visible to everyone on the Net.</div>
                        </div>

                        {{!-- Patch4.7 (Gotto): filter chip strip. ALL clears the
                              filter; click a category to scope the feed. --}}
                        {{#if socialFilterCategories.length}}
                        <div style="display: flex; gap: 4px; flex-wrap: wrap; padding: 6px 0 10px 0;">
                            <button type="button" data-action="social-set-filter" data-cat="all" style="cursor: pointer; padding: 3px 10px; background: {{#if (eq socialFilter 'all')}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq socialFilter 'all')}}var(--neon-cyan){{else}}#444{{/if}}; color: {{#if (eq socialFilter 'all')}}var(--neon-cyan){{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.62rem; border-radius: 3px;">ALL</button>
                            {{#each socialFilterCategories}}
                            <button type="button" data-action="social-set-filter" data-cat="{{this}}" style="cursor: pointer; padding: 3px 10px; background: {{#if (eq this ../socialFilter)}}rgba(0,255,204,0.18){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq this ../socialFilter)}}var(--neon-cyan){{else}}#444{{/if}}; color: {{#if (eq this ../socialFilter)}}var(--neon-cyan){{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.62rem; border-radius: 3px;">{{this}}</button>
                            {{/each}}
                        </div>
                        {{/if}}

                        {{#if socialFeedArticles.length}}
                            {{#each socialFeedArticles}}
                                {{#if this.isScreamsheet}}
                                {{!-- Patch5.5: Screamsheet styled card — pirate broadsheet
                                      look. Yellowed paper, bold serif headline, red category
                                      stamp, signoff at the bottom. --}}
                                <div class="screamsheet-card" style="position: relative; padding: 14px 14px 12px 14px; margin-bottom: 12px; background: linear-gradient(135deg, #d4c08a 0%, #c4ad6b 50%, #b89958 100%); border: 2px solid #5a4520; border-radius: 3px; box-shadow: 0 3px 8px rgba(0,0,0,0.5), inset 0 0 30px rgba(90,69,32,0.3); color: #1a0f00; font-family: 'Georgia', 'Times New Roman', serif;">
                                    <div style="position: absolute; top: 6px; right: 8px; padding: 2px 8px; background: #8b0000; color: #f4e5b8; font-family: monospace; font-size: 0.6rem; letter-spacing: 2px; transform: rotate(2deg); border: 1px solid #1a0f00;">{{this.category}}</div>
                                    {{#if this.canDelete}}
                                        <i class="fas fa-times" data-action="delete-social-post" data-post-id="{{this.id}}" title="Delete screamsheet" style="position: absolute; top: 4px; left: 6px; color: #5a4520; cursor: pointer; font-size: 0.75rem;"></i>
                                    {{/if}}
                                    <div style="font-size: 0.55rem; letter-spacing: 3px; color: #5a4520; text-align: center; margin-bottom: 4px;">★ SCREAMSHEET ★</div>
                                    <div style="font-size: 0.95rem; font-weight: 800; line-height: 1.25; text-align: center; padding: 2px 0 6px 0; border-bottom: 1px dashed #5a4520; color: #1a0f00;">{{this.text}}</div>
                                    {{#if this.authorName}}
                                        <div style="font-size: 0.6rem; font-style: italic; text-align: right; margin-top: 6px; color: #5a4520;">— {{this.authorName}}</div>
                                    {{/if}}
                                </div>
                                {{else}}
                                <div class="feed-item">
                                    <div class="feed-item-head">
                                        <div class="feed-item-category">{{this.category}}</div>
                                        {{#if this.canDelete}}
                                            <i class="fas fa-times feed-item-delete" data-action="delete-social-post" data-post-id="{{this.id}}" title="Delete post"></i>
                                        {{/if}}
                                    </div>
                                    <div class="feed-item-body">{{this.text}}</div>
                                    {{#if this.authorName}}
                                        <div class="feed-item-author">— {{this.authorName}}</div>
                                    {{/if}}
                                </div>
                                {{/if}}
                            {{/each}}
                        {{else}}
                            <div class="feed-item" style="padding: 12px; background: rgba(255,153,0,0.05); border: 1px solid #444; border-radius: 8px; margin-bottom: 10px;">
                                <div style="font-size: 0.6rem; color: #ff9900; margin-bottom: 5px;">Trending in Night City</div>
                                <div style="font-size: 0.8rem; color: #eee;">Arasaka confirms "Peace of Mind" initiative extension...</div>
                            </div>
                            <div class="feed-item" style="padding: 12px; background: rgba(255,153,0,0.05); border: 1px solid #444; border-radius: 8px; margin-bottom: 10px;">
                                <div style="font-size: 0.6rem; color: #ff9900; margin-bottom: 5px;">DataPool Alert</div>
                                <div style="font-size: 0.8rem; color: #eee;">New "EuroDyne" track drops tonight at Midnight. Pre-sync now.</div>
                            </div>
                        {{/if}}
                    </div>
                </div>
                
                <!-- STYLE CHECKER VIEW -->
                <div id="agent-view-style" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'style')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-home">
                        <i class="fas fa-chevron-left" style="color: #e040fb;"></i>
                        <h3>{{localize 'AGENTOS.Header.style'}}</h3>
                    </div>
                    <div class="style-view" style="padding: 12px; flex: 1; overflow-y: auto;">
                        <!-- Fashion Score Header -->
                        <div class="style-score-header" style="text-align: center; margin-bottom: 14px; padding: 14px; background: rgba(224,64,251,0.06); border: 1px solid rgba(224,64,251,0.3); border-radius: 8px; position: relative;">
                            <i class="fas fa-info-circle" data-action="toggle-style-info" title="What is the Style Rating?" style="position: absolute; top: 8px; right: 8px; color: rgba(224,64,251,0.7); cursor: pointer; font-size: 0.9rem;"></i>
                            <div style="font-size: 0.55rem; color: #e040fb; text-transform: uppercase; letter-spacing: 2px;">Style Rating</div>
                            <div style="font-size: 2.2rem; font-weight: 800; color: {{styleColor}}; text-shadow: 0 0 12px {{styleColor}};">{{styleScore}}</div>
                            <div style="font-size: 0.7rem; color: {{styleColor}}; font-weight: 600;">{{styleRating}}</div>
                            <div style="margin-top: 8px; height: 4px; background: rgba(255,255,255,0.08); border-radius: 2px; overflow: hidden;">
                                <div style="height: 100%; width: {{styleScore}}%; background: {{styleColor}}; border-radius: 2px; transition: width 0.4s;"></div>
                            </div>
                            {{#if showStyleInfo}}
                            <div style="margin-top: 10px; padding: 10px; background: rgba(0,0,0,0.55); border: 1px solid rgba(224,64,251,0.4); border-radius: 6px; text-align: left; font-family: monospace; font-size: 0.62rem; line-height: 1.5; color: #ccc;">
                                <div style="color:#e040fb; letter-spacing:1px; margin-bottom:4px;">HOW IT'S CALCULATED</div>
                                Equipped clothing/armor × 15 <span style="color:#888;">(cap 60)</span><br>
                                + Equipped cyberware × 10 <span style="color:#888;">(cap 30)</span><br>
                                + Fixer rep bonus <span style="color:#888;">(cap 10)</span><br>
                                <span style="color:#666;">— Total capped at 100 —</span>
                                <div style="margin-top:6px; color:#e040fb; letter-spacing:1px;">TIERS</div>
                                80+ ICONIC · 60+ EDGERUNNER · 40+ STREETWISE · 20+ BASIC · &lt;20 GONK
                            </div>
                            {{/if}}
                        </div>

                        {{!-- Patch4.7 (Gotto): style trend + wardrobe modifiers.
                              GM-set world setting drives the current trend label;
                              wardrobe modifiers come from per-user flag list. --}}
                        {{#if styleTrend}}
                        <div style="margin-bottom: 12px; padding: 10px; background: rgba(224,64,251,0.04); border: 1px dashed rgba(224,64,251,0.4); border-radius: 6px;">
                            <div style="font-size: 0.55rem; color: #e040fb; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px;">Current Trend in Night City</div>
                            <div style="font-size: 0.8rem; color: #fff; font-weight: 600;">{{styleTrend}}</div>
                            {{#if styleTrendDesc}}<div style="font-size: 0.6rem; color: #aaa; margin-top: 4px;">{{styleTrendDesc}}</div>{{/if}}
                        </div>
                        {{/if}}

                        {{#if styleWardrobeModifiers.length}}
                        <div style="margin-bottom: 12px; padding: 10px; background: rgba(0,0,0,0.35); border: 1px solid #333; border-radius: 6px;">
                            <div style="font-size: 0.55rem; color: #e040fb; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px;">Wardrobe &amp; Style Modifiers</div>
                            {{#each styleWardrobeModifiers}}
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px dashed #2a2a2a; font-size: 0.7rem;">
                                <span style="color: #ccc;">{{this.label}}</span>
                                <span style="color: {{#if this.positive}}#64ffda{{else}}#ff5555{{/if}}; font-weight: bold; font-family: monospace;">{{#if this.positive}}+{{/if}}{{this.value}}</span>
                            </div>
                            {{/each}}
                        </div>
                        {{/if}}

                        <!-- Tab Switcher -->
                        <div style="display: flex; gap: 4px; margin-bottom: 12px;">
                            <button type="button" class="style-tab-btn {{#if (eq styleTab 'outfit')}}active{{/if}}" data-action="style-tab" data-tab="outfit" style="flex:1; padding: 6px; background: {{#if (eq styleTab 'outfit')}}rgba(224,64,251,0.15){{else}}rgba(0,0,0,0.3){{/if}}; border: 1px solid {{#if (eq styleTab 'outfit')}}#e040fb{{else}}#444{{/if}}; color: {{#if (eq styleTab 'outfit')}}#e040fb{{else}}#888{{/if}}; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 4px;">
                                <i class="fas fa-tshirt"></i> OUTFIT
                            </button>
                            <button type="button" class="style-tab-btn {{#if (eq styleTab 'gear')}}active{{/if}}" data-action="style-tab" data-tab="gear" style="flex:1; padding: 6px; background: {{#if (eq styleTab 'gear')}}rgba(224,64,251,0.15){{else}}rgba(0,0,0,0.3){{/if}}; border: 1px solid {{#if (eq styleTab 'gear')}}#e040fb{{else}}#444{{/if}}; color: {{#if (eq styleTab 'gear')}}#e040fb{{else}}#888{{/if}}; font-family: monospace; font-size: 0.7rem; cursor: pointer; border-radius: 4px;">
                                <i class="fas fa-crosshairs"></i> GEAR
                            </button>
                        </div>

                        {{#if (eq styleTab 'outfit')}}
                            {{#if styleOutfit.length}}
                                {{#each styleOutfit}}
                                <div class="style-item" style="display: flex; align-items: center; gap: 10px; padding: 8px; background: rgba(224,64,251,0.04); border: 1px solid #333; border-radius: 6px; margin-bottom: 6px;">
                                    <img src="{{this.img}}" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover; border: 1px solid #555;">
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-size: 0.75rem; color: #fff; font-weight: 600;">{{this.name}}</div>
                                        <div style="font-size: 0.55rem; color: #888; text-transform: uppercase;">{{this.type}}</div>
                                    </div>
                                </div>
                                {{/each}}
                            {{else}}
                                <div style="text-align: center; padding: 20px; color: #666; font-size: 0.75rem;">
                                    <i class="fas fa-tshirt" style="font-size: 1.5rem; margin-bottom: 8px; display: block;"></i>
                                    No clothing or armor equipped. Dress up, choom.
                                </div>
                            {{/if}}
                        {{else}}
                            {{#if styleGear.length}}
                                {{#each styleGear}}
                                <div class="style-item" style="display: flex; align-items: center; gap: 10px; padding: 8px; background: rgba(100,255,218,0.04); border: 1px solid #333; border-radius: 6px; margin-bottom: 6px;">
                                    <img src="{{this.img}}" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover; border: 1px solid #555;">
                                    <div style="flex: 1; min-width: 0;">
                                        <div style="font-size: 0.75rem; color: #fff; font-weight: 600;">{{this.name}}</div>
                                        <div style="font-size: 0.55rem; color: #64ffda; text-transform: uppercase;">{{this.type}}</div>
                                    </div>
                                </div>
                                {{/each}}
                            {{else}}
                                <div style="text-align: center; padding: 20px; color: #666; font-size: 0.75rem;">
                                    <i class="fas fa-crosshairs" style="font-size: 1.5rem; margin-bottom: 8px; display: block;"></i>
                                    No equipped gear detected. Get chromed, choom.
                                </div>
                            {{/if}}
                        {{/if}}
                    </div>
                </div>

                <!-- NPC REPUTATION TRACKER VIEW -->
                <div id="agent-view-rep" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'rep')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-home">
                        <i class="fas fa-chevron-left" style="color: #64ffda;"></i>
                        <h3>{{localize 'AGENTOS.Header.rep'}}</h3>
                    </div>
                    <div class="rep-view" style="padding: 12px; flex: 1; overflow-y: auto; overflow-x: hidden; box-sizing: border-box; min-width: 0;">
                        {{#if isGM}}
                        {{!-- Patch3.5: layout was overflowing the phone frame —
                              the + button was flex-growing past the right edge.
                              Lock the row to 100% width, force button to its
                              intrinsic size, and let the two inputs share what's left. --}}
                        <div class="rep-add-row" style="display: flex; gap: 4px; margin-bottom: 12px; align-items: center; width: 100%; min-width: 0; box-sizing: border-box;">
                            <input type="text" id="rep-npc-name" class="rep-input" placeholder="NPC Name" style="flex: 1 1 0; min-width: 0;" data-preserve-draft>
                            <input type="text" id="rep-npc-faction" class="rep-input rep-input-sm" placeholder="Faction" style="flex: 1 1 0; min-width: 0;" data-preserve-draft>
                            <button type="button" data-action="rep-add-npc" class="rep-add-btn" style="flex: 0 0 auto; width: 36px; min-width: 36px; padding: 6px 0; text-align: center;">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        {{/if}}

                        {{#if npcReputations.length}}
                        <div class="rep-sort-row" style="display:flex; align-items:center; gap:8px; margin-bottom:10px; font-family:monospace; font-size:0.65rem;">
                            <span style="color:var(--neon-cyan); letter-spacing:1px;">SORT:</span>
                            <select id="rep-sort-select" class="rep-input" style="flex:1; max-width:160px;">
                                {{#each repSortOptions}}
                                <option value="{{this.id}}" {{#if (eq this.id ../repSort)}}selected{{/if}}>{{this.label}}</option>
                                {{/each}}
                            </select>
                        </div>
                        {{/if}}

                        {{#if npcReputations.length}}
                            {{#each npcReputations}}
                            <div class="rep-card" style="padding: 10px; background: rgba(100,255,218,0.04); border: 1px solid #333; border-radius: 8px; margin-bottom: 8px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                    <div>
                                        <div style="font-size: 0.8rem; color: #fff; font-weight: 600;">{{this.name}}</div>
                                        <div style="font-size: 0.55rem; color: #888;">{{this.faction}}</div>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <span class="rep-standing-badge rep-standing-{{this.standing}}" style="font-size: 0.55rem; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">
                                            {{this.standing}}
                                        </span>
                                        {{!-- Patch4.7 (Gotto): jump to a Messenger thread for this fixer. --}}
                                        <i class="fas fa-comment-dots" data-action="rep-open-messenger" data-npc-id="{{this.id}}" data-npc-name="{{this.name}}" title="Open Messenger thread with {{this.name}}" style="cursor: pointer; color: var(--neon-cyan); font-size: 0.65rem;"></i>
                                        {{#if ../isGM}}
                                        {{!-- Patch4.7 (Gotto): edit a fixer entry in place. --}}
                                        <i class="fas fa-pen" data-action="rep-edit-npc" data-npc-id="{{this.id}}" data-npc-name="{{this.name}}" data-npc-faction="{{this.faction}}" title="Edit this contact" style="cursor: pointer; color: #888; font-size: 0.6rem;"></i>
                                        <i class="fas fa-trash-alt" data-action="rep-delete-npc" data-npc-id="{{this.id}}" title="Remove contact" style="cursor: pointer; color: #555; font-size: 0.6rem;"></i>
                                        {{/if}}
                                    </div>
                                </div>
                                {{#if ../isGM}}
                                <div style="display: flex; gap: 3px; margin-top: 4px;">
                                    <button type="button" class="rep-btn {{#if (eq this.standing 'allied')}}rep-btn-active{{/if}}" data-action="rep-set-standing" data-npc-id="{{this.id}}" data-standing="allied" style="font-size: 0.5rem; padding: 2px 6px; background: {{#if (eq this.standing 'allied')}}rgba(68,255,68,0.2){{else}}rgba(0,0,0,0.3){{/if}}; border: 1px solid {{#if (eq this.standing 'allied')}}#44ff44{{else}}#444{{/if}}; color: {{#if (eq this.standing 'allied')}}#44ff44{{else}}#888{{/if}}; cursor: pointer; border-radius: 3px; font-family: monospace;">ALLIED</button>
                                    <button type="button" class="rep-btn {{#if (eq this.standing 'friendly')}}rep-btn-active{{/if}}" data-action="rep-set-standing" data-npc-id="{{this.id}}" data-standing="friendly" style="font-size: 0.5rem; padding: 2px 6px; background: {{#if (eq this.standing 'friendly')}}rgba(100,255,218,0.2){{else}}rgba(0,0,0,0.3){{/if}}; border: 1px solid {{#if (eq this.standing 'friendly')}}#64ffda{{else}}#444{{/if}}; color: {{#if (eq this.standing 'friendly')}}#64ffda{{else}}#888{{/if}}; cursor: pointer; border-radius: 3px; font-family: monospace;">FRIENDLY</button>
                                    <button type="button" class="rep-btn {{#if (eq this.standing 'neutral')}}rep-btn-active{{/if}}" data-action="rep-set-standing" data-npc-id="{{this.id}}" data-standing="neutral" style="font-size: 0.5rem; padding: 2px 6px; background: {{#if (eq this.standing 'neutral')}}rgba(255,204,0,0.2){{else}}rgba(0,0,0,0.3){{/if}}; border: 1px solid {{#if (eq this.standing 'neutral')}}#ffcc00{{else}}#444{{/if}}; color: {{#if (eq this.standing 'neutral')}}#ffcc00{{else}}#888{{/if}}; cursor: pointer; border-radius: 3px; font-family: monospace;">NEUTRAL</button>
                                    <button type="button" class="rep-btn {{#if (eq this.standing 'hostile')}}rep-btn-active{{/if}}" data-action="rep-set-standing" data-npc-id="{{this.id}}" data-standing="hostile" style="font-size: 0.5rem; padding: 2px 6px; background: {{#if (eq this.standing 'hostile')}}rgba(255,50,50,0.2){{else}}rgba(0,0,0,0.3){{/if}}; border: 1px solid {{#if (eq this.standing 'hostile')}}#ff3333{{else}}#444{{/if}}; color: {{#if (eq this.standing 'hostile')}}#ff3333{{else}}#888{{/if}}; cursor: pointer; border-radius: 3px; font-family: monospace;">HOSTILE</button>
                                </div>
                                {{/if}}
                            </div>
                            {{/each}}
                        {{else}}
                            <div style="text-align: center; padding: 30px; color: #666; font-size: 0.75rem;">
                                <i class="fas fa-handshake" style="font-size: 1.5rem; margin-bottom: 8px; display: block; color: #64ffda;"></i>
                                No contacts in the network yet.
                                {{#if isGM}}<br>Add NPCs and factions above.{{/if}}
                            </div>
                        {{/if}}
                    </div>
                </div>

                {{!-- ════════════════════════════════════════════════════════
                      Modified build (П4): PERSONAL CONTACTS
                      Players manage their own contacts; the GM sees everyone's
                      grouped into per-player folders.
                      ════════════════════════════════════════════════════════ --}}
                <div id="agent-view-personal-contacts" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'contacts')}}flex{{else}}none{{/if}}; height: 100%; position: relative;">
                    <div class="app-header" style="background: rgba(57,217,138,0.10); border-bottom: 2px solid #39d98a; display: flex; align-items: center; justify-content: space-between;">
                        <div data-action="back-to-home" style="display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1; min-width: 0;">
                            <i class="fas fa-chevron-left" style="color: #39d98a;"></i>
                            <h3 style="color: #39d98a; text-shadow: 0 0 6px rgba(57,217,138,0.5); margin: 0;">{{localize 'AGENTOS.Header.contacts'}}</h3>
                        </div>
                        <button type="button" data-action="contacts-add-open" title="{{localize 'AGENTOS.Contacts.Add'}}" style="background: rgba(57,217,138,0.18); border: 1px solid #39d98a; color: #39d98a; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; flex: 0 0 auto;"><i class="fas fa-plus"></i></button>
                    </div>

                    {{#if isGM}}
                    {{!-- GM view: folders per player --}}
                    <div data-preserve-scroll-container="contacts-gm" style="flex:1; overflow-y:auto; padding:10px;">
                        <div class="admin-hint" style="margin-bottom:8px; color:#8a949e;">{{localize 'AGENTOS.Contacts.GMHint'}}</div>
                        {{#each contactFolders}}
                        <div class="contact-folder">
                            <div class="contact-folder-head" data-action="contacts-toggle-folder" data-user-id="{{this.userId}}">
                                <i class="fas fa-{{#if this.open}}folder-open{{else}}folder{{/if}}" style="color:#39d98a;"></i>
                                <span class="contact-folder-name">{{this.userName}}</span>
                                <span class="admin-count-pill">{{this.count}}</span>
                            </div>
                            {{#if this.open}}
                            <div class="contact-folder-body">
                                {{#each this.contacts}}
                                <div class="contact-entry">
                                    <img src="{{this.avatar}}" class="contact-entry-avatar" alt="{{this.name}}">
                                    <div class="contact-entry-info">
                                        <div class="contact-entry-name">{{this.name}}{{#if this.hasLocation}} <i class="fas fa-location-dot" style="color:{{this.color}}; font-size:0.6rem;"></i>{{/if}}</div>
                                        {{#if this.note}}<div class="contact-entry-note">{{this.note}}</div>{{/if}}
                                        {{#if this.address}}<div class="contact-entry-addr"><i class="fas fa-map-marker-alt"></i> {{this.address}}</div>{{/if}}
                                    </div>
                                </div>
                                {{else}}
                                <div class="contact-empty">{{localize 'AGENTOS.Contacts.FolderEmpty'}}</div>
                                {{/each}}
                            </div>
                            {{/if}}
                        </div>
                        {{else}}
                        <div class="contact-empty" style="text-align:center; padding:30px;"><i class="fas fa-address-book" style="font-size:1.5rem; display:block; margin-bottom:8px; color:#39d98a;"></i>{{localize 'AGENTOS.Contacts.NoneGM'}}</div>
                        {{/each}}
                    </div>
                    {{else}}
                    {{!-- Player view: own contacts --}}
                    <div data-preserve-scroll-container="contacts-list" style="flex:1; overflow-y:auto; padding:10px;">
                        {{#each myContacts}}
                        <div class="contact-entry contact-entry--editable">
                            <img src="{{this.avatar}}" class="contact-entry-avatar" alt="{{this.name}}">
                            <div class="contact-entry-info">
                                <div class="contact-entry-name">{{this.name}}{{#if this.hasLocation}} <i class="fas fa-location-dot" style="color:{{this.color}}; font-size:0.6rem;"></i>{{/if}}</div>
                                {{#if this.note}}<div class="contact-entry-note">{{this.note}}</div>{{/if}}
                                {{#if this.address}}<div class="contact-entry-addr"><i class="fas fa-map-marker-alt"></i> {{this.address}}</div>{{/if}}
                            </div>
                            <div class="contact-entry-actions">
                                <button type="button" data-action="contacts-edit-open" data-contact-id="{{this.id}}" title="{{localize 'AGENTOS.Common.Edit'}}" class="contact-mini-btn"><i class="fas fa-pen"></i></button>
                                <button type="button" data-action="contacts-delete" data-contact-id="{{this.id}}" title="{{localize 'AGENTOS.Common.Delete'}}" class="contact-mini-btn contact-mini-btn--danger"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        {{else}}
                        <div class="contact-empty" style="text-align:center; padding:30px;"><i class="fas fa-address-book" style="font-size:1.5rem; display:block; margin-bottom:8px; color:#39d98a;"></i>{{localize 'AGENTOS.Contacts.None'}}</div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- Add / edit contact modal --}}
                    {{#if showContactModal}}
                    <div style="position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.85); z-index:200; display:flex; flex-direction:column; justify-content:center; align-items:center; padding:14px;">
                        <div style="background:#0a0f0c; border:2px solid #39d98a; border-radius:10px; padding:14px; width:94%; max-width:380px; max-height:88%; overflow-y:auto; box-shadow:0 0 30px rgba(57,217,138,0.3);">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                                <div style="font-family:monospace; color:#39d98a; letter-spacing:2px; font-size:0.7rem;">{{#if contactEdit}}{{localize 'AGENTOS.Contacts.EditTitle'}}{{else}}{{localize 'AGENTOS.Contacts.AddTitle'}}{{/if}}</div>
                                <button type="button" data-action="contacts-modal-close" aria-label="Close" style="background:transparent; border:none; color:#888; cursor:pointer; padding:4px; line-height:1; font-size:0.9rem;"><i class="fas fa-times"></i></button>
                            </div>
                            <input type="text" id="contact-modal-name" placeholder="{{localize 'AGENTOS.Contacts.NamePh'}}" value="{{contactEdit.name}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom:8px;">
                            <input type="text" id="contact-modal-note" placeholder="{{localize 'AGENTOS.Contacts.NotePh'}}" value="{{contactEdit.note}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom:8px;">
                            <input type="text" id="contact-modal-address" placeholder="{{localize 'AGENTOS.Contacts.AddrPh'}}" value="{{contactEdit.address}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom:8px;">
                            <label class="admin-label" style="font-size:0.6rem; color:#ccc;">{{localize 'AGENTOS.Contacts.Color'}}</label>
                            <input type="color" id="contact-modal-color" value="{{#if contactEdit.color}}{{contactEdit.color}}{{else}}#39d98a{{/if}}" style="width:100%; height:32px; box-sizing:border-box; background:#111; border:1px solid #444; border-radius:3px; cursor:pointer; margin-bottom:8px;">
                            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; margin-bottom:8px;">
                                <input type="checkbox" id="contact-modal-haslocation" class="agent-checkbox" {{#if contactEdit.hasLocation}}checked{{/if}}>
                                <span class="agent-checkbox-box"><i class="fas fa-check"></i></span>
                                <span style="font-size:0.66rem; color:#c8d2da;">{{localize 'AGENTOS.Contacts.PinOnMap'}}</span>
                            </label>
                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:10px;">
                                <input type="number" id="contact-modal-mapx" placeholder="X %" min="0" max="100" value="{{contactEdit.mapX}}" data-preserve-draft style="background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; box-sizing:border-box;">
                                <input type="number" id="contact-modal-mapy" placeholder="Y %" min="0" max="100" value="{{contactEdit.mapY}}" data-preserve-draft style="background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; box-sizing:border-box;">
                            </div>
                            <div style="display:flex; gap:6px;">
                                <button type="button" data-action="contacts-modal-close" style="flex:1; padding:8px; background:rgba(255,51,85,0.1); border:1px solid #ff3355; color:#ff5577; font-family:monospace; font-size:0.7rem; cursor:pointer; border-radius:4px;">{{localize 'AGENTOS.Common.Cancel'}}</button>
                                <button type="button" data-action="contacts-save" style="flex:1; padding:8px; background:rgba(57,217,138,0.18); border:1px solid #39d98a; color:#39d98a; font-family:monospace; font-size:0.7rem; font-weight:bold; cursor:pointer; border-radius:4px;"><i class="fas fa-save"></i> {{localize 'AGENTOS.Common.Save'}}</button>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                </div>

                {{!-- ════════════════════════════════════════════════════════
                      Patch5.5: NCPD CRIME DATABASE
                      ════════════════════════════════════════════════════════ --}}
                <div id="agent-view-ncpd" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'ncpd')}}flex{{else}}none{{/if}}; height: 100%; position: relative;">
                    {{!-- Patch5.5.3 canon: NCPD blue + Tyger-yellow stripe.
                          Patch5.5.5: GM + button opens add-rap-sheet modal. --}}
                    <div class="app-header" style="background: rgba(58, 134, 255, 0.10); border-bottom: 2px solid #3a86ff; box-shadow: inset 0 -3px 0 0 #f8e800; display: flex; align-items: center; justify-content: space-between;">
                        <div data-action="back-to-home" style="display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1; min-width: 0;">
                            <i class="fas fa-chevron-left" style="color: #3a86ff;"></i>
                            <h3 style="color: #3a86ff; text-shadow: 0 0 6px rgba(58,134,255,0.5); margin: 0;">{{localize 'AGENTOS.Header.ncpd'}}</h3>
                        </div>
                        {{#if isGM}}
                        <button type="button" data-action="ncpd-modal-open" title="File a new rap sheet" style="background: rgba(58,134,255,0.18); border: 1px solid #3a86ff; color: #3a86ff; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; flex: 0 0 auto; display: flex; align-items: center; justify-content: center;"><i class="fas fa-plus"></i></button>
                        {{/if}}
                    </div>
                    {{#if ncpdActiveRecord}}
                    {{!-- Detail view --}}
                    <div data-preserve-scroll-container="ncpd-detail" style="padding: 12px; flex: 1; overflow-y: auto;">
                        <div style="display:flex; gap:8px; margin-bottom:10px; align-items:center;">
                            <button type="button" data-action="ncpd-close-record" style="background: transparent; border: 1px solid #3a86ff; color: #3a86ff; padding: 4px 10px; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-chevron-left"></i> BACK TO LIST</button>
                            {{#if isGM}}
                            <button type="button" data-action="ncpd-edit-record" data-record-id="{{ncpdActiveRecord.id}}" style="background: rgba(58,134,255,0.15); border: 1px solid #3a86ff; color: #3a86ff; padding: 4px 10px; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-pen"></i> {{localize 'AGENTOS.Common.Edit'}}</button>
                            <button type="button" data-action="ncpd-delete-record" data-record-id="{{ncpdActiveRecord.id}}" style="background: rgba(255,51,85,0.12); border: 1px solid #ff3355; color: #ff5577; padding: 4px 10px; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px; margin-left: auto;"><i class="fas fa-trash"></i> {{localize 'AGENTOS.Common.Delete'}}</button>
                            {{/if}}
                        </div>
                        <div style="background: rgba(0,0,0,0.5); border: 1px solid #3a86ff; border-radius: 8px; padding: 12px; display: flex; gap: 12px;">
                            {{!-- Patch5.5.12: mugshot panel on the left, rap-sheet text on the right.
                                  Falls back to a generic mystery-man placeholder if no image is set. --}}
                            <div style="flex: 0 0 90px;">
                                <img src="{{#if ncpdActiveRecord.mugshot}}{{ncpdActiveRecord.mugshot}}{{else}}icons/svg/mystery-man.svg{{/if}}" onerror="this.src='icons/svg/mystery-man.svg'" style="width: 90px; height: 110px; object-fit: cover; border: 1px solid #3a86ff; border-radius: 4px; background: #111; box-shadow: 0 0 8px rgba(58,134,255,0.3);">
                                <div style="font-size: 0.5rem; color: #3a86ff; text-align: center; letter-spacing: 1px; margin-top: 3px; font-family: monospace;">SUBJECT</div>
                            </div>
                            <div style="flex: 1; min-width: 0;">
                            <div style="font-size: 0.55rem; color: #3a86ff; letter-spacing: 2px; margin-bottom: 4px;">RAP SHEET</div>
                            <div style="font-size: 1.1rem; color: #fff; font-weight: bold; margin-bottom: 8px;">{{ncpdActiveRecord.name}}</div>
                            {{#if ncpdActiveRecord.status}}<div style="font-size: 0.65rem; color: #ffcc00; margin-bottom: 8px; padding: 2px 8px; background: rgba(255,204,0,0.1); border: 1px solid #ffcc00; border-radius: 3px; display: inline-block;">{{ncpdActiveRecord.status}}</div>{{/if}}
                            {{#if ncpdActiveRecord.bounty}}<div style="font-size: 0.7rem; color: var(--creds-gold); margin-bottom: 8px;"><i class="fas fa-dollar-sign"></i> BOUNTY: {{ncpdActiveRecord.bounty}}</div>{{/if}}
                            <div style="font-size: 0.55rem; color: #888; letter-spacing: 1px; margin-top: 10px;">CHARGES</div>
                            <div style="font-size: 0.75rem; color: #ddd; margin-bottom: 8px; white-space: pre-wrap;">{{#if ncpdActiveRecord.charges}}{{ncpdActiveRecord.charges}}{{else}}—{{/if}}</div>
                            {{#if ncpdActiveRecord.notes}}
                            <div style="font-size: 0.55rem; color: #888; letter-spacing: 1px; margin-top: 10px;">NOTES</div>
                            <div style="font-size: 0.7rem; color: #aaa; white-space: pre-wrap;">{{ncpdActiveRecord.notes}}</div>
                            {{/if}}
                            </div>
                        </div>
                    </div>
                    {{else}}
                    {{!-- List view --}}
                    <div style="padding: 10px; background: rgba(0,0,0,0.3); border-bottom: 1px solid #222;">
                        <input type="text" data-action="ncpd-search" placeholder="Search names, charges, notes..." value="{{ncpdSearch}}" data-preserve-draft style="width: 100%; box-sizing: border-box; background: #111; color: #fff; border: 1px solid #444; padding: 8px; border-radius: 3px; font-family: monospace; font-size: 0.75rem;">
                    </div>
                    <div data-preserve-scroll-container="ncpd-list" style="flex: 1; overflow-y: auto; padding: 10px;">
                        {{#each ncpdRapSheetsView}}
                        <div data-action="ncpd-open-record" data-record-id="{{this.id}}" style="padding: 10px; margin-bottom: 8px; background: rgba(58,134,255,0.08); border-left: 3px solid #3a86ff; border-radius: 4px; cursor: pointer; display: flex; gap: 10px; align-items: center;">
                            {{!-- Patch5.5.12: thumb mugshot. Falls back to mystery-man if unset. --}}
                            <img src="{{#if this.mugshot}}{{this.mugshot}}{{else}}icons/svg/mystery-man.svg{{/if}}" onerror="this.src='icons/svg/mystery-man.svg'" style="flex: 0 0 36px; width: 36px; height: 44px; object-fit: cover; border: 1px solid #3a86ff; border-radius: 3px; background: #000;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <strong style="color: #fff;">{{this.name}}</strong>
                                    {{#if this.bounty}}<span style="color: var(--creds-gold); font-size: 0.7rem;">{{this.bounty}}</span>{{/if}}
                                </div>
                                {{#if this.charges}}<div style="font-size: 0.65rem; color: #aaa; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{this.charges}}</div>{{/if}}
                            </div>
                            {{#if ../isGM}}
                            <button type="button" data-action="ncpd-delete-record" data-record-id="{{this.id}}" title="{{localize 'AGENTOS.Common.Delete'}}" style="flex:0 0 auto; background: rgba(255,51,85,0.12); border:1px solid #ff3355; color:#ff5577; width:28px; height:28px; border-radius:5px; cursor:pointer;"><i class="fas fa-trash" style="font-size:0.7rem;"></i></button>
                            {{/if}}
                        </div>
                        {{else}}
                        <div style="text-align: center; padding: 30px; color: #666; font-size: 0.75rem;"><i class="fas fa-fingerprint" style="font-size: 1.5rem; margin-bottom: 8px; display: block; color: #3a86ff;"></i>{{#if ncpdSearch}}No matching records.{{else}}No rap sheets on file.{{#if isGM}} Tap + to file one.{{/if}}{{/if}}</div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- Patch5.5.5: NCPD file-rap-sheet modal --}}
                    {{#if showNcpdAddModal}}
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 200; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 14px;">
                        <div style="background: #0a0a0f; border: 2px solid #3a86ff; border-radius: 10px; padding: 14px; width: 94%; max-width: 380px; box-shadow: 0 0 30px rgba(58,134,255,0.3);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                <div style="font-family: monospace; color: #3a86ff; letter-spacing: 2px; font-size: 0.7rem;">{{#if ncpdEditRecord}}EDIT RAP SHEET{{else}}FILE RAP SHEET{{/if}}</div>
                                <button type="button" data-action="ncpd-modal-close" aria-label="Close" style="background: transparent; border: none; color: #888; cursor: pointer; padding: 4px; line-height: 1; font-size: 0.9rem;"><i class="fas fa-times"></i></button>
                            </div>
                            <input type="text" id="ncpd-modal-name" placeholder="Name *" value="{{ncpdEditRecord.name}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom:8px;">
                            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px; margin-bottom: 8px;">
                                <input type="text" id="ncpd-modal-status" placeholder="Status (Wanted / KIA…)" value="{{ncpdEditRecord.status}}" data-preserve-draft style="background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; box-sizing:border-box;">
                                <input type="text" id="ncpd-modal-bounty" placeholder="Bounty (5,000eb)" value="{{ncpdEditRecord.bounty}}" data-preserve-draft style="background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; box-sizing:border-box;">
                            </div>
                            <input type="text" id="ncpd-modal-charges" placeholder="Charges (comma-separated)" value="{{ncpdEditRecord.charges}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px;">
                            <textarea id="ncpd-modal-notes" rows="3" placeholder="Notes (priors, MO, last known location…)" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px; resize:none;">{{ncpdEditRecord.notes}}</textarea>
                            {{!-- Patch5.5.12: optional mugshot image path. Browse button uses Foundry FilePicker. --}}
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Mugshot (optional)</label>
                            <div style="display: grid; grid-template-columns: 1fr auto; gap: 4px; align-items: stretch; margin-bottom: 12px; min-width: 0;">
                                <input type="text" id="ncpd-modal-mugshot" placeholder="Image path (optional)" value="{{ncpdEditRecord.mugshot}}" data-preserve-draft style="min-width: 0; width: 100%; box-sizing: border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.7rem;">
                                <button type="button" class="pick-ncpd-mugshot" title="Browse for mugshot image" style="background: rgba(58,134,255,0.18); border: 1px solid #3a86ff; color: #3a86ff; padding: 6px 12px; border-radius: 3px; cursor: pointer; white-space: nowrap;"><i class="fas fa-folder-open"></i></button>
                            </div>
                            <div style="display: flex; gap: 6px;">
                                <button type="button" data-action="ncpd-modal-close" style="flex:1; padding:8px; background:rgba(255,51,85,0.1); border:1px solid #ff3355; color:#ff3355; font-family:monospace; font-size:0.7rem; cursor:pointer; border-radius:4px;">CANCEL</button>
                                <button type="button" data-action="ncpd-add-record" style="flex:1; padding:8px; background:rgba(58,134,255,0.18); border:1px solid #3a86ff; color:#3a86ff; font-family:monospace; font-size:0.7rem; font-weight:bold; cursor:pointer; border-radius:4px;"><i class="fas fa-{{#if ncpdEditRecord}}save{{else}}fingerprint{{/if}}"></i> {{#if ncpdEditRecord}}{{localize 'AGENTOS.Common.Save'}}{{else}}FILE{{/if}}</button>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                </div>

                {{!-- ════════════════════════════════════════════════════════
                      Patch5.5: ZIGGURAT CITY DATABASE
                      ════════════════════════════════════════════════════════ --}}
                <div id="agent-view-ziggurat" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'ziggurat')}}flex{{else}}none{{/if}}; height: 100%; position: relative;">
                    {{!-- Patch5.5.3 canon: deeper Arasaka-tower violet. Patch5.5.5: GM + button. --}}
                    <div class="app-header" style="background: linear-gradient(180deg, rgba(124,77,255,0.18) 0%, rgba(124,77,255,0.04) 100%); border-bottom: 2px solid #7c4dff; display: flex; align-items: center; justify-content: space-between;">
                        <div data-action="back-to-home" style="display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1; min-width: 0;">
                            <i class="fas fa-chevron-left" style="color: #b599ff;"></i>
                            <h3 style="color: #b599ff; text-shadow: 0 0 8px rgba(124,77,255,0.6); margin: 0;">{{localize 'AGENTOS.Header.ziggurat'}}</h3>
                        </div>
                        {{#if isGM}}
                        <button type="button" data-action="ziggurat-modal-open" title="Add a city listing" style="background: rgba(124,77,255,0.22); border: 1px solid #7c4dff; color: #b599ff; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; flex: 0 0 auto; display: flex; align-items: center; justify-content: center;"><i class="fas fa-plus"></i></button>
                        {{/if}}
                    </div>
                    <div style="padding: 10px; background: rgba(0,0,0,0.3); border-bottom: 1px solid #222;">
                        <input type="text" data-action="ziggurat-search" placeholder="Search venues, fixers, addresses..." value="{{zigguratSearch}}" data-preserve-draft style="width: 100%; box-sizing: border-box; background: #111; color: #fff; border: 1px solid #444; padding: 8px; border-radius: 3px; font-family: monospace; font-size: 0.75rem;">
                    </div>
                    <div style="display: flex; gap: 4px; padding: 6px 8px; overflow-x: auto; background: rgba(0,0,0,0.2); border-bottom: 1px solid #222; flex-shrink: 0;">
                        {{#each zigguratCategories}}
                        <button type="button" data-action="ziggurat-set-category" data-category="{{this}}" style="cursor: pointer; padding: 4px 10px; background: {{#if (eq this ../zigguratCategory)}}rgba(124,77,255,0.22){{else}}rgba(255,255,255,0.04){{/if}}; border: 1px solid {{#if (eq this ../zigguratCategory)}}#aa88ff{{else}}#444{{/if}}; color: {{#if (eq this ../zigguratCategory)}}#aa88ff{{else}}#aaa{{/if}}; font-family: monospace; font-size: 0.62rem; border-radius: 3px; white-space: nowrap;">{{this}}</button>
                        {{/each}}
                    </div>
                    <div data-preserve-scroll-container="ziggurat-list" style="flex: 1; overflow-y: auto; padding: 10px;">
                        {{#each cityDirectoryView}}
                        <div style="padding: 10px; margin-bottom: 8px; background: rgba(124,77,255,0.06); border-left: 3px solid #7c4dff; border-radius: 4px; display: flex; gap: 10px; align-items: flex-start;">
                            {{!-- Patch5.5.12: venue image thumbnail. Always renders for consistent row heights;
                                  uses mystery-man fallback when no image is set or the path 404s. --}}
                            <img src="{{#if this.image}}{{this.image}}{{else}}icons/svg/mystery-man.svg{{/if}}" onerror="this.src='icons/svg/mystery-man.svg'" style="flex: 0 0 44px; width: 44px; height: 44px; object-fit: cover; border: 1px solid #7c4dff; border-radius: 4px; background: #000;">
                            <div style="flex: 1; min-width: 0;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <strong style="color: #fff;">{{this.name}}</strong>
                                <span style="font-size: 0.55rem; color: #b599ff; letter-spacing: 1px;">{{this.category}}</span>
                            </div>
                            {{#if this.address}}<div style="font-size: 0.65rem; color: #aaa; margin-top: 4px;"><i class="fas fa-location-dot"></i> {{this.address}}</div>{{/if}}
                            {{#if this.hours}}<div style="font-size: 0.6rem; color: #888; margin-top: 2px;"><i class="far fa-clock"></i> {{this.hours}}</div>{{/if}}
                            {{#if this.notes}}<div style="font-size: 0.7rem; color: #ddd; margin-top: 6px; white-space: pre-wrap;">{{this.notes}}</div>{{/if}}
                            </div>
                            {{#if ../isGM}}
                            <div style="display:flex; flex-direction:column; gap:4px; flex:0 0 auto;">
                                <button type="button" data-action="ziggurat-edit-entry-open" data-entry-id="{{this.id}}" title="{{localize 'AGENTOS.Common.Edit'}}" style="background: rgba(124,77,255,0.18); border:1px solid #7c4dff; color:#b599ff; width:26px; height:26px; border-radius:4px; cursor:pointer;"><i class="fas fa-pen" style="font-size:0.65rem;"></i></button>
                                <button type="button" data-action="ziggurat-delete-entry" data-entry-id="{{this.id}}" title="{{localize 'AGENTOS.Common.Delete'}}" style="background: rgba(255,51,85,0.12); border:1px solid #ff3355; color:#ff3355; width:26px; height:26px; border-radius:4px; cursor:pointer;"><i class="fas fa-trash" style="font-size:0.65rem;"></i></button>
                            </div>
                            {{/if}}
                        </div>
                        {{else}}
                        <div style="text-align: center; padding: 30px; color: #666; font-size: 0.75rem;"><i class="fas fa-city" style="font-size: 1.5rem; margin-bottom: 8px; display: block; color: #b599ff;"></i>{{#if (eq zigguratCategory "All")}}{{#if zigguratSearch}}No matching listings.{{else}}No city listings yet.{{#if isGM}} Tap + to add one.{{/if}}{{/if}}{{else}}No {{zigguratCategory}} listings yet.{{/if}}</div>
                        {{/each}}
                    </div>

                    {{!-- Patch5.5.5: Ziggurat add-listing modal --}}
                    {{#if showZigguratAddModal}}
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 200; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 14px;">
                        <div style="background: #0a0a0f; border: 2px solid #7c4dff; border-radius: 10px; padding: 14px; width: 94%; max-width: 380px; box-shadow: 0 0 30px rgba(124,77,255,0.35);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                <div style="font-family: monospace; color: #b599ff; letter-spacing: 2px; font-size: 0.7rem;">{{#if zigguratEditEntry}}EDIT CITY LISTING{{else}}ADD CITY LISTING{{/if}}</div>
                                <button type="button" data-action="ziggurat-modal-close" aria-label="Close" style="background: transparent; border: none; color: #888; cursor: pointer; padding: 4px; line-height: 1; font-size: 0.9rem;"><i class="fas fa-times"></i></button>
                            </div>
                            <input type="text" id="ziggurat-modal-name" placeholder="Name *" value="{{zigguratEditEntry.name}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px;">
                            <select id="ziggurat-modal-category" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px;">
                                <option value="Venue" {{#if (eq zigguratEditEntry.category 'Venue')}}selected{{/if}}>Venue</option>
                                <option value="Fixer" {{#if (eq zigguratEditEntry.category 'Fixer')}}selected{{/if}}>Fixer</option>
                                <option value="Ripperdoc" {{#if (eq zigguratEditEntry.category 'Ripperdoc')}}selected{{/if}}>Ripperdoc</option>
                                <option value="Vendor" {{#if (eq zigguratEditEntry.category 'Vendor')}}selected{{/if}}>Vendor</option>
                                <option value="Safehouse" {{#if (eq zigguratEditEntry.category 'Safehouse')}}selected{{/if}}>Safehouse</option>
                                <option value="Gang Turf" {{#if (eq zigguratEditEntry.category 'Gang Turf')}}selected{{/if}}>Gang Turf</option>
                                <option value="Corp" {{#if (eq zigguratEditEntry.category 'Corp')}}selected{{/if}}>Corp</option>
                                <option value="Other" {{#if (eq zigguratEditEntry.category 'Other')}}selected{{/if}}>Other</option>
                            </select>
                            <input type="text" id="ziggurat-modal-address" placeholder="Address / district" value="{{zigguratEditEntry.address}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px;">
                            <input type="text" id="ziggurat-modal-hours" placeholder="Hours (e.g. 22:00 – 04:00)" value="{{zigguratEditEntry.hours}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px;">
                            <textarea id="ziggurat-modal-notes" rows="3" placeholder="Notes" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px; resize:none;">{{zigguratEditEntry.notes}}</textarea>
                            {{!-- Patch5.5.12: optional venue/fixer image — renders next to the listing in the detail card. --}}
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Image (optional)</label>
                            <div style="display: grid; grid-template-columns: 1fr auto; gap: 4px; align-items: stretch; margin-bottom: 12px; min-width: 0;">
                                <input type="text" id="ziggurat-modal-image" placeholder="Image path (optional)" value="{{zigguratEditEntry.image}}" data-preserve-draft style="min-width: 0; width: 100%; box-sizing: border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.7rem;">
                                <button type="button" class="pick-ziggurat-image" title="Browse for image (Forge-compatible)" style="background: rgba(124,77,255,0.22); border: 1px solid #7c4dff; color: #b599ff; padding: 6px 12px; border-radius: 3px; cursor: pointer; white-space: nowrap;"><i class="fas fa-folder-open"></i></button>
                            </div>
                            <div style="display: flex; gap: 6px;">
                                <button type="button" data-action="ziggurat-modal-close" style="flex:1; padding:8px; background:rgba(255,51,85,0.1); border:1px solid #ff3355; color:#ff3355; font-family:monospace; font-size:0.7rem; cursor:pointer; border-radius:4px;">CANCEL</button>
                                <button type="button" data-action="ziggurat-add-entry" style="flex:1; padding:8px; background:rgba(124,77,255,0.22); border:1px solid #7c4dff; color:#b599ff; font-family:monospace; font-size:0.7rem; font-weight:bold; cursor:pointer; border-radius:4px;"><i class="fas fa-{{#if zigguratEditEntry}}save{{else}}plus{{/if}}"></i> {{#if zigguratEditEntry}}{{localize 'AGENTOS.Common.Save'}}{{else}}ADD{{/if}}</button>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                </div>

                {{!-- ════════════════════════════════════════════════════════
                      Patch5.5: THE GARDEN (dating)
                      ════════════════════════════════════════════════════════ --}}
                <div id="agent-view-garden" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'garden')}}flex{{else}}none{{/if}}; height: 100%; position: relative;">
                    {{!-- Patch5.5.3 canon: Cyberpunk neon magenta. Patch5.5.5: GM + button. --}}
                    <div class="app-header" style="background: rgba(255, 20, 147, 0.10); border-bottom: 2px solid #ff1493; box-shadow: inset 0 0 12px rgba(255, 20, 147, 0.15); display: flex; align-items: center; justify-content: space-between;">
                        <div data-action="back-to-home" style="display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1; min-width: 0;">
                            <i class="fas fa-chevron-left" style="color: #ff1493;"></i>
                            <h3 style="color: #ff1493; text-shadow: 0 0 6px rgba(255,20,147,0.5); margin: 0;">{{localize 'AGENTOS.Header.garden'}}</h3>
                        </div>
                        {{#if isGM}}
                        <button type="button" data-action="garden-modal-open" title="Add a Garden profile" style="background: rgba(255,20,147,0.18); border: 1px solid #ff1493; color: #ff1493; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; flex: 0 0 auto; display: flex; align-items: center; justify-content: center;"><i class="fas fa-plus"></i></button>
                        {{/if}}
                    </div>
                    {{#if gardenActiveProfile}}
                    <div data-preserve-scroll-container="garden-detail" style="padding: 12px; flex: 1; overflow-y: auto;">
                        <div style="display:flex; gap:8px; margin-bottom:10px; align-items:center;">
                            <button type="button" data-action="garden-close-profile" style="background: transparent; border: 1px solid #ff1493; color: #ff1493; padding: 4px 10px; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-chevron-left"></i> BACK TO MATCHES</button>
                            {{#if isGM}}
                            <button type="button" data-action="garden-edit-profile-open" data-profile-id="{{gardenActiveProfile.id}}" style="background: rgba(255,20,147,0.15); border: 1px solid #ff1493; color: #ff1493; padding: 4px 10px; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px;"><i class="fas fa-pen"></i> {{localize 'AGENTOS.Common.Edit'}}</button>
                            <button type="button" data-action="garden-delete-profile" data-profile-id="{{gardenActiveProfile.id}}" style="background: rgba(255,51,85,0.12); border: 1px solid #ff3355; color: #ff5577; padding: 4px 10px; font-family: monospace; font-size: 0.65rem; cursor: pointer; border-radius: 3px; margin-left: auto;"><i class="fas fa-trash"></i> {{localize 'AGENTOS.Common.Delete'}}</button>
                            {{/if}}
                        </div>
                        <div style="background: rgba(0,0,0,0.5); border: 1px solid #ff1493; border-radius: 12px; padding: 14px; text-align: center;">
                            <img src="{{#if gardenActiveProfile.photo}}{{gardenActiveProfile.photo}}{{else}}icons/svg/mystery-man.svg{{/if}}" onerror="this.src='icons/svg/mystery-man.svg'" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 2px solid #ff1493; box-shadow: 0 0 12px rgba(255,20,147,0.45); margin: 0 auto 10px auto; display: block; background: #222;">
                            <div style="font-size: 1.2rem; color: #fff; font-weight: bold;">{{gardenActiveProfile.name}}{{#if gardenActiveProfile.age}}<span style="color: #ff1493;">, {{gardenActiveProfile.age}}</span>{{/if}}</div>
                            {{#if gardenActiveProfile.availability}}<div style="font-size: 0.6rem; color: #ff1493; letter-spacing: 1px; margin-top: 4px;">{{gardenActiveProfile.availability}}</div>{{/if}}
                            {{#if gardenActiveProfile.bio}}<div style="font-size: 0.8rem; color: #ddd; margin-top: 12px; text-align: left; white-space: pre-wrap;">{{gardenActiveProfile.bio}}</div>{{/if}}
                            {{#if gardenActiveProfile.interests}}<div style="font-size: 0.65rem; color: #aaa; margin-top: 10px; text-align: left;"><strong style="color: #ff1493;">Interests:</strong> {{gardenActiveProfile.interests}}</div>{{/if}}
                            <button type="button" data-action="garden-message-profile" data-profile-id="{{gardenActiveProfile.id}}" style="margin-top: 14px; background: rgba(255,20,147,0.22); color: #ff1493; border: 1px solid #ff1493; padding: 8px 16px; font-family: monospace; font-weight: bold; cursor: pointer; border-radius: 4px;"><i class="fas fa-comment-dots"></i> MESSAGE</button>
                        </div>
                    </div>
                    {{else}}
                    <div data-preserve-scroll-container="garden-list" style="flex: 1; overflow-y: auto; padding: 10px;">
                        {{#each gardenProfilesView}}
                        <div data-action="garden-open-profile" data-profile-id="{{this.id}}" style="padding: 10px; margin-bottom: 8px; background: rgba(255,20,147,0.08); border: 1px solid #ff1493; border-radius: 8px; cursor: pointer; display: flex; gap: 10px; align-items: center;">
                            <img src="{{#if this.photo}}{{this.photo}}{{else}}icons/svg/mystery-man.svg{{/if}}" onerror="this.src='icons/svg/mystery-man.svg'" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 1px solid #ff1493; flex-shrink: 0; background: #222;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="color: #fff; font-weight: bold;">{{this.name}}{{#if this.age}}<span style="color: #ff1493;">, {{this.age}}</span>{{/if}}</div>
                                {{#if this.bio}}<div style="font-size: 0.65rem; color: #aaa; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{this.bio}}</div>{{/if}}
                            </div>
                            {{#if ../isGM}}
                            <button type="button" data-action="garden-delete-profile" data-profile-id="{{this.id}}" title="{{localize 'AGENTOS.Common.Delete'}}" style="flex:0 0 auto; background: rgba(255,51,85,0.12); border:1px solid #ff3355; color:#ff5577; width:28px; height:28px; border-radius:50%; cursor:pointer;"><i class="fas fa-trash" style="font-size:0.7rem;"></i></button>
                            {{/if}}
                        </div>
                        {{else}}
                        <div style="text-align: center; padding: 30px; color: #666; font-size: 0.75rem;"><i class="fas fa-seedling" style="font-size: 1.5rem; margin-bottom: 8px; display: block; color: #ff1493;"></i>{{#if isGM}}No Garden profiles yet. Tap + to plant one.{{else}}No matches yet. Check back when the Garden surfaces more profiles.{{/if}}</div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- Patch5.5.5: Garden add-profile modal --}}
                    {{#if showGardenAddModal}}
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 200; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 14px;">
                        <div style="background: #0a0a0f; border: 2px solid #ff1493; border-radius: 10px; padding: 14px; width: 94%; max-width: 380px; max-height: 86%; overflow-y: auto; box-shadow: 0 0 30px rgba(255,20,147,0.3);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                <div style="font-family: monospace; color: #ff1493; letter-spacing: 2px; font-size: 0.7rem;">{{#if gardenEditProfile}}EDIT GARDEN PROFILE{{else}}ADD GARDEN PROFILE{{/if}}</div>
                                <button type="button" data-action="garden-modal-close" aria-label="Close" style="background: transparent; border: none; color: #888; cursor: pointer; padding: 4px; line-height: 1; font-size: 0.9rem;"><i class="fas fa-times"></i></button>
                            </div>
                            <div style="display:grid; grid-template-columns: 2fr 1fr; gap:6px; margin-bottom: 8px;">
                                <input type="text" id="garden-modal-name" placeholder="Display name *" value="{{gardenEditProfile.name}}" data-preserve-draft style="background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; box-sizing:border-box;">
                                <input type="text" id="garden-modal-age" placeholder="Age" value="{{gardenEditProfile.age}}" data-preserve-draft style="background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; box-sizing:border-box;">
                            </div>
                            <input type="text" id="garden-modal-availability" placeholder="Availability (Active / Off / Hidden)" value="{{gardenEditProfile.availability}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px;">
                            <label class="admin-label" style="font-size: 0.6rem; color: #ccc;">Photo (optional)</label>
                            <div style="display: grid; grid-template-columns: 1fr auto; gap: 4px; align-items: stretch; margin-bottom: 8px; min-width: 0;">
                                <input type="text" id="garden-modal-photo" placeholder="Image path (optional)" value="{{gardenEditProfile.photo}}" data-preserve-draft style="min-width: 0; width: 100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem;">
                                <button type="button" class="pick-garden-photo" title="Browse for photo (Forge-compatible)" style="background: rgba(255,20,147,0.18); border: 1px solid #ff1493; color: #ff1493; padding: 6px 12px; border-radius: 3px; cursor: pointer; white-space: nowrap;"><i class="fas fa-folder-open"></i></button>
                            </div>
                            <textarea id="garden-modal-bio" rows="3" placeholder="Bio" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 8px; resize:none;">{{gardenEditProfile.bio}}</textarea>
                            <input type="text" id="garden-modal-interests" placeholder="Interests (comma-separated)" value="{{gardenEditProfile.interests}}" data-preserve-draft style="width:100%; box-sizing:border-box; background:#111; color:#fff; border:1px solid #444; padding:7px 10px; border-radius:3px; font-family:monospace; font-size:0.72rem; margin-bottom: 10px;">
                            <div style="display: flex; gap: 6px;">
                                <button type="button" data-action="garden-modal-close" style="flex:1; padding:8px; background:rgba(255,51,85,0.1); border:1px solid #ff3355; color:#ff3355; font-family:monospace; font-size:0.7rem; cursor:pointer; border-radius:4px;">CANCEL</button>
                                <button type="button" data-action="garden-add-profile" style="flex:1; padding:8px; background:rgba(255,20,147,0.18); border:1px solid #ff1493; color:#ff1493; font-family:monospace; font-size:0.7rem; font-weight:bold; cursor:pointer; border-radius:4px;"><i class="fas fa-{{#if gardenEditProfile}}save{{else}}seedling{{/if}}"></i> {{#if gardenEditProfile}}{{localize 'AGENTOS.Common.Save'}}{{else}}ADD{{/if}}</button>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                </div>

                <!-- AUCTION HOUSE VIEW -->
                <div id="agent-view-auction" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'auction')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" style="justify-content: space-between;">
                        <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" data-action="{{#if (eq auctionView 'detail')}}auction-back-to-list{{else}}back-to-home{{/if}}">
                            <i class="fas fa-chevron-left" style="color: #ff6e40;"></i>
                            <h3>{{#if (eq auctionView 'detail')}}Auction Detail{{else}}Black Market // Auctions{{/if}}</h3>
                        </span>
                    </div>
                    <div class="auction-view" style="padding: 12px; flex: 1; overflow-y: auto; overflow-x: hidden;">
                        {{#if (eq auctionView 'list')}}
                            {{#if isGM}}
                            <div class="auction-create-form" style="padding: 10px; background: rgba(255,110,64,0.06); border: 1px solid rgba(255,110,64,0.3); border-radius: 8px; margin-bottom: 12px; box-sizing: border-box; width: 100%;">
                                <div style="font-size: 0.55rem; color: #ff6e40; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 1px;">Post New Listing</div>
                                <input type="text" id="auction-item-name" class="auction-input auction-input-full" placeholder="Item name" data-preserve-draft>
                                <input type="text" id="auction-item-desc" class="auction-input auction-input-full" placeholder="Description (optional)" data-preserve-draft>
                                <div style="display: flex; gap: 4px; align-items: center; width: 100%; box-sizing: border-box; margin-bottom: 4px;">
                                    <input type="number" id="auction-start-bid" class="auction-input" placeholder="eb" value="100" min="1" style="flex: 1 1 50px; min-width: 40px;">
                                    <span style="font-size: 0.5rem; color: #888; white-space: nowrap;">eb</span>
                                </div>
                                <div style="display: flex; gap: 4px; align-items: center; width: 100%; box-sizing: border-box;">
                                    <input type="number" id="auction-duration-hrs" class="auction-input" placeholder="H" value="0" min="0" max="168" style="flex: 0 0 36px; min-width: 32px; text-align: center;">
                                    <span style="font-size: 0.5rem; color: #888;">h</span>
                                    <input type="number" id="auction-duration-min" class="auction-input" placeholder="M" value="30" min="0" max="59" style="flex: 0 0 36px; min-width: 32px; text-align: center;">
                                    <span style="font-size: 0.5rem; color: #888;">m</span>
                                    <button type="button" data-action="auction-create" class="auction-list-btn" style="flex: 1 0 auto; white-space: nowrap;">
                                        <i class="fas fa-gavel"></i> LIST
                                    </button>
                                </div>
                            </div>
                            {{/if}}

                            {{#if auctionListings.length}}
                                {{#each auctionListings}}
                                {{#unless this.settled}}
                                <div class="auction-card" data-action="auction-view-detail" data-auction-id="{{this.id}}" style="cursor: pointer; padding: 10px; background: rgba(255,110,64,0.04); border: 1px solid #333; border-radius: 8px; margin-bottom: 8px; transition: border-color 0.2s;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                        <div style="flex: 1; min-width: 0;">
                                            <div style="font-size: 0.8rem; color: #fff; font-weight: 600;">{{this.name}}</div>
                                            {{#if this.description}}<div style="font-size: 0.6rem; color: #aaa; margin-top: 2px;">{{this.description}}</div>{{/if}}
                                        </div>
                                        <div style="text-align: right; flex-shrink: 0;">
                                            <div style="font-size: 0.85rem; color: var(--creds-gold); font-weight: 700;">{{this.currentBid}}<span style="font-size: 0.55rem;">eb</span></div>
                                            <div style="font-size: 0.5rem; color: {{#if this.expired}}#ff3333{{else}}#ff6e40{{/if}};">{{this.timeLeft}}</div>
                                        </div>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 0.5rem; color: #666;">
                                        <span>{{this.bidCount}} bid{{#unless (eq this.bidCount 1)}}s{{/unless}}</span>
                                        {{#if this.isHighBidder}}<span style="color: #44ff44;">YOU'RE LEADING</span>{{/if}}
                                        {{#if this.highBidderName}}<span>High: {{this.highBidderName}}</span>{{/if}}
                                    </div>
                                </div>
                                {{/unless}}
                                {{/each}}
                            {{else}}
                                <div style="text-align: center; padding: 30px; color: #666; font-size: 0.75rem;">
                                    <i class="fas fa-gavel" style="font-size: 1.5rem; margin-bottom: 8px; display: block; color: #ff6e40;"></i>
                                    No active listings. Check back later, choom.
                                </div>
                            {{/if}}
                        {{else}}
                            <!-- AUCTION DETAIL VIEW -->
                            {{#if auctionDetail}}
                            <div class="auction-detail-card" style="padding: 14px; background: rgba(255,110,64,0.06); border: 1px solid rgba(255,110,64,0.3); border-radius: 8px; margin-bottom: 12px; box-sizing: border-box; max-width: 100%;">
                                <div style="font-size: 1rem; color: #fff; font-weight: 700; margin-bottom: 4px;">{{auctionDetail.name}}</div>
                                {{#if auctionDetail.description}}<div style="font-size: 0.7rem; color: #aaa; margin-bottom: 10px;">{{auctionDetail.description}}</div>{{/if}}
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div>
                                        <div style="font-size: 0.5rem; color: #ff6e40; text-transform: uppercase;">Current Bid</div>
                                        <div style="font-size: 1.5rem; color: var(--creds-gold); font-weight: 800;">{{auctionDetail.currentBid}}<span style="font-size: 0.7rem;">eb</span></div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 0.5rem; color: #ff6e40; text-transform: uppercase;">Time Left</div>
                                        <div style="font-size: 1rem; color: {{#if auctionDetail.expired}}#ff3333{{else}}#fff{{/if}}; font-weight: 600;">{{auctionDetail.timeLeft}}</div>
                                    </div>
                                </div>
                                <div style="font-size: 0.6rem; color: #888; margin-bottom: 8px;">
                                    {{auctionDetail.bidCount}} bid{{#unless (eq auctionDetail.bidCount 1)}}s{{/unless}}
                                    {{#if auctionDetail.highBidderName}} — Leading: <span style="color: #64ffda;">{{auctionDetail.highBidderName}}</span>{{/if}}
                                    {{#if auctionDetail.isHighBidder}} <span style="color: #44ff44;">(YOU)</span>{{/if}}
                                </div>

                                {{#unless auctionDetail.expired}}
                                {{#unless auctionDetail.settled}}
                                {{!-- Patch4 round 6: bid amount input was being
                                      crushed to ~10px on the phone because BID +
                                      NPC buttons together ate the row. Split
                                      into two rows — input + BID share the
                                      main row; NPC (GM-only) sits underneath
                                      on its own line so it can't squeeze the
                                      input out of legibility. --}}
                                <div style="display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important; gap: 4px; margin-top: 8px; align-items: center; width: 100%; min-width: 0; box-sizing: border-box;">
                                    <input type="number" id="auction-bid-amount" class="auction-input" placeholder="+eb" value="10" min="1" style="flex: 1 1 0 !important; min-width: 80px !important; width: auto !important;" data-preserve-draft>
                                    <button type="button" data-action="auction-place-bid" data-auction-id="{{auctionDetail.id}}" class="auction-list-btn" style="font-weight: 700; flex: 0 0 auto !important; width: auto !important; white-space: nowrap; padding: 6px 14px !important;">
                                        <i class="fas fa-gavel"></i> BID
                                    </button>
                                </div>
                                {{#if isGM}}
                                <div style="display: flex; gap: 4px; margin-top: 4px; width: 100%; box-sizing: border-box;">
                                    <button type="button" data-action="auction-place-npc-bid" data-auction-id="{{auctionDetail.id}}" class="auction-list-btn" title="Record a bid from an off-screen NPC (fixer, rival corp, etc.) — GM only" style="font-weight: 700; flex: 1 1 0 !important; width: auto !important; white-space: nowrap; background: rgba(255,153,0,0.12); border-color: #ff9900; color: #ff9900; padding: 5px 8px !important; font-size: 0.62rem;">
                                        <i class="fas fa-user-secret"></i> NPC BID (GM)
                                    </button>
                                </div>
                                {{/if}}
                                {{/unless}}
                                {{/unless}}

                                {{#if isGM}}
                                <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 10px; padding-top: 8px; border-top: 1px solid #333;">
                                    {{#unless auctionDetail.expired}}
                                    <button type="button" data-action="auction-end-now" data-auction-id="{{auctionDetail.id}}" style="flex: 1 1 45%; padding: 6px; background: rgba(255,204,0,0.1); border: 1px solid #ffcc00; color: #ffcc00; font-family: monospace; font-size: 0.6rem; cursor: pointer; border-radius: 4px; box-sizing: border-box;">
                                        <i class="fas fa-hourglass-end"></i> END NOW
                                    </button>
                                    {{/unless}}
                                    {{#if auctionDetail.expired}}
                                    <button type="button" data-action="auction-settle" data-auction-id="{{auctionDetail.id}}" style="flex: 1 1 45%; padding: 6px; background: rgba(68,255,68,0.1); border: 1px solid #44ff44; color: #44ff44; font-family: monospace; font-size: 0.6rem; cursor: pointer; border-radius: 4px; box-sizing: border-box;">
                                        <i class="fas fa-check"></i> SETTLE
                                    </button>
                                    {{/if}}
                                    <button type="button" data-action="auction-cancel" data-auction-id="{{auctionDetail.id}}" style="flex: 1 1 45%; padding: 6px; background: rgba(255,50,50,0.1); border: 1px solid #ff3333; color: #ff3333; font-family: monospace; font-size: 0.6rem; cursor: pointer; border-radius: 4px; box-sizing: border-box;">
                                        <i class="fas fa-times"></i> REMOVE
                                    </button>
                                </div>
                                {{/if}}
                            </div>
                            {{else}}
                                <div style="text-align: center; padding: 20px; color: #666;">Listing not found.</div>
                            {{/if}}
                        {{/if}}
                    </div>
                </div>

                <!-- GM ADMIN VIEW -->
                <div id="agent-view-admin" class="agent-app-view agent-view" style="display: {{#if (eq currentView 'admin')}}flex{{else}}none{{/if}}; height: 100%;">
                    <div class="app-header" data-action="back-to-home">
                        <i class="fas fa-chevron-left" style="color: #ff00ff;"></i>
                        <h3>{{localize 'AGENTOS.Header.admin'}}</h3>
                    </div>
                    <div class="admin-console">
                        {{!-- Patch4 round 2: per-player tabs moved INTO the
                              Application Access section below (folder-tab
                              style above the app-lock frame). They scope ONLY
                              app-lock toggles — they don't change the GM's
                              identity, wallet view, or any other admin context. --}}

                        <!-- SECTION: VISUAL -->
                        <div class="admin-section">
                            <div class="admin-section-title">Visual</div>
                            <div class="admin-row">
                                <div class="admin-row-info">
                                    <div class="admin-row-label">UI Skin</div>
                                    <div class="admin-row-meta">Applied to every player. Current: <span style="color: {{#if (eq uiSkin '2077')}}#ffcc00{{else}}#ff003c{{/if}}; font-weight: bold;">{{#if (eq uiSkin '2077')}}2077{{else}}RED{{/if}}</span></div>
                                </div>
                                <button type="button" class="admin-btn admin-btn-{{#if (eq uiSkin '2077')}}gold{{else}}red{{/if}}" data-action="toggle-ui-skin">
                                    <i class="fas fa-exchange-alt"></i> SWITCH
                                </button>
                            </div>

                            <label class="admin-label" style="margin-top: 10px;">Sat Map Image Path</label>
                            <div class="admin-inline-group">
                                <input type="text" id="admin-map-path-input" value="{{mapImagePath}}" placeholder="worlds/MyWorld/maps/night-city.png" class="admin-input">
                                <button type="button" class="admin-btn admin-btn-ghost pick-map-path" title="Browse for image (Forge-compatible) — returns the correct Foundry-relative path"><i class="fas fa-folder-open"></i></button>
                                <button type="button" class="admin-btn admin-btn-cyan" data-action="save-map-path"><i class="fas fa-save"></i> SAVE</button>
                                <button type="button" class="admin-btn admin-btn-ghost" data-action="reset-map-path" title="Reset to default Night City map"><i class="fas fa-undo"></i></button>
                            </div>
                            <div class="admin-hint">Foundry-relative path. Click <i class="fas fa-folder-open" style="color: var(--neon-cyan);"></i> to browse — picks the right format automatically. Manual format: <span style="color:#aaa;">worlds/&lt;world&gt;/maps/your-map.png</span> (NOT <code style="color:#ff6666;">C:/Users/...</code> — absolute paths won't load).</div>
                        </div>

                        <!-- SECTION: IN-GAME CLOCK -->
                        <div class="admin-section">
                            <div class="admin-section-title">In-Game Clock</div>
                            {{#if hasSimpleCalendar}}
                                <div class="admin-hint" style="color: var(--neon-cyan);"><i class="fas fa-check-circle"></i> Simple Calendar detected — clock auto-syncs.</div>
                            {{else}}
                                <label class="admin-label">Manual Time (HH:MM)</label>
                                <div class="admin-inline-group">
                                    <input type="text" id="admin-clock-input" value="{{time}}" placeholder="21:30" class="admin-input datapool-input" style="max-width: 100px;">
                                    <button type="button" class="admin-btn admin-btn-cyan" data-action="save-ingame-clock"><i class="fas fa-clock"></i> SET</button>
                                    <button type="button" class="admin-btn admin-btn-ghost" data-action="clear-ingame-clock" title="Clear manual clock (use real time)"><i class="fas fa-undo"></i></button>
                                </div>
                                <div class="admin-hint">Set the time displayed on all players' Agent devices. Leave blank for real-world time. Install <a href="https://foundryvtt.com/packages/foundryvtt-simple-calendar" target="_blank" style="color:var(--neon-cyan);">Simple Calendar</a> for auto-sync.</div>
                            {{/if}}
                        </div>

                        <!-- SECTION: WORLD CONTENT -->
                        <div class="admin-section">
                            <div class="admin-section-title">World Content</div>
                            <label class="admin-label">NetStatus Feed Articles</label>
                            <div class="admin-hint" style="margin-bottom: 6px;">One per line: <span style="color:#aaa;">Category | Article text</span>. Blank lines ignored.</div>
                            <div class="admin-textarea-wrap">
                                <textarea id="admin-social-feed-input" rows="4" class="admin-input admin-textarea" data-preserve-draft
                                    placeholder="Trending in Night City | Arasaka extends Peace of Mind initiative...&#10;DataPool Alert | New EuroDyne drop tonight.">{{socialFeedRaw}}</textarea>
                            </div>
                            <div class="admin-inline-group" style="margin-top: 6px;">
                                <button type="button" class="admin-btn admin-btn-orange" data-action="save-social-feed"><i class="fas fa-save"></i> SAVE FEED</button>
                                <button type="button" class="admin-btn admin-btn-ghost" data-action="reset-social-feed" title="Clear all and show built-in defaults"><i class="fas fa-undo"></i> DEFAULTS</button>
                            </div>
                        </div>

                        <!-- SECTION: NC MART CUSTOM ITEMS -->
                        <div class="admin-section">
                            <div class="admin-section-title">NC Mart — GM Controls</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">Gate what's available in the shop. SAVE GATES to apply; checkout is re-validated server-side.</div>
                            {{!-- Patch4 round 6 (CommanderCrunch69 bug): these
                                  inputs/select had no save action — the values
                                  preview-rendered from the saved setting but
                                  edits never wrote back. Added a SAVE GATES
                                  button that commits all three at once, plus
                                  a "Currently in effect" line showing what's
                                  actually saved (so the GM can see the gates
                                  are live). --}}
                            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-bottom:10px;">
                                <div>
                                    <label class="admin-label" style="font-size:0.6rem;">Max price (eb)</label>
                                    <input type="number" id="store-max-price-input" class="admin-input datapool-input" min="0" step="100" value="{{storeMaxPrice}}" placeholder="0 = no cap" style="width:100%;" data-preserve-draft>
                                </div>
                                <div>
                                    <label class="admin-label" style="font-size:0.6rem;">Source filter</label>
                                    <select id="store-source-filter-select" class="admin-input admin-select datapool-input" style="width:100%;">
                                        {{#each storeSourceOptions}}
                                        <option value="{{this.id}}" {{#if (eq this.id ../storeSourceFilter)}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                            </div>
                            <label class="admin-label" style="font-size:0.6rem;">Locked categories</label>
                            <div class="admin-hint" style="margin-bottom: 4px;">Comma-separated names hidden from the tab bar (e.g. <span style="color:#aaa;">Cyberware, Drugs</span>).</div>
                            <input type="text" id="store-locked-categories-input" class="admin-input datapool-input" value="{{storeLockedCategories}}" placeholder="Cyberware, Drugs" style="width:100%; margin-bottom:6px;" data-preserve-draft>

                            <div class="admin-inline-group" style="margin-bottom: 8px;">
                                <button type="button" class="admin-btn admin-btn-cyan" data-action="save-store-gates"><i class="fas fa-save"></i> SAVE GATES</button>
                                <button type="button" class="admin-btn admin-btn-ghost" data-action="reset-store-gates" title="Clear all gates (no cap, all sources, no locked categories)"><i class="fas fa-undo"></i> CLEAR</button>
                            </div>

                            <div style="background:rgba(0,255,204,0.04); border:1px solid rgba(0,255,204,0.25); border-radius:4px; padding:6px 10px; margin-bottom:12px; font-family:monospace; font-size:0.62rem; color:#aaa;">
                                <div style="color:var(--neon-cyan); letter-spacing:1px; margin-bottom:3px;">CURRENTLY IN EFFECT</div>
                                <div>Max price: <span style="color:#fff;">{{#if storeMaxPrice}}{{storeMaxPrice}}eb{{else}}no cap{{/if}}</span></div>
                                <div>Source: <span style="color:#fff;">{{#if (eq storeSourceFilter "core")}}Core / compendium only{{else}}{{#if (eq storeSourceFilter "custom")}}Custom items only{{else}}All (core + custom){{/if}}{{/if}}</span></div>
                                <div>Locked: <span style="color:#fff;">{{#if storeLockedCategories}}{{storeLockedCategories}}{{else}}none{{/if}}</span></div>
                                <div>Blacklist: <span style="color:#fff;">{{#if storeBlacklistEntries.length}}{{storeBlacklistEntries.length}} item(s){{else}}none{{/if}}</span></div>
                            </div>

                            <label class="admin-label" style="font-size:0.6rem;">Blacklist</label>
                            <div class="admin-hint" style="margin-bottom: 4px;">Block specific items by name or UUID. Paste a UUID or name and ADD.</div>
                            <div style="display:flex; gap:6px; margin-bottom:6px;">
                                <input type="text" id="store-blacklist-input" class="datapool-input" placeholder="e.g. 'Smart Glasses' or 'Compendium.cyberpunk-red-core.core_gear.AbcDef123'" style="flex:1; min-width:0; width:auto !important; background:#111 !important; border:1px solid #444 !important; color:#fff !important; padding:6px 10px !important; font-family: monospace !important; font-size: 0.7rem !important; border-radius: 3px !important; height:32px !important; line-height:normal !important;" data-preserve-draft>
                                <button type="button" class="admin-btn admin-btn-cyan" data-action="store-blacklist-add"><i class="fas fa-ban"></i> ADD</button>
                            </div>
                            {{#if storeBlacklistEntries.length}}
                            <div style="display:flex; flex-wrap:wrap; gap:4px; margin-bottom:10px;">
                                {{#each storeBlacklistEntries}}
                                <span class="store-blacklist-chip" style="display:inline-flex; align-items:center; gap:4px; padding:3px 8px; background:rgba(255,51,85,0.1); border:1px solid rgba(255,51,85,0.4); border-radius:12px; font-family:monospace; font-size:0.62rem; color:#ff8899;">
                                    <span style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this}}</span>
                                    <i class="fas fa-times" data-action="store-blacklist-remove" data-entry="{{this}}" style="cursor:pointer; color:#ff3355;"></i>
                                </span>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="admin-hint" style="margin-bottom:10px; color:#555;">No items blacklisted.</div>
                            {{/if}}

                            <div class="admin-section-title">NC Mart — Custom Items</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">Build store items with the form below — no JSON required. Each item shows up under its category in the NC Mart catalog.</div>

                            {{!-- Patch4.7 follow-up: replaced the raw JSON
                                  textarea with a form-based item builder. Field
                                  inputs auto-validate, ADD ITEM saves immediately,
                                  and the list below shows each item with a
                                  one-click remove. --}}
                            <div style="background:#181a1f; border:1px solid var(--neon-cyan); border-radius:4px; padding:10px; margin-bottom:10px;">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                                    <div>
                                        <label class="admin-label" style="margin-top:0; font-size:0.6rem;">Item Name *</label>
                                        <input type="text" id="custom-item-name" class="admin-input datapool-input" placeholder="Zetatech Optics Mk4" data-preserve-draft style="width:100%; box-sizing:border-box;">
                                    </div>
                                    <div>
                                        <label class="admin-label" style="margin-top:0; font-size:0.6rem;">Category *</label>
                                        <input type="text" id="custom-item-category" class="admin-input datapool-input" placeholder="Cyberware" data-preserve-draft list="custom-item-category-suggestions" style="width:100%; box-sizing:border-box;">
                                        <datalist id="custom-item-category-suggestions">
                                            <option value="Weapons">
                                            <option value="Ammo">
                                            <option value="Armor">
                                            <option value="Clothing">
                                            <option value="Cyberware">
                                            <option value="Drugs">
                                            <option value="Gear">
                                            <option value="Vehicle">
                                            <option value="Pet">
                                            <option value="Program">
                                        </datalist>
                                        <label class="admin-label" style="margin-top:0; font-size:0.6rem;">Price (eb) *</label>
                                        <input type="number" id="custom-item-price" class="admin-input datapool-input" placeholder="500" min="0" data-preserve-draft style="width:100%; box-sizing:border-box;">
                                    </div>
                                    <div>
                                        <label class="admin-label" style="margin-top:0; font-size:0.6rem;">Image path (optional)</label>
                                        <div style="display: flex; gap: 4px; align-items: center;">
                                            <input type="text" id="custom-item-img" class="admin-input datapool-input" placeholder="icons/svg/..." data-preserve-draft style="flex: 1 1 auto !important; min-width: 0 !important; box-sizing:border-box;">
                                            <button type="button" class="pick-custom-item-img admin-btn admin-btn-ghost" title="Browse for image" style="flex: 0 0 auto !important; width: auto !important; padding: 4px 8px !important;"><i class="fas fa-folder-open"></i></button>
                                        </div>
                                    </div>
                                </div>
                                <label class="admin-label" style="font-size:0.6rem;">Description (optional)</label>
                                <input type="text" id="custom-item-description" class="admin-input datapool-input" placeholder="Upgraded targeting suite" data-preserve-draft style="width:100%; box-sizing:border-box;">
                                <div style="margin-top: 10px; display: flex; justify-content: flex-end;">
                                    <button type="button" class="admin-btn admin-btn-cyan" data-action="add-custom-store-item" style="flex: 0 0 auto !important; width: auto !important; display: inline-flex !important;"><i class="fas fa-plus"></i> ADD ITEM</button>
                                </div>
                            </div>

                            {{#if customStoreItemsParsed.length}}
                            <div class="admin-hint" style="margin-bottom: 4px; color: var(--neon-cyan);">{{customStoreItemsParsed.length}} custom item(s) live in NC Mart:</div>
                            <div class="admin-store-items-list" style="background:#181a1f; border:1px solid #2a2d33; border-radius:4px; padding:6px; margin-bottom:8px; max-height:160px; overflow-y:auto;">
                                {{#each customStoreItemsParsed}}
                                <div class="admin-store-item-row" style="display:flex; align-items:center; gap:8px; padding:4px 6px; border-bottom:1px solid #222; font-family:monospace; font-size:0.7rem;">
                                    <span style="flex:0 0 auto; color:#888; min-width:70px;">{{this.category}}</span>
                                    <span style="flex:1; color:#ddd; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this.name}}</span>
                                    <span style="flex:0 0 auto; color:var(--neon-cyan);">{{this.price}}eb</span>
                                    <button type="button" class="admin-btn-icon" data-action="remove-custom-store-item" data-item-index="{{@index}}" title="Remove" style="background:transparent; border:none; color:#ff3355; cursor:pointer; padding:2px 6px;">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="admin-hint" style="color: #555; margin-bottom: 8px;">No custom items yet — fill the form above and hit ADD ITEM.</div>
                            {{/if}}

                            {{!-- Advanced: raw JSON editor for power users. Hidden behind a disclosure. --}}
                            <details style="margin-top: 8px;">
                                <summary style="cursor: pointer; font-size: 0.65rem; color: #888; user-select: none;">Advanced: raw JSON editor</summary>
                                <div class="admin-hint" style="margin: 6px 0;">Edit the underlying JSON directly. Schema: <span style="color:#aaa;">[{ "name", "category", "price", "description"?, "img"? }, ...]</span></div>
                                <div class="admin-textarea-wrap">
                                    <textarea id="admin-custom-store-input" rows="4" class="admin-input admin-textarea datapool-input" data-preserve-draft
                                        placeholder='[&#10;  { "name": "Zetatech Optics Mk4", "category": "Cyberware", "price": 500, "description": "Upgraded optics" }&#10;]'>{{customStoreItemsRaw}}</textarea>
                                </div>
                                <div class="admin-inline-group" style="margin-top: 6px;">
                                    <button type="button" class="admin-btn admin-btn-cyan" data-action="save-custom-store"><i class="fas fa-save"></i> SAVE JSON</button>
                                    <button type="button" class="admin-btn admin-btn-ghost" data-action="add-custom-store-template" title="Insert a blank item template"><i class="fas fa-plus"></i> TEMPLATE</button>
                                </div>
                            </details>

                            <label class="admin-label" style="margin-top: 14px;"><i class="fas fa-box-open"></i> {{localize 'AGENTOS.Admin.PacksTitle'}} <span class="admin-count-pill">{{selectedStorePackCount}}</span></label>
                            <div class="admin-hint" style="margin-bottom: 8px;">{{localize 'AGENTOS.Admin.PacksHint'}}</div>
                            {{#if availableStorePacks.length}}
                            <div class="admin-pack-picker" data-preserve-scroll-container="admin-pack-picker">
                                {{#each availableStorePacks}}
                                <label class="admin-pack-row {{#if this.selected}}is-on{{/if}}">
                                    <input type="checkbox" class="agent-checkbox" data-action="toggle-store-pack" data-pack-id="{{this.id}}" {{#if this.selected}}checked{{/if}}>
                                    <span class="agent-checkbox-box"><i class="fas fa-check"></i></span>
                                    <span class="admin-pack-info">
                                        <span class="admin-pack-label">{{this.label}}</span>
                                        <span class="admin-pack-id">{{this.id}}</span>
                                    </span>
                                </label>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="admin-hint" style="color: #555;">{{localize 'AGENTOS.Admin.PacksNone'}}</div>
                            {{/if}}
                            <details style="margin-top: 10px;">
                                <summary style="cursor: pointer; font-size: 0.62rem; color: #7a8590; user-select: none;"><i class="fas fa-sliders-h"></i> {{localize 'AGENTOS.Admin.PacksManual'}}</summary>
                                <div class="admin-inline-group" style="margin-top:6px;">
                                    <input type="text" id="admin-custom-packs-input" value="{{customStorePacks}}" placeholder="world.my-pack, world.my-other-pack" class="admin-input datapool-input" data-preserve-draft>
                                    <button type="button" class="admin-btn admin-btn-cyan" data-action="save-custom-packs"><i class="fas fa-save"></i> {{localize 'AGENTOS.Common.Save'}}</button>
                                </div>
                            </details>
                        </div>

                        {{!-- Patch5.5 (community ask): Night Market curated drop.
                              Pulls items from the NC Mart catalog so prices stay
                              consistent. Pop a flavor blurb per item; players see
                              it on the NC Mart "Night Market" tab while the drop
                              is live. CLEAR ends the market. --}}
                        {{#if isGM}}
                        <div class="admin-section">
                            <div class="admin-section-title">NC Mart — Night Market</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">Curate a limited-time drop. START to open the market with a name, ADD items from the catalog, END to close it. Players see the Night Market tab in NC Mart while the market has items.</div>
                            {{#if nightMarketOpen}}
                            {{!-- Patch5.5.6: live state — show END button, current name + item count --}}
                            <div class="admin-inline-group" style="margin-bottom: 10px;">
                                <button type="button" class="admin-btn admin-btn-red" data-action="nm-clear"><i class="fas fa-power-off"></i> END NIGHT MARKET</button>
                                <span class="admin-hint" style="margin: 0;">{{#if nightMarket.items.length}}<span style="color:#cc77ff;">Live</span> · "{{nightMarket.name}}" · {{nightMarket.items.length}} item(s){{else}}<span style="color:#ff9900;">Open (empty)</span> · "{{nightMarket.name}}" — add items below to surface the tab{{/if}}</span>
                            </div>
                            {{else}}
                            {{!-- Patch5.5.6: closed state — name input + START button --}}
                            <div class="admin-inline-group" style="margin-bottom: 10px;">
                                <input type="text" id="nm-start-name" placeholder="Market name (e.g. Maelstrom Black Drop)" data-preserve-draft style="flex: 1 1 auto !important; min-width: 0 !important; background:#111 !important; color:#fff !important; border:1px solid #444 !important; padding:6px 10px !important; font-family:monospace !important; font-size:0.7rem !important; border-radius:3px !important; height:32px !important; box-sizing:border-box;">
                                <button type="button" class="admin-btn admin-btn-cyan" data-action="nm-start" style="background: rgba(170,0,255,0.18); border-color: #cc77ff; color: #cc77ff;"><i class="fas fa-moon"></i> START NIGHT MARKET</button>
                            </div>
                            <div class="admin-hint" style="margin: -4px 0 10px 0; color: #666; font-style: italic;">Blank name defaults to "Night Market". After START, add items from the catalog below.</div>
                            {{/if}}
                            {{#if nightMarket.items.length}}
                            <div style="background:#1a1620; border:1px solid #aa00ff; border-radius:4px; padding:6px; margin-bottom:10px; max-height:200px; overflow-y:auto;">
                                {{#each nightMarket.items}}
                                <div style="display:flex; gap:8px; padding:5px; border-bottom:1px solid #2a1a3a; align-items:center; font-family:monospace; font-size:0.65rem;">
                                    <span style="flex:1; color:#fff;">{{this.name}}</span>
                                    <span style="color:#cc77ff;">{{this.price}}eb</span>
                                    {{#if this.catalogPrice}}{{#unless (eq this.price this.catalogPrice)}}<span style="color:#666; font-size:0.55rem;" title="Catalog price">(was {{this.catalogPrice}}eb)</span>{{/unless}}{{/if}}
                                    {{#if this.flavor}}<span style="color:#888; font-style:italic; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this.flavor}}</span>{{/if}}
                                    <i class="fas fa-times" data-action="nm-remove-item" data-item-uuid="{{this.uuid}}" style="cursor:pointer; color:#ff3355;"></i>
                                </div>
                                {{/each}}
                            </div>
                            {{/if}}
                            {{#if nightMarketOpen}}
                            {{!-- Patch5.5.12: explicit LOAD/REFRESH catalog button so the
                                  picker populates without having to open NC Mart first.
                                  Shows different states: not-loaded (LOAD button + empty
                                  message), loaded (REFRESH button + populated picker). --}}
                            <div style="display: flex; gap: 6px; align-items: center; margin-top: 8px; margin-bottom: 6px;">
                                <button type="button" data-action="nm-load-catalog" style="flex: 0 0 auto; background: rgba(204,119,255,0.15); border: 1px solid #cc77ff; color: #cc77ff; cursor: pointer; padding: 6px 12px; border-radius: 4px; font-family: monospace; font-size: 0.65rem; font-weight: bold;">
                                    {{#if nmCatalogLoaded}}<i class="fas fa-sync"></i> REFRESH CATALOG{{else}}<i class="fas fa-download"></i> LOAD CATALOG{{/if}}
                                </button>
                                <span style="font-family: monospace; font-size: 0.6rem; color: #888;">
                                    {{#if nmCatalogLoaded}}{{nmCatalogPicker.length}} items available{{else}}Catalog not imported yet{{/if}}
                                </span>
                            </div>
                            <details {{#if nmCatalogLoaded}}open{{/if}}>
                                <summary style="cursor: pointer; font-size: 0.7rem; color: #cc77ff; user-select: none; padding: 4px 0;"><i class="fas fa-store"></i> Add from current catalog</summary>
                                <div style="background:#181a1f; border:1px solid #2a2d33; border-radius:4px; padding:6px; margin-top:6px; max-height:240px; overflow-y:auto;" data-preserve-scroll-container="nm-catalog-picker">
                                    {{#if nmCatalogLoaded}}
                                        {{#each nmCatalogPicker}}
                                        <div style="display:flex; gap:6px; padding:4px; border-bottom:1px solid #222; font-family:monospace; font-size:0.65rem; align-items:center;">
                                            <span style="flex:0 0 70px; color:#888;">{{this.category}}</span>
                                            <span style="flex:1; min-width:0; color:#ddd; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this.name}}</span>
                                            <span style="flex:0 0 auto; color:#666;" title="Catalog price — leave override blank to use this">{{this.price}}eb</span>
                                            {{!-- Patch5.5.12: optional price override. Blank = use catalog price. --}}
                                            <input type="number" id="nm-price-{{this.uuid}}" placeholder="override" min="0" step="1" data-preserve-draft style="flex:0 0 70px; background:#111; border:1px solid #444; color:#cc77ff; padding:3px 6px; font-size:0.6rem; border-radius:3px;" title="Override price (leave blank to use catalog price)">
                                            <input type="text" id="nm-flavor-{{this.uuid}}" placeholder="flavor (optional)" data-preserve-draft style="flex:0 0 110px; background:#111; border:1px solid #444; color:#fff; padding:3px 6px; font-size:0.6rem; border-radius:3px;">
                                            <button type="button" data-action="nm-add-from-catalog" data-item-uuid="{{this.uuid}}" style="background:rgba(170,0,255,0.15); border:1px solid #aa00ff; color:#aa00ff; cursor:pointer; padding:3px 8px; border-radius:3px; font-size:0.6rem;">+ ADD</button>
                                        </div>
                                        {{else}}
                                        <div style="text-align: center; padding: 20px; color: #666; font-size: 0.65rem; font-style: italic;">Catalog empty — check NC Mart custom items / pack imports.</div>
                                        {{/each}}
                                    {{else}}
                                    <div style="text-align: center; padding: 20px; color: #888; font-size: 0.7rem;">
                                        <i class="fas fa-download" style="font-size: 1.2rem; display: block; margin-bottom: 6px; color: #cc77ff;"></i>
                                        Click <strong>LOAD CATALOG</strong> above to import the live NC Mart catalog. One-time per session.
                                    </div>
                                    {{/if}}
                                </div>
                            </details>
                            {{/if}}
                        </div>
                        {{/if}}

                        {{!-- Patch5.5 (Ryouhi / community): NCPD Crime Database admin --}}
                        {{#if isGM}}
                        <div class="admin-section">
                            <div class="admin-section-title">NCPD Crime Database</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">File rap sheets the table can look up from the NCPD app. Bounty + status are optional.</div>
                            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px; margin-bottom: 6px;">
                                <input type="text" id="ncpd-add-name" class="admin-input datapool-input" placeholder="Name *" data-preserve-draft style="box-sizing:border-box;">
                                <input type="text" id="ncpd-add-status" class="admin-input datapool-input" placeholder="Status (Wanted / KIA / At Large…)" data-preserve-draft style="box-sizing:border-box;">
                                <input type="text" id="ncpd-add-bounty" class="admin-input datapool-input" placeholder="Bounty (e.g. 5,000eb)" data-preserve-draft style="box-sizing:border-box;">
                                <input type="text" id="ncpd-add-charges" class="admin-input datapool-input" placeholder="Charges (comma-separated)" data-preserve-draft style="box-sizing:border-box;">
                            </div>
                            <textarea id="ncpd-add-notes" class="admin-input admin-textarea datapool-input" rows="2" placeholder="Notes (priors, MO, last known location…)" data-preserve-draft style="width:100%; box-sizing:border-box; margin-bottom: 6px;"></textarea>
                            <div class="admin-inline-group" style="margin-bottom: 10px;">
                                <button type="button" class="admin-btn admin-btn-cyan" data-action="ncpd-add-record"><i class="fas fa-fingerprint"></i> FILE RAP SHEET</button>
                            </div>
                            {{#if ncpdRapSheets.length}}
                            <div style="background:#181a1f; border:1px solid #2a2d33; border-radius:4px; padding:6px; max-height:200px; overflow-y:auto;">
                                {{#each ncpdRapSheets}}
                                <div style="display:flex; gap:8px; padding:5px; border-bottom:1px solid #222; align-items:center; font-family:monospace; font-size:0.65rem;">
                                    <span style="flex:1; color:#ddd; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this.name}}{{#if this.status}} — <span style="color:#ffcc00;">{{this.status}}</span>{{/if}}</span>
                                    {{#if this.bounty}}<span style="color: var(--creds-gold);">{{this.bounty}}</span>{{/if}}
                                    <i class="fas fa-times" data-action="ncpd-delete-record" data-record-id="{{this.id}}" style="cursor:pointer; color:#ff3355;"></i>
                                </div>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="admin-hint" style="color:#555;">No rap sheets filed yet.</div>
                            {{/if}}
                        </div>
                        {{/if}}

                        {{!-- Patch5.5: Ziggurat City Database admin --}}
                        {{#if isGM}}
                        <div class="admin-section">
                            <div class="admin-section-title">Ziggurat City Database</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">Catalog venues, fixers, ripperdocs, safehouses. Players can search + filter.</div>
                            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px; margin-bottom: 6px;">
                                <input type="text" id="ziggurat-add-name" class="admin-input datapool-input" placeholder="Name *" data-preserve-draft style="box-sizing:border-box;">
                                <select id="ziggurat-add-category" class="admin-input admin-select datapool-input" style="box-sizing:border-box;">
                                    <option value="Venue">Venue</option>
                                    <option value="Fixer">Fixer</option>
                                    <option value="Ripperdoc">Ripperdoc</option>
                                    <option value="Vendor">Vendor</option>
                                    <option value="Safehouse">Safehouse</option>
                                    <option value="Gang Turf">Gang Turf</option>
                                    <option value="Corp">Corp</option>
                                    <option value="Other">Other</option>
                                </select>
                                <input type="text" id="ziggurat-add-address" class="admin-input datapool-input" placeholder="Address / district" data-preserve-draft style="box-sizing:border-box;">
                                <input type="text" id="ziggurat-add-hours" class="admin-input datapool-input" placeholder="Hours (e.g. 22:00 – 04:00)" data-preserve-draft style="box-sizing:border-box;">
                            </div>
                            <textarea id="ziggurat-add-notes" class="admin-input admin-textarea datapool-input" rows="2" placeholder="Notes" data-preserve-draft style="width:100%; box-sizing:border-box; margin-bottom: 6px;"></textarea>
                            <div class="admin-inline-group" style="margin-bottom: 10px;">
                                <button type="button" class="admin-btn admin-btn-cyan" data-action="ziggurat-add-entry"><i class="fas fa-plus"></i> ADD LISTING</button>
                            </div>
                            {{#if cityDirectory.length}}
                            <div style="background:#181a1f; border:1px solid #2a2d33; border-radius:4px; padding:6px; max-height:200px; overflow-y:auto;">
                                {{#each cityDirectory}}
                                <div style="display:flex; gap:8px; padding:5px; border-bottom:1px solid #222; align-items:center; font-family:monospace; font-size:0.65rem;">
                                    <span style="flex:0 0 70px; color:#aa88ff;">{{this.category}}</span>
                                    <span style="flex:1; color:#ddd; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this.name}}{{#if this.address}} · {{this.address}}{{/if}}</span>
                                    <i class="fas fa-times" data-action="ziggurat-delete-entry" data-entry-id="{{this.id}}" style="cursor:pointer; color:#ff3355;"></i>
                                </div>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="admin-hint" style="color:#555;">No listings yet.</div>
                            {{/if}}
                        </div>
                        {{/if}}

                        {{!-- Patch5.5: The Garden (dating) admin --}}
                        {{#if isGM}}
                        <div class="admin-section">
                            <div class="admin-section-title">The Garden — Profiles</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">Plant NPC profiles. Players match + can DM straight from the app — message lands in their Messenger thread.</div>
                            <div style="display:grid; grid-template-columns: 2fr 1fr 2fr; gap:6px; margin-bottom: 6px;">
                                <input type="text" id="garden-add-name" class="admin-input datapool-input" placeholder="Display name *" data-preserve-draft style="box-sizing:border-box;">
                                <input type="text" id="garden-add-age" class="admin-input datapool-input" placeholder="Age" data-preserve-draft style="box-sizing:border-box;">
                                <input type="text" id="garden-add-availability" class="admin-input datapool-input" placeholder="Availability (Active / Off / Hidden)" data-preserve-draft style="box-sizing:border-box;">
                            </div>
                            <div style="display: flex; gap:6px; margin-bottom: 6px;">
                                <input type="text" id="garden-add-photo" class="admin-input datapool-input" placeholder="Photo path (icons/svg/... or modules/cyberpunk-red-agent-os-modified/...)" data-preserve-draft style="flex:1; box-sizing:border-box;">
                            </div>
                            <textarea id="garden-add-bio" class="admin-input admin-textarea datapool-input" rows="2" placeholder="Bio" data-preserve-draft style="width:100%; box-sizing:border-box; margin-bottom: 6px;"></textarea>
                            <input type="text" id="garden-add-interests" class="admin-input datapool-input" placeholder="Interests (comma-separated)" data-preserve-draft style="width:100%; box-sizing:border-box; margin-bottom: 6px;">
                            <div class="admin-inline-group" style="margin-bottom: 10px;">
                                <button type="button" class="admin-btn admin-btn-cyan" data-action="garden-add-profile"><i class="fas fa-seedling"></i> ADD PROFILE</button>
                            </div>
                            {{#if gardenProfiles.length}}
                            <div style="background:#181a1f; border:1px solid #2a2d33; border-radius:4px; padding:6px; max-height:200px; overflow-y:auto;">
                                {{#each gardenProfiles}}
                                <div style="display:flex; gap:8px; padding:5px; border-bottom:1px solid #222; align-items:center; font-family:monospace; font-size:0.65rem;">
                                    <span style="flex:1; color:#ddd; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{this.name}}{{#if this.age}}, {{this.age}}{{/if}}</span>
                                    <span style="color:#ff77aa;">{{this.availability}}</span>
                                    <i class="fas fa-times" data-action="garden-delete-profile" data-profile-id="{{this.id}}" style="cursor:pointer; color:#ff3355;"></i>
                                </div>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="admin-hint" style="color:#555;">No profiles yet.</div>
                            {{/if}}
                        </div>
                        {{/if}}

                        {{!-- Patch5.5.3: Map indicators moved to the Maps app (Ryouhi UX:
                              click-to-place instead of GMs typing x/y coordinates).
                              See Maps → PIN button to place, MANAGE button to curate. --}}

                        {{!-- Patch4.7 (Gotto): Trauma Team coverage + Fixer rank
                              roster. GM sets both per-player. Coverage gates
                              the bio screen panic button; Fixer rank gates NC
                              Mart items above the world-level price threshold.
                              Patch5.5 (Gotto): housing status + rent fields
                              join the per-player row — saved via SAVE HOUSING
                              (separate write so a slip on one field doesn't
                              clobber TT + Fixer config). --}}
                        {{#if isGM}}
                        <div class="admin-section">
                            <div class="admin-section-title">Player Profile (TT Coverage + Fixer Rank)</div>
                            <div class="admin-hint" style="margin-bottom: 8px;"><strong>TT Coverage:</strong> blank = no coverage, panic button hidden. Common tiers: Bronze · Silver · Gold · Platinum.<br><strong>Fixer Rank (0–10):</strong> unlocks higher-priced NC Mart items per the world Fixer Rank Gate (Configure Settings → AgentDevice).</div>
                            <div class="admin-row" style="margin-bottom: 4px; font-size: 0.6rem; color: #888; letter-spacing: 1px;">
                                <div style="flex: 0 0 35%;">PLAYER</div>
                                <div style="flex: 1 1 auto;">TT COVERAGE</div>
                                <div style="flex: 0 0 90px; text-align: center;">FIXER RANK</div>
                            </div>
                            {{#each adminTtCoverage}}
                            <div class="admin-row" style="margin-bottom: 6px; display: flex; gap: 6px; align-items: center;">
                                <div class="admin-row-info" style="flex: 0 0 35%; min-width: 0;">
                                    <div class="admin-row-label" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{this.name}}</div>
                                </div>
                                <input type="text" id="tt-coverage-{{this.userId}}" value="{{this.tier}}" placeholder="(none)" class="admin-input" style="flex: 1 1 auto !important; min-width: 0 !important;" data-preserve-draft>
                                <input type="number" id="fixer-rank-{{this.userId}}" value="{{this.fixerRank}}" min="0" max="10" class="admin-input" style="flex: 0 0 80px !important; width: 80px !important; min-width: 0 !important; text-align: center;" data-preserve-draft>
                            </div>
                            {{/each}}
                            <button type="button" class="admin-btn admin-btn-cyan" data-action="save-tt-coverage" style="margin-top: 8px;"><i class="fas fa-save"></i> SAVE PROFILE</button>
                        </div>

                        {{!-- Patch5.5 (Gotto): Housing roster. Display shows on the
                              player's ID card. Status is freeform ("Cargo container —
                              Watson", "Megabuilding H8 — apt 117"). Rent is freeform
                              too so the GM can write "200eb/mo" or "owes 3 weeks".
                              SAVE HOUSING is a separate write from SAVE PROFILE — keeps
                              the columns from clobbering each other on partial edits. --}}
                        <div class="admin-section">
                            <div class="admin-section-title">Housing Roster</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">Per-character. Players with multiple PCs see one row per character. Leave blank to hide the housing block on that character's ID card.</div>
                            <div class="admin-row" style="margin-bottom: 4px; font-size: 0.6rem; color: #888; letter-spacing: 1px;">
                                <div style="flex: 0 0 32%;">PLAYER → CHARACTER</div>
                                <div style="flex: 1 1 auto;">HOUSING / STATUS</div>
                                <div style="flex: 0 0 32%;">RENT</div>
                            </div>
                            {{#each adminHousingRoster}}
                            <div class="admin-row" data-housing-row data-owner-kind="{{this.ownerKind}}" data-owner-id="{{this.ownerId}}" style="margin-bottom: 6px; display: flex; gap: 6px; align-items: center;">
                                <div class="admin-row-info" style="flex: 0 0 32%; min-width: 0;">
                                    <div class="admin-row-label" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{this.name}}</div>
                                </div>
                                <input type="text" id="housing-status-{{this.ownerKind}}-{{this.ownerId}}" value="{{this.housingStatus}}" placeholder="(no housing on file)" class="admin-input" style="flex: 1 1 auto !important; min-width: 0 !important;" data-preserve-draft>
                                <input type="text" id="housing-rent-{{this.ownerKind}}-{{this.ownerId}}" value="{{this.housingRent}}" placeholder="rent (optional)" class="admin-input" style="flex: 0 0 32% !important; min-width: 0 !important;" data-preserve-draft>
                            </div>
                            {{/each}}
                            <button type="button" class="admin-btn admin-btn-cyan" data-action="save-housing" style="margin-top: 8px;"><i class="fas fa-home"></i> SAVE HOUSING</button>
                        </div>
                        {{/if}}

                        {{!-- Patch4.7 (Gotto): Wallet Identity tabs. Lets the GM
                              swap the active wallet view into any player's
                              identity (or back to System Fund). Reuses the
                              folder-tab CSS from Application Access. --}}
                        {{#if isGM}}
                        <div class="admin-section admin-section--wallet-identity">
                            <div class="admin-section-title">Wallet Identity</div>
                            <div class="admin-hint" style="margin-bottom: 8px;">Pick which wallet Sys Admin reads/acts on. System Fund (Master) is the GM-side eb pool; player tabs surface that player's wallet so you can verify balances, run a ledger entry, or pay them directly.</div>
                            <div class="app-access-tabs" role="tablist">
                                {{#each adminWalletTabs}}
                                <button type="button"
                                    class="app-access-tab {{#if this.isActive}}is-active{{/if}} {{#if this.isGM}}is-gm{{/if}}"
                                    role="tab" aria-selected="{{#if this.isActive}}true{{else}}false{{/if}}"
                                    data-action="admin-wallet-select" data-target-uuid="{{this.uuid}}"
                                    title="{{this.name}}{{#if this.actorName}} — {{this.actorName}}{{/if}}">
                                    {{#if this.isGM}}<i class="fas fa-landmark"></i>{{else}}<i class="fas fa-wallet"></i>{{/if}}
                                    <span class="app-access-tab-label">{{this.name}}</span>
                                </button>
                                {{/each}}
                            </div>
                            <div class="admin-hint" style="margin-top: 8px; color: var(--neon-cyan);">Active wallet: <strong>{{actorName}}</strong> · Balance: <strong>{{actorCurrency}}eb</strong></div>
                            <div class="admin-hint" style="margin-top: 4px;">Synced to active tab: Wallet, Agent ID. Messenger / Social Net / Contacts still author as GM.</div>
                        </div>
                        {{/if}}

                        <!-- SECTION: APP ACCESS -->
                        <div class="admin-section admin-section--app-access">
                            <div class="admin-section-title">Application Access</div>
                            {{!-- Patch4 round 2: folder-style tabs sit on top of
                                  the app-lock frame. Clicking a tab switches
                                  the Application Access toggles to that player
                                  only — nothing else in Sys Admin changes. --}}
                            {{#if isGM}}
                            <div class="app-access-tabs" role="tablist">
                                {{#each adminAppLockTabs}}
                                <button type="button"
                                    class="app-access-tab {{#if this.isActive}}is-active{{/if}} {{#if this.isGM}}is-gm{{/if}} {{#if this.noActor}}no-actor{{/if}}"
                                    role="tab" aria-selected="{{#if this.isActive}}true{{else}}false{{/if}}"
                                    data-action="admin-tab-select" data-target-uuid="{{this.uuid}}"
                                    title="{{this.name}}{{#if this.actorName}} — {{this.actorName}}{{/if}}{{#if this.noActor}} (no character assigned){{/if}}">
                                    {{#if this.isGM}}<i class="fas fa-user-shield"></i>{{else}}<i class="fas fa-user"></i>{{/if}}
                                    <span class="app-access-tab-label">{{this.name}}</span>
                                </button>
                                {{/each}}
                            </div>
                            {{/if}}
                            <div class="app-access-frame">
                                {{#each allApps}}
                                <div class="admin-app-row" style="display: flex; justify-content: space-between; align-items: center; padding: 10px; background: rgba(0,0,0,0.3); margin-bottom: 5px; border-radius: 4px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        {{#if (eq this.icon 'img')}}
                                            <img src="{{this.src}}" style="width: 16px; height: 16px; object-fit: contain;">
                                        {{else}}
                                            <i class="{{this.icon}}" style="color: {{this.color}}; font-size: 0.8rem;"></i>
                                        {{/if}}
                                        <span style="font-size: 0.8rem; color: #fff;">{{this.label}}</span>
                                    </div>
                                    <i class="fas fa-toggle-{{#if (contains ../unlockedApps this.id)}}on{{else}}off{{/if}} toggle-app-lock"
                                       data-app-id="{{this.id}}"
                                       data-action="toggle-app-lock"
                                       style="cursor: pointer; font-size: 1.2rem; color: {{#if (contains ../unlockedApps this.id)}}#44ff44{{else}}#555{{/if}};"></i>
                                </div>
                                {{/each}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom bezel — drag handle + home button -->
        <div class="agent-bottom-bezel" style="position: absolute; bottom: 0; left: 0; right: 0; height: 30px; display: flex; align-items: center; justify-content: center; z-index: 20;">
            <div class="back-to-home" data-action="back-to-home" style="cursor: pointer; width: 60px; height: 5px; background: rgba(255, 255, 255, 0.25); border-radius: 4px; transition: background 0.2s;"></div>
        </div>
    </div>
</form>
