<div class="agentos-reader">
  <div class="agentos-reader-toolbar">
    <span>{{title}}</span>
    <button type="button" data-action="shard-zoom-out" title="{{localize "AGENTOS.Data.ZoomOut"}}"><i class="fas fa-minus"></i></button>
    <button type="button" data-action="shard-zoom-reset" title="{{localize "AGENTOS.Data.ZoomReset"}}">{{zoom}}%</button>
    <button type="button" data-action="shard-zoom-in" title="{{localize "AGENTOS.Data.ZoomIn"}}"><i class="fas fa-plus"></i></button>
  </div>
  <div class="agentos-reader-viewport"><iframe class="agentos-reader-frame" title="{{title}}" sandbox="allow-scripts allow-forms allow-modals allow-popups allow-downloads" referrerpolicy="no-referrer"></iframe></div>
</div>
