<div class="agentos-thread">
  <header class="agentos-thread-header">
    <button type="button" class="agentos-icon-btn" data-action="chat-back"><i class="fas fa-arrow-left"></i></button>
    <img class="agentos-avatar" src="{{chatImg}}" alt="">
    <div class="agentos-thread-title">
      <span>{{chatName}}</span>
      <small>{{participants.length}} {{localize "AGENTOS.Chat.Members"}}</small>
    </div>
    <button type="button" class="agentos-icon-btn" data-action="chat-search-toggle" title="{{localize "AGENTOS.Chat.SearchMessages"}}"><i class="fas fa-magnifying-glass"></i></button>
    <button type="button" class="agentos-icon-btn" data-action="chat-mute" title="{{localize "AGENTOS.Notifications.Mute"}}"><i class="fas {{#if muted}}fa-bell-slash{{else}}fa-bell{{/if}}"></i></button>
    <button type="button" class="agentos-icon-btn" data-action="chat-side-toggle" title="{{localize "AGENTOS.Navigation.Alongside"}}"><i class="fas fa-columns"></i></button>
    <button type="button" class="agentos-icon-btn" data-action="chat-call" title="{{localize "AGENTOS.Chat.Call"}}"><i class="fas fa-phone"></i></button>
    {{#if isGM}}
    <button type="button" class="agentos-icon-btn" data-action="chat-rename" title="{{localize "AGENTOS.Chat.EditChat"}}"><i class="fas fa-pen"></i></button>
    <button type="button" class="agentos-icon-btn" data-action="chat-participants" title="{{localize "AGENTOS.Chat.Participants"}}"><i class="fas fa-users"></i></button>
    {{/if}}
  </header>

  <div class="agentos-message-search" {{#unless searchOpen}}hidden{{/unless}}>
    <input type="search" name="message-search" value="{{messageQuery}}" placeholder="{{localize "AGENTOS.Chat.SearchMessages"}}" aria-label="{{localize "AGENTOS.Chat.SearchMessages"}}">
    <span class="agentos-chat-match-count">0/0</span>
    <button type="button" class="agentos-icon-btn" data-action="chat-search-step" data-step="-1" title="{{localize "AGENTOS.Chat.PreviousMatch"}}"><i class="fas fa-chevron-up"></i></button>
    <button type="button" class="agentos-icon-btn" data-action="chat-search-step" data-step="1" title="{{localize "AGENTOS.Chat.NextMatch"}}"><i class="fas fa-chevron-down"></i></button>
  </div>

  {{#if editMsg}}
  <div class="agentos-modal">
    <div class="agentos-modal-card">
      <h3><i class="fas fa-pen"></i> {{localize "AGENTOS.Chat.EditMessage"}}</h3>
      <label>{{localize "AGENTOS.Chat.MessageText"}}</label>
      <textarea name="msg-edit-text" rows="4">{{editMsg.text}}</textarea>
      <label>{{localize "AGENTOS.Chat.MessageTime"}}</label>
      <input type="datetime-local" name="msg-edit-ts" value="{{editMsg.tsLocal}}">
      <div class="agentos-modal-actions">
        <button type="button" class="agentos-btn" data-action="msg-edit-cancel">{{localize "AGENTOS.Common.Cancel"}}</button>
        <button type="button" class="agentos-btn primary" data-action="msg-edit-save">{{localize "AGENTOS.Common.Save"}}</button>
      </div>
    </div>
  </div>
  {{/if}}

  {{#if editingChat}}
  <div class="agentos-modal">
    <div class="agentos-modal-card agentos-chatedit">
      <h3><i class="fas fa-pen-nib"></i> {{localize "AGENTOS.Chat.EditChat"}}</h3>
      <div class="agentos-chatedit-row">
        <div class="agentos-chatedit-preview">
          <img src="{{#if editingChat.img}}{{editingChat.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="">
          <span class="agentos-chatedit-corner tl"></span><span class="agentos-chatedit-corner tr"></span>
          <span class="agentos-chatedit-corner bl"></span><span class="agentos-chatedit-corner br"></span>
        </div>
        <div class="agentos-chatedit-imgbtns">
          <button type="button" class="agentos-btn" data-action="chat-edit-img"><i class="fas fa-image"></i> {{localize "AGENTOS.Chat.ChangeImage"}}</button>
          <button type="button" class="agentos-btn" data-action="chat-edit-img-clear"><i class="fas fa-rotate-left"></i> {{localize "AGENTOS.Chat.ResetImage"}}</button>
        </div>
      </div>
      <input type="hidden" name="chat-edit-img" value="{{editingChat.img}}">
      <label>{{localize "AGENTOS.Chat.ChatName"}}</label>
      <input type="text" name="chat-edit-name" value="{{editingChat.name}}" placeholder="{{localize "AGENTOS.Chat.NamePlaceholder"}}">
      <div class="agentos-modal-actions">
        <button type="button" class="agentos-btn" data-action="chat-edit-cancel">{{localize "AGENTOS.Common.Cancel"}}</button>
        <button type="button" class="agentos-btn primary" data-action="chat-edit-save">{{localize "AGENTOS.Common.Save"}}</button>
      </div>
    </div>
  </div>
  {{/if}}

  {{#if showParticipants}}
  <div class="agentos-participants">
    {{#each participants}}
    <div class="agentos-participant">
      <img class="agentos-avatar sm" src="{{this.img}}" alt="">
      <div class="agentos-list-main">
        <div class="agentos-list-title">{{this.name}}</div>
        <div class="agentos-list-sub">{{this.sub}}</div>
      </div>
      <button type="button" class="agentos-icon-btn" data-action="part-rename" data-key="{{this.key}}" title="{{localize "AGENTOS.Chat.RenameParticipant"}}"><i class="fas fa-pen"></i></button>
      <button type="button" class="agentos-icon-btn" data-action="part-reimg" data-key="{{this.key}}" title="{{localize "AGENTOS.Chat.ChangeAvatar"}}"><i class="fas fa-image"></i></button>
      <button type="button" class="agentos-icon-btn" data-action="part-reimg-clear" data-key="{{this.key}}" title="{{localize "AGENTOS.Chat.ResetOverrides"}}"><i class="fas fa-rotate-left"></i></button>
      <button type="button" class="agentos-icon-btn danger" data-action="part-remove" data-key="{{this.key}}" title="{{localize "AGENTOS.Common.Remove"}}"><i class="fas fa-user-minus"></i></button>
    </div>
    {{/each}}
    {{#if addable.length}}
    <select name="chat-add-participant" class="agentos-select">
      <option value="">{{localize "AGENTOS.Chat.AddParticipant"}}…</option>
      {{#each addableGroups}}
      <optgroup label="{{this.name}}">
        {{#each this.items}}
        <option value="{{this.key}}">{{this.name}}</option>
        {{/each}}
      </optgroup>
      {{/each}}
    </select>
    {{/if}}
  </div>
  {{/if}}

  <div class="agentos-chat-scroll">
    {{#each pinned}}<button type="button" class="agentos-btn" data-action="msg-jump" data-msg-id="{{id}}"><i class="fas fa-thumbtack"></i> {{preview}}</button>{{/each}}
    {{#each messages}}
    <div class="agentos-msg-row {{#if this.isSelf}}self{{/if}}" data-msg-id="{{this.id}}">
      {{#unless this.isSelf}}
      <img class="agentos-avatar sm" src="{{this.img}}" alt="">
      {{/unless}}
      <div class="agentos-bubble-wrap">
        {{#unless this.isSelf}}<div class="agentos-msg-sender">{{this.name}}</div>{{/unless}}
        <div class="agentos-bubble">
          {{#if replyTo}}<button type="button" class="agentos-quote" data-action="msg-jump" data-msg-id="{{replyTo.id}}"><strong>{{replyTo.name}}</strong><span>{{replyTo.text}}</span></button>{{/if}}
          {{#if card}}<div class="agentos-attachment-card"><button type="button" class="agentos-btn" data-action="card-open" data-msg-id="{{id}}"><i class="fas fa-folder-open"></i> {{attachment.title}}</button>{{#if importable}}<button type="button" class="agentos-icon-btn" data-action="card-import" data-msg-id="{{id}}" {{#if imported}}disabled{{/if}} title="{{#if imported}}{{localize "AGENTOS.Chat.Added"}}{{else}}{{#if (agEq attachment.kind "shard")}}{{localize "AGENTOS.Chat.Download"}}{{else}}{{localize "AGENTOS.Chat.AddContact"}}{{/if}}{{/if}}"><i class="fas {{#if imported}}fa-check{{else}}fa-download{{/if}}"></i></button>{{/if}}</div>{{/if}}
          {{#if this.attachment}}
            {{#if (agEq this.attachment.kind "image")}}
              <img class="agentos-attach-img" src="{{this.attachment.src}}" alt=""
                   data-action="chat-open-image" data-src="{{this.attachment.src}}"
                   title="{{localize "AGENTOS.Chat.OpenImage"}}">
            {{/if}}
            {{#if (agEq this.attachment.kind "audio")}}
              <div class="agentos-attach-row">
                <audio class="agentos-attach-audio" controls src="{{this.attachment.src}}"></audio>
                <a class="agentos-attach-dl" href="{{this.attachment.src}}" download title="{{localize "AGENTOS.Chat.Download"}}"><i class="fas fa-download"></i></a>
              </div>
            {{/if}}
            {{#if (agEq this.attachment.kind "video")}}
              <div class="agentos-video-wrap">
                <video class="agentos-attach-video" controls src="{{this.attachment.src}}"></video>
                <a class="agentos-attach-dl video-overlay" href="{{this.attachment.src}}" download title="{{localize "AGENTOS.Chat.Download"}}"><i class="fas fa-download"></i></a>
              </div>
            {{/if}}
          {{/if}}
          {{#if this.text}}<div class="agentos-msg-text">{{this.text}}</div>{{/if}}
          <span class="agentos-msg-time">{{agTime this.ts}}</span>
        </div>
        <div class="agentos-message-actions"><button type="button" class="agentos-icon-btn" data-action="msg-reply" data-msg-id="{{id}}" title="{{localize "AGENTOS.Chat.Reply"}}"><i class="fas fa-reply"></i></button>{{#each reactionsView}}<button type="button" class="agentos-reaction {{#if active}}active{{/if}}" data-action="msg-react" data-msg-id="{{../id}}" data-reaction="{{reaction}}">{{reaction}}{{#if count}} {{count}}{{/if}}</button>{{/each}}{{#if @root.isGM}}<button type="button" class="agentos-icon-btn" data-action="msg-pin" data-msg-id="{{id}}" title="{{localize "AGENTOS.Chat.Pin"}}"><i class="fas fa-thumbtack"></i></button>{{/if}}</div>
      </div>
    </div>
    {{/each}}
  </div>

  <button type="button" class="agentos-cat agentos-chat-latest" data-action="chat-latest" {{#unless showLatest}}hidden{{/unless}}><i class="fas fa-chevron-down"></i> {{localize "AGENTOS.Chat.Latest"}}</button>
  <footer class="agentos-compose">
    {{#if uploadFailed}}<button type="button" class="agentos-btn" data-action="chat-upload-retry">{{localize "AGENTOS.Notify.UploadFailed"}} · {{localize "AGENTOS.Operations.Retry"}}</button>{{/if}}
    {{#if reply}}<div class="agentos-attach-chip"><span>{{reply.name}}: {{reply.text}}</span><button type="button" class="agentos-icon-btn" data-action="reply-clear" title="{{localize "AGENTOS.Common.Cancel"}}"><i class="fas fa-xmark"></i></button></div>{{/if}}
    {{#if uploading}}
    <div class="agentos-attach-chip">
      <i class="fas fa-spinner fa-spin"></i>
      <span>{{localize "AGENTOS.Chat.Uploading"}}</span>
    </div>
    {{/if}}
    {{#if attachment}}
    <div class="agentos-attach-chip">
      <i class="fas {{#if (agEq attachment.kind "image")}}fa-image{{/if}}{{#if (agEq attachment.kind "audio")}}fa-music{{/if}}{{#if (agEq attachment.kind "video")}}fa-film{{/if}}"></i>
      <span>{{attachmentLabel}}</span>
      <button type="button" class="agentos-icon-btn" data-action="chat-attach-clear"><i class="fas fa-xmark"></i></button>
    </div>
    {{/if}}
    {{#if canWrite}}
    {{#if isGM}}
    {{#if voice}}
    <div class="agentos-voice-row">
      <button type="button" class="agentos-voice-chip" data-action="voice-toggle" title="{{localize "AGENTOS.Chat.PickVoice"}}">
        <img class="agentos-avatar sm" src="{{voice.img}}" alt="">
        <span class="agentos-voice-as">{{localize "AGENTOS.Chat.SpeakingAs"}}:</span>
        <span class="agentos-voice-name">{{voice.name}}</span>
        <i class="fas fa-chevron-{{#if voicePickerOpen}}down{{else}}up{{/if}}"></i>
      </button>
    </div>
    {{#if voicePickerOpen}}
    <div class="agentos-voice-panel">
      {{#each npcParticipants}}
      <div class="agentos-candidate {{#if (agEq this.key @root.viewData.voiceKey)}}selected{{/if}}" data-action="voice-pick" data-key="{{this.key}}">
        <img class="agentos-avatar sm" src="{{this.img}}" alt="">
        <div class="agentos-list-main">
          <div class="agentos-list-title">{{this.name}}</div>
        </div>
        <i class="fas {{#if (agEq this.key @root.viewData.voiceKey)}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{/if}}
    {{/if}}
    <div class="agentos-compose-row">
      <button type="button" class="agentos-icon-btn" data-action="chat-attach" data-kind="image" title="{{localize "AGENTOS.Chat.AttachImage"}}"><i class="fas fa-image"></i></button>
      <button type="button" class="agentos-icon-btn" data-action="chat-attach" data-kind="audio" title="{{localize "AGENTOS.Chat.AttachAudio"}}"><i class="fas fa-music"></i></button>
      <button type="button" class="agentos-icon-btn" data-action="chat-attach" data-kind="video" title="{{localize "AGENTOS.Chat.AttachVideo"}}"><i class="fas fa-film"></i></button>
      <textarea name="chat-input" rows="1" maxlength="5000" placeholder="{{localize "AGENTOS.Chat.InputPlaceholder"}}">{{draft}}</textarea>
      <button type="button" class="agentos-icon-btn send" data-action="chat-send" {{#if sending}}disabled{{/if}} title="{{localize "AGENTOS.Chat.Send"}}"><i class="fas {{#if sending}}fa-spinner fa-spin{{else}}fa-paper-plane{{/if}}"></i></button>
    </div>
    {{else}}
    <p class="agentos-hint">{{#if isGM}}{{localize "AGENTOS.Chat.GmNoNpcHint"}}{{else}}{{localize "AGENTOS.Chat.NotMemberHint"}}{{/if}}</p>
    {{/if}}
  </footer>
</div>
