{{#if viewing}}

<div class="agentos-shard-view">
  <div class="agentos-toolbar">
    <button type="button" class="agentos-icon-btn" data-action="shard-back"><i class="fas fa-arrow-left"></i></button>
    <span class="agentos-tag {{#if isAuthored}}authored{{else}}received{{/if}}">
      {{#if isAuthored}}{{localize "AGENTOS.Data.Authored"}}{{else}}{{localize "AGENTOS.Data.Received"}}{{/if}}
    </span>
    <span class="agentos-spacer"></span>
    <button type="button" class="agentos-icon-btn" data-action="shard-move" title="{{localize "AGENTOS.Data.MoveToFolder"}}"><i class="fas fa-folder-tree"></i></button>
    {{#if canEdit}}
    <button type="button" class="agentos-icon-btn" data-action="shard-edit" title="{{localize "AGENTOS.Data.EditShard"}}"><i class="fas fa-pen"></i></button>
    {{/if}}
    {{#if canSend}}
    <button type="button" class="agentos-btn" data-action="shard-send-open"><i class="fas fa-paper-plane"></i> {{localize "AGENTOS.Data.Send"}}</button>
    {{/if}}
    {{#if canDelete}}
    <button type="button" class="agentos-icon-btn danger" data-action="shard-delete"><i class="fas fa-trash"></i></button>
    {{/if}}
  </div>
  <h3 class="agentos-shard-title">{{shard.title}}</h3>
  <div class="agentos-shard-meta">
    <span><i class="fas fa-user"></i> {{shard.authorName}}</span>
    <span><i class="fas fa-clock"></i> {{agDate shard.ts}} {{agTime shard.ts}}</span>
    {{#if currentFolder}}<span><i class="fas fa-folder"></i> {{currentFolder}}</span>{{/if}}
  </div>

  {{#if hasRecipients}}
  <div class="agentos-shard-recipients">
    <div class="agentos-shard-recipients-head"><i class="fas fa-paper-plane"></i> {{localize "AGENTOS.Data.SentTo"}}</div>
    {{#each recipients}}
    <div class="agentos-shard-recipient">
      <span class="agentos-shard-recipient-name">{{this.name}} <small>({{this.userName}})</small></span>
      <span class="agentos-shard-recipient-ts">{{agDate this.ts}} {{agTime this.ts}}</span>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <div class="agentos-shard-body">{{{bodyHtml}}}</div>
</div>

{{#if sending}}
<div class="agentos-modal">
  <div class="agentos-modal-card">
    <h3>{{localize "AGENTOS.Data.SendTo"}}</h3>
    <div class="agentos-candidates">
      {{#each candidates}}
      <div class="agentos-candidate {{#if this.selected}}selected{{/if}}" data-action="shard-toggle-recipient" data-id="{{this.id}}">
        <img class="agentos-avatar sm" src="{{this.img}}" alt="">
        <div class="agentos-list-main">
          <div class="agentos-list-title">{{this.name}}</div>
          <div class="agentos-list-sub">{{this.sub}}{{#if this.online}} · online{{/if}}</div>
        </div>
        <i class="fas {{#if this.selected}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
      </div>
      {{/each}}
    </div>
    <div class="agentos-modal-actions">
      <button type="button" class="agentos-btn" data-action="shard-send-cancel">{{localize "AGENTOS.Common.Cancel"}}</button>
      <button type="button" class="agentos-btn primary" data-action="shard-send">{{localize "AGENTOS.Data.Send"}}</button>
    </div>
  </div>
</div>
{{/if}}

{{else}}

<div class="agentos-shard-list">
  <div class="agentos-toolbar">
    <button type="button" class="agentos-btn primary" data-action="shard-compose">
      <i class="fas fa-plus"></i> {{localize "AGENTOS.Data.NewShard"}}
    </button>
    <button type="button" class="agentos-icon-btn" data-action="datapool-folder-new" data-parent-id="" title="{{localize "AGENTOS.Data.NewFolder"}}"><i class="fas fa-folder-plus"></i></button>
  </div>

  {{#if hasShards}}
  {{!-- Root drop zone: dropping here files a shard/folder at the top. --}}
  <div class="agentos-datapool-root" data-datapool-drop="">

    {{!-- Inbox: received messages, no subfolders (a drop target only for shards). --}}
    {{#if inbox.count}}
    <div class="agentos-folder agentos-inbox-folder" data-datapool-drop="__inbox">
      <div class="agentos-folder-header" data-action="shard-folder-toggle" data-folder-id="__inbox">
        <i class="fas fa-inbox"></i>
        <span class="agentos-folder-name">{{localize "AGENTOS.Data.Inbox"}}</span>
        <span class="agentos-folder-count">{{inbox.count}}</span>
        <i class="fas {{#if inbox.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} agentos-folder-chevron"></i>
      </div>
      {{#unless inbox.collapsed}}
      <ul class="agentos-list">
        {{#each inbox.shards}}
        {{> "modules/cyberpunk-red-agent-os-modified/templates/datapool-row.hbs" this}}
        {{/each}}
      </ul>
      {{/unless}}
    </div>
    {{/if}}

    {{!-- The viewer's own nested folders. --}}
    {{#each folders}}
    {{> "modules/cyberpunk-red-agent-os-modified/templates/datapool-folder.hbs" this}}
    {{/each}}

    {{!-- Loose authored shards at root. --}}
    {{#if rootShards.length}}
    <ul class="agentos-list">
      {{#each rootShards}}
      {{> "modules/cyberpunk-red-agent-os-modified/templates/datapool-row.hbs" this}}
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{else}}
  <p class="agentos-empty">{{localize "AGENTOS.Data.Empty"}}</p>
  {{/if}}
</div>

{{#if composing}}
<div class="agentos-modal">
  <div class="agentos-modal-card wide">
    <h3>{{#if isEditing}}{{localize "AGENTOS.Data.EditShard"}}{{else}}{{localize "AGENTOS.Data.NewShard"}}{{/if}}</h3>
    <input type="text" name="shard-title" value="{{compose.title}}" placeholder="{{localize "AGENTOS.Data.TitlePlaceholder"}}">
    {{#if isGM}}
    <div class="agentos-field-row">
      <input type="text" name="shard-author" value="{{compose.authorName}}" placeholder="{{localize "AGENTOS.Data.AuthorPlaceholder"}}">
      <select name="shard-author-garden" class="agentos-select">
        <option value="">{{localize "AGENTOS.Data.FromGarden"}}…</option>
        {{#each gardenAuthors}}
        <option value="{{this.name}}">{{this.name}}</option>
        {{/each}}
      </select>
    </div>
    {{/if}}
    <select name="shard-format" class="agentos-select">
      <option value="plain" {{#if (agEq compose.format "plain")}}selected{{/if}}>{{localize "AGENTOS.Data.FormatPlain"}}</option>
      <option value="markdown" {{#if (agEq compose.format "markdown")}}selected{{/if}}>Markdown</option>
      <option value="html" {{#if (agEq compose.format "html")}}selected{{/if}}>HTML</option>
    </select>
    <textarea name="shard-body" rows="8" placeholder="{{localize "AGENTOS.Data.BodyPlaceholder"}}">{{compose.body}}</textarea>
    <div class="agentos-modal-actions">
      <button type="button" class="agentos-btn" data-action="shard-compose-cancel">{{localize "AGENTOS.Common.Cancel"}}</button>
      <button type="button" class="agentos-btn primary" data-action="shard-create">{{#if isEditing}}{{localize "AGENTOS.Common.Save"}}{{else}}{{localize "AGENTOS.Common.Create"}}{{/if}}</button>
    </div>
  </div>
</div>
{{/if}}

{{/if}}
