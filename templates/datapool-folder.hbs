{{!-- A nested datapool folder. Drop target; recurses into subfolders. --}}
<div class="agentos-folder agentos-subfolder" data-datapool-drop="{{this.id}}"
     draggable="true" data-datapoolfolder-drag="{{this.id}}">
  <div class="agentos-folder-header" data-action="shard-folder-toggle" data-folder-id="{{this.id}}">
    <i class="fas {{#if this.collapsed}}fa-folder{{else}}fa-folder-open{{/if}}"></i>
    <span class="agentos-folder-name">{{this.name}}</span>
    <span class="agentos-folder-count">{{this.count}}</span>
    <span class="agentos-folder-tools">
      <button type="button" class="agentos-icon-btn" data-action="datapool-folder-new" data-parent-id="{{this.id}}" title="{{localize "AGENTOS.Data.NewSubfolder"}}"><i class="fas fa-folder-plus"></i></button>
      <button type="button" class="agentos-icon-btn" data-action="datapool-folder-rename" data-folder-id="{{this.id}}" title="{{localize "AGENTOS.Data.RenameFolder"}}"><i class="fas fa-pen"></i></button>
      <button type="button" class="agentos-icon-btn danger" data-action="datapool-folder-delete" data-folder-id="{{this.id}}" title="{{localize "AGENTOS.Data.DeleteFolder"}}"><i class="fas fa-trash"></i></button>
    </span>
    <i class="fas {{#if this.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} agentos-folder-chevron"></i>
  </div>
  {{#unless this.collapsed}}
  <div class="agentos-folder-body">
    {{#each this.subfolders}}
    {{> "modules/cyberpunk-red-agent-os-modified/templates/datapool-folder.hbs" this}}
    {{/each}}
    {{#if this.shards.length}}
    <ul class="agentos-list">
      {{#each this.shards}}
      {{> "modules/cyberpunk-red-agent-os-modified/templates/datapool-row.hbs" this}}
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{/unless}}
</div>
