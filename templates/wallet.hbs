{{#if listMode}}

<div class="agentos-wallet-list">
  <div class="agentos-toolbar">
    <button type="button" class="agentos-btn primary" data-action="gm-award-money">
      <i class="fas fa-money-bill-transfer"></i> {{localize "AGENTOS.Wallet.AwardMoney"}}
    </button>
    <button type="button" class="agentos-btn" data-action="gm-award-ip">
      <i class="fas fa-graduation-cap"></i> {{localize "AGENTOS.Wallet.AwardIP"}}
    </button>
  </div>
  <h3 class="agentos-section-title">{{localize "AGENTOS.Wallet.AllWallets"}}</h3>
  <div class="agentos-toolbar"><button type="button" class="agentos-btn" data-action="monthly-send">{{localize "AGENTOS.Expenses.Notify"}}</button></div>
  {{#if wallets.length}}
  <ul class="agentos-list">
    {{#each wallets}}
    <li class="agentos-list-row" data-action="wallet-select" data-actor-uuid="{{this.actorUuid}}">
      <input type="checkbox" name="monthly-user" value="{{userId}}" checked onclick="event.stopPropagation()" aria-label="{{localize "AGENTOS.Expenses.Notify"}}">
      <img class="agentos-avatar" src="{{this.img}}" alt="">
      <div class="agentos-list-main">
        <div class="agentos-list-title">{{this.name}}</div>
        <div class="agentos-list-sub">{{this.userName}}</div>
        <div class="agentos-list-sub" title="{{#if expenses.incomplete}}{{localize "AGENTOS.Expenses.Incomplete"}}{{/if}}">{{#each expenses.parts}}{{#if name}}{{name}}: {{agNum amount}}€$ {{/if}}{{/each}} · {{agNum expenses.total}}€${{#if expenses.incomplete}} ?{{/if}}</div>
      </div>
      <span class="agentos-money">{{agNum this.balance}} €$</span>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="agentos-empty">{{localize "AGENTOS.Wallet.NoWallets"}}</p>
  {{/if}}
</div>

{{#if award}}
<div class="agentos-modal">
  <div class="agentos-modal-card">
    <h3>{{#if awardMoney}}{{localize "AGENTOS.Wallet.AwardMoney"}}{{else}}{{localize "AGENTOS.Wallet.AwardIP"}}{{/if}}</h3>
    {{#if awardMoney}}
    <label>{{localize "AGENTOS.Wallet.SenderName"}}</label>
    <input type="text" name="gm-award-sender" data-award-field="senderName" data-agentos-controlled value="{{award.senderName}}" placeholder="{{localize "AGENTOS.Wallet.SenderNamePlaceholder"}}">
    {{/if}}
    <label>{{localize "AGENTOS.Wallet.SelectTarget"}}</label>
    <label class="agentos-check"><input type="checkbox" data-action="gm-award-all"> {{localize "AGENTOS.Wallet.AllCharacters"}}</label>
    <div class="agentos-award-targets">
      {{#each awardTargets}}
      <label class="agentos-check"><input type="checkbox" name="gm-award-target" data-agentos-controlled value="{{uuid}}" {{#if selected}}checked{{/if}}> <span>{{name}}</span></label>
      {{/each}}
    </div>
    <label>{{localize "AGENTOS.Wallet.AmountEach"}} ({{#if awardMoney}}€${{else}}I.P.{{/if}})</label>
    <input type="number" name="gm-award-amount" data-award-field="amount" data-agentos-controlled value="{{award.amount}}" min="1" step="1">
    <label>{{localize "AGENTOS.Wallet.Memo"}}</label>
    <input type="text" name="gm-award-memo" data-award-field="memo" data-agentos-controlled value="{{award.memo}}" placeholder="{{localize "AGENTOS.Wallet.MemoPlaceholder"}}">
    <div class="agentos-modal-actions">
      <button type="button" class="agentos-btn" data-action="gm-award-cancel">{{localize "AGENTOS.Common.Cancel"}}</button>
      <button type="button" class="agentos-btn primary" data-action="gm-award-send">{{localize "AGENTOS.Wallet.Send"}}</button>
    </div>
  </div>
</div>
{{/if}}

{{else}}
{{#if noActor}}
<p class="agentos-hint">{{localize "AGENTOS.Wallet.NoActor"}}</p>
{{else}}

<div class="agentos-wallet">
  {{#if isGM}}
  <div class="agentos-toolbar">
    <button type="button" class="agentos-icon-btn" data-action="wallet-back"><i class="fas fa-arrow-left"></i></button>
    <span class="agentos-list-sub">{{actorName}}</span>
  </div>
  {{/if}}

  <div class="agentos-balance-card">
    <div class="agentos-balance-label">{{localize "AGENTOS.Wallet.Balance"}}</div>
    <div class="agentos-balance-value">{{agNum balance}} <span>€$</span></div>
    <button type="button" class="agentos-btn primary" data-action="transfer-open">
      <i class="fas fa-money-bill-transfer"></i> {{localize "AGENTOS.Wallet.Transfer"}}
    </button>
  </div>

  <h3 class="agentos-section-title">{{localize "AGENTOS.Wallet.History"}}</h3>
  <details class="agentos-expenses" {{#if openExpenses}}open{{/if}}><summary>{{localize "AGENTOS.Expenses.Title"}}: {{agNum expenses.total}} €$</summary>
    {{#each expenses.parts}}<div class="agentos-field-row"><span>{{name}}{{#if custom}} · {{localize "AGENTOS.Expenses.Custom"}}{{/if}}</span><span>{{#if name}}{{agNum amount}} €${{else}}?{{/if}}</span></div>{{/each}}
    {{#if expenses.incomplete}}<p class="agentos-hint">{{localize "AGENTOS.Expenses.Incomplete"}}</p>{{/if}}
    {{#each notices}}<p>{{period}} · {{agNum total}} €$ <small>{{agDate ts}}</small></p>{{/each}}
  </details>
  {{#if transactions.length}}
  <ul class="agentos-tx-list">
    {{#each transactions}}
    <li class="agentos-tx">
      {{#if (agEq this.kind "raw")}}
      <div class="agentos-tx-text">{{this.text}}</div>
      {{else}}
      <div class="agentos-tx-line">
        <span class="agentos-tx-amount {{this.kind}}">
          {{#if (agEq this.kind "plus")}}+{{agNum this.amount}}{{/if}}
          {{#if (agEq this.kind "minus")}}−{{agNum this.amount}}{{/if}}
          {{#if (agEq this.kind "set")}}= {{agNum this.amount}}{{/if}}
          €$
        </span>
        <span class="agentos-tx-total">{{localize "AGENTOS.Wallet.After"}}: {{agNum this.total}} €$</span>
      </div>
      {{/if}}
      {{#if this.reason}}<div class="agentos-tx-reason">{{this.reason}}</div>{{/if}}
      {{#if this.ts}}<small>{{agDate this.ts}} {{agTime this.ts}}</small>{{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="agentos-empty">{{localize "AGENTOS.Wallet.NoHistory"}}</p>
  {{/if}}
</div>

{{#if transferring}}
<div class="agentos-modal">
  <div class="agentos-modal-card">
    <h3>{{localize "AGENTOS.Wallet.Transfer"}}</h3>
    <label>{{localize "AGENTOS.Wallet.SelectTarget"}}</label>
    <select name="transfer-target" class="agentos-select">
      <option value="">{{localize "AGENTOS.Wallet.SelectTarget"}}…</option>
      {{#each targets}}
      <option value="{{this.id}}">{{this.name}} ({{this.sub}})</option>
      {{/each}}
    </select>
    <label>{{localize "AGENTOS.Wallet.Amount"}} (€$)</label>
    <input type="number" name="transfer-amount" min="1" step="1" placeholder="500">
    <label>{{localize "AGENTOS.Wallet.Memo"}}</label>
    <input type="text" name="transfer-memo" placeholder="{{localize "AGENTOS.Wallet.MemoPlaceholder"}}">
    <div class="agentos-modal-actions">
      <button type="button" class="agentos-btn" data-action="transfer-cancel">{{localize "AGENTOS.Common.Cancel"}}</button>
      <button type="button" class="agentos-btn primary" data-action="transfer-send" data-actor-uuid="{{actorUuid}}">
        {{localize "AGENTOS.Wallet.Send"}}
      </button>
    </div>
  </div>
</div>
{{/if}}

{{/if}}
{{/if}}
